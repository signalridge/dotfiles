{{- $node := dig "nodes" .hostname "" .easytier -}}
{{- $keyFile := joinPath .chezmoi.homeDir ".local/share/gopass/stores/root/easytier/exit-ss-password.age" -}}
{{- if and (eq .chezmoi.os "linux") $node (dig "exitNode" false $node) (stat $keyFile) -}}
{{- $ip := index (splitList "/" $node.ipv4) 0 -}}
{{- $key := output "gopass" "show" "-o" "easytier/exit-ss-password" | trim -}}
{{- if not $key }}{{ fail "missing gopass key: easytier/exit-ss-password" }}{{ end -}}
# gost config for the EasyTier exit on {{ .hostname }} (easytier-exit-proxy.service).
# Shadowsocks (TCP + UDP) bound ONLY to this node's virtual IP, and the
# admission whitelist drops any source outside the mesh: Linux accepts packets
# for a local address on every interface, so a same-LAN host could otherwise
# route 10.144.144.0/24 here via the physical NIC. The key comes from gopass
# (easytier/exit-ss-password); this file is rendered 0600 and never committed.
services:
  - name: exit-tcp
    addr: {{ $ip }}:{{ .easytier.exitProxy.port }}
    admission: mesh-only
    handler:
      type: ss
      auth:
        username: {{ .easytier.exitProxy.method }}
        password: {{ $key | quote }}
    listener:
      type: tcp
  - name: exit-udp
    addr: {{ $ip }}:{{ .easytier.exitProxy.port }}
    admission: mesh-only
    handler:
      type: ssu
      auth:
        username: {{ .easytier.exitProxy.method }}
        password: {{ $key | quote }}
    listener:
      type: udp
admissions:
  - name: mesh-only
    whitelist: true
    matchers:
      - {{ .easytier.network }}
{{- end }}
