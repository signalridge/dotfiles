{{- /*
  aichat config — kimi + doubao (火山) only.
  API keys: gopass `pi/{moonshot,doubao}/api_key`. Missing keys are silently
  skipped so `chezmoi apply` still works on a fresh machine.

  Moved off `claude/{kimi,doubao}/private/api_key` on 2026-08-17, when the
  claude/, codex/ and opencode/ gopass trees were deleted and keys were
  renamespaced one-per-SERVICE under pi/. The kimi client here talks to the
  MOONSHOT PLATFORM (api.moonshot.ai), which is a different service and a
  different secret from the Kimi Code subscription that pi's `kimi` provider uses
  (api.kimi.com/coding/v1, gopass pi/kimi/api_key) — hence `pi/moonshot`, not
  `pi/kimi`. Do not collapse the two.
*/ -}}
{{- $kimi := output "sh" "-c" "gopass show --password pi/moonshot/api_key 2>/dev/null | head -n1 || true" | trim -}}
{{- $doubao := output "sh" "-c" "gopass show --password pi/doubao/api_key 2>/dev/null | head -n1 || true" | trim -}}
# Managed by chezmoi. Edit the template, not this file.
model: kimi:kimi-k2.5
temperature: 0.3
save: true
save_session: null
keybindings: emacs
editor: ${EDITOR:-nvim}
wrap: auto
highlight: true

clients:
{{- if ne $kimi "" }}
  - type: openai-compatible
    name: kimi
    api_base: https://api.moonshot.ai/v1
    api_key: {{ $kimi | quote }}
    models:
      - name: kimi-k2.5
      - name: kimi-k2
{{- end }}
{{- if ne $doubao "" }}
  - type: openai-compatible
    name: doubao
    api_base: https://ark.cn-beijing.volces.com/api/v3
    api_key: {{ $doubao | quote }}
    models:
      - name: ark-code-latest
{{- end }}
