{{- $node := dig "nodes" .hostname "" .easytier -}}
# EasyTier node {{ .hostname }} ({{ $node.ipv4 }}). Managed by chezmoi from
# .chezmoidata/easytier.yaml; started by .chezmoiscripts/run_after_24_easytier-node.sh.
# Host networking + /dev/net/tun puts the TUN and routes on the host; the
# container only gets NET_ADMIN/NET_RAW. Credentials: ./easytier.env (0600),
# written from gopass by the same script — never in this file.
name: easytier
services:
  easytier:
    # Official image pinned by index digest (bumped by update-versions).
    image: easytier/easytier:v{{ .versions.easytier }}@sha256:{{ .versions.easytierImageSha256 }}
    container_name: easytier
    restart: unless-stopped
    network_mode: host
    cap_drop: [ALL]
    cap_add: [NET_ADMIN, NET_RAW]
    devices:
      - /dev/net/tun:/dev/net/tun
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    env_file: ./easytier.env
    command:
      - --hostname={{ .hostname }}
      - --ipv4={{ $node.ipv4 }}
{{- range .easytier.peers }}
      - --peers={{ . }}
{{- end }}
      - --listeners=tcp://0.0.0.0:11010
      - --listeners=udp://0.0.0.0:11010
{{- range .easytier.stunServers }}
      - --stun-servers={{ . }}
{{- end }}
      - --default-protocol=udp
      - --private-mode=true
      - --enable-quic-proxy=true
      - --enable-kcp-proxy=true
      - --rpc-portal=127.0.0.1:15888
      - --rpc-portal-whitelist=127.0.0.1/32
      - --console-log-level=info
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
