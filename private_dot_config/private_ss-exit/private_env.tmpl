{{- $et := includeTemplate "easytier/role.tmpl" . | fromJson -}}
{{- $keyFile := joinPath .chezmoi.homeDir ".local/share/gopass/stores/root/easytier/exit-ss-password.age" -}}
{{- if and $et.exit (stat $keyFile) -}}
{{- $key := output "gopass" "show" "-o" "easytier/exit-ss-password" | trim -}}
{{- if not $key }}{{ fail "missing gopass key: easytier/exit-ss-password" }}{{ end -}}
# Shadowsocks 2022 key (base64, 32 bytes) for ss-exit.service, from gopass
# easytier/exit-ss-password. Rendered 0600; config.json reads it as ${SS_PASSWORD}.
SS_PASSWORD={{ $key }}
{{- end }}
