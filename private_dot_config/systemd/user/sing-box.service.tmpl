{{- if eq (includeTemplate "sing-box/mode.tmpl" .) "service" -}}
# sing-box on headless Linux: mixed SOCKS5/HTTP proxy on 127.0.0.1:{{ .singBox.mixedPort }}
# with the `Egress` selector over the EasyTier exits (default direct) and the
# Clash API on 127.0.0.1:{{ .singBox.clashApiPort }} (reach the panel via ssh -L).
# Config: ~/.config/sing-box/config.json (0600, from gopass). Loaded by
# run_onchange_after_19.
[Unit]
Description=sing-box proxy client (EasyTier exits)
After=network-online.target

[Service]
Environment=AQUA_GLOBAL_CONFIG=%h/.config/aquaproj-aqua/aqua.yaml
Environment=AQUA_POLICY_CONFIG=%h/.config/aquaproj-aqua/aqua-policy.yaml
# Work hosts use aqua; other headless hosts use the patched Nix package.
Environment=PATH=%h/.local/share/aquaproj-aqua/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/bin/mkdir -p %h/.local/state/sing-box
ExecStart=%h/{{ if .work }}.local/share/aquaproj-aqua{{ else }}.nix-profile{{ end }}/bin/sing-box run -c %h/.config/sing-box/config.json -D %h/.local/state/sing-box
Restart=always
RestartSec=10s
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=default.target
{{- end }}
