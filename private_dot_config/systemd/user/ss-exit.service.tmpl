{{- $et := includeTemplate "easytier/role.tmpl" . | fromJson -}}
{{- if and $et.exit -}}
{{- $ip := $et.ip -}}
# EasyTier exit for other mesh members: shadowsocks-rust (Shadowsocks 2022, TCP +
# UDP) on this node's virtual IP only; client and destination ACL in
# ~/.config/ss-exit/acl.list, key in ~/.config/ss-exit/env (from gopass).
# Clients select it in the sing-box `Egress` selector. Loaded by run_onchange_after_19.
# Rendered only on Linux exits (`easytierExit` in the chezmoi data).
[Unit]
Description=EasyTier exit (Shadowsocks 2022 on {{ $ip }}:{{ .easytier.exitProxy.port }})
After=network-online.target

[Service]
EnvironmentFile=%h/.config/ss-exit/env
Environment=AQUA_GLOBAL_CONFIG=%h/.config/aquaproj-aqua/aqua.yaml
Environment=AQUA_POLICY_CONFIG=%h/.config/aquaproj-aqua/aqua-policy.yaml
# ssserver is an aqua-proxy shim, which needs `aqua` itself on PATH.
Environment=PATH=%h/.local/share/aquaproj-aqua/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/aquaproj-aqua/bin/ssserver -c %h/.config/ss-exit/config.json
# The virtual IP exists only while easytier.service is up; keep retrying the bind.
Restart=always
RestartSec=10s
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
{{- end }}
