[Unit]
Description=Shared context7 MCP server (HTTP, port 13711)
Documentation=https://github.com/upstash/context7
# Linux analog of the macOS LaunchAgent com.signalridge.mcp-context7: a single
# shared HTTP daemon all Claude/Codex sessions connect to, instead of one stdio
# instance per session. The wrapper injects the gopass API key when available
# (a non-interactive service with no key falls back to keyless).
After=default.target

[Service]
Type=simple
# %h = user home; mirrors {{ .chezmoi.homeDir }} in the macOS plist.
ExecStart=%h/.local/bin/mcp-context7 --transport http --port 13711
Environment=PATH=%h/.local/share/mise/installs/bun/latest/bin:%h/.local/share/mise/installs/node/lts/bin:%h/.local/share/aquaproj-aqua/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
