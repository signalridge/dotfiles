{{- $node := dig "nodes" .hostname "" .easytier -}}
{{- if and (eq .chezmoi.os "linux") $node (dig "exitNode" false $node) -}}
{{- $ip := index (splitList "/" $node.ipv4) 0 -}}
# EasyTier exit for other mesh members: gost serving Shadowsocks (TCP + UDP)
# on this node's virtual IP; see ~/.config/easytier-exit/config.yaml.
# Clients select it in Surge / sing-box. Loaded by run_onchange_after_19.
# Rendered only for Linux hosts with `exitNode: true` in .chezmoidata/easytier.yaml.
[Unit]
Description=EasyTier exit (Shadowsocks on {{ $ip }}:{{ .easytier.exitProxy.port }})
After=network-online.target

[Service]
Environment=AQUA_GLOBAL_CONFIG=%h/.config/aquaproj-aqua/aqua.yaml
Environment=AQUA_POLICY_CONFIG=%h/.config/aquaproj-aqua/aqua-policy.yaml
# gost is an aqua-proxy shim, which needs `aqua` itself on PATH.
Environment=PATH=%h/.local/share/aquaproj-aqua/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/aquaproj-aqua/bin/gost -C %h/.config/easytier-exit/config.yaml
# The virtual IP exists only while easytier.service is up; keep retrying the bind.
Restart=always
RestartSec=10s
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
{{- end }}
