{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "doublePressToConfirm": true,
  "permissionReviewLog": true,
  "yoloMode": true,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "git worktree": "deny",
      "git worktree *": "deny",
      "git switch": "deny",
      "git switch *": "deny",
      "git checkout -b *": "deny",
      "git checkout --orphan *": "deny"
    },
    "mcp": {
      "*": "allow"
    },
    "external_directory": {
      "*": "allow"
    }
  }
}
