{
  pkgs,
  flakey-profile,
  ...
}:
flakey-profile.lib.mkProfile {
  inherit pkgs;
  paths = with pkgs; [
    {{- range .nix.homepkgs.shared }}
    {{ . }}
    {{- end }}
    {{- if eq .platform "darwin" }}
    # tmux 3.7c's macOS configure check requires an explicit allocator choice.
    (tmux.overrideAttrs (old: {
      configureFlags = (old.configureFlags or []) ++ [ "--enable-jemalloc" ];
      buildInputs = (old.buildInputs or []) ++ [ jemalloc ];
    }))
    {{- else }}
    tmux
    {{- end }}
    {{- if .work }}
    {{- range .nix.homepkgs.work }}
    {{ . }}
    {{- end }}
    {{- end }}
    {{- if .private }}
    {{- range .nix.homepkgs.private }}
    {{ . }}
    {{- end }}
    {{- end }}
  ];
}
