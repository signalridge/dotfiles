{{- $et := includeTemplate "easytier/role.tmpl" . | fromJson -}}
{{- if not $et.member -}}
# EasyTier: not a member (see .chezmoitemplates/easytier/role.tmpl).
_: { }
{{- else -}}
# ─────────────────────────────────────────────────────────────────────────────
# EasyTier node (root LaunchDaemon; TUN needs root on macOS)
# ─────────────────────────────────────────────────────────────────────────────
# --bind-device pins EasyTier's own sockets (peers, STUN, hole punching) to the
# physical NIC (IP_BOUND_IF), so they bypass any TUN that owns the default route
# (sing-box) the way Tailscale's own traffic does: no per-peer route
# exclusions needed.
# Every Mac is a client with a DHCP-assigned virtual IP; network parameters
# come from .chezmoidata/easytier.yaml; the package
# (official release zip, NOT nixpkgs) from ./easytier-package.nix. The store
# path is immutable and root-owned, so the root daemon executes it in place and
# easytier-cli on PATH is always the same build as the daemon.
#
# Pause marker: /var/db/easytier-paused makes the launcher wait instead of
# starting easytier-core (sing-box's Mesh = bastion; stuck? sudo rm the file).
#
# Credentials (ET_NETWORK_NAME / ET_NETWORK_SECRET) are NOT in this repo:
# .chezmoiscripts/run_after_23_easytier-node.sh writes them from gopass
# to /etc/easytier/easytier.env (root:wheel 0600). Until that file exists the
# daemon refuses to start and launchd retries every ThrottleInterval.
{ pkgs, ... }:
let
  easytier = import ./easytier-package.nix { inherit pkgs; };
  envFile = "/etc/easytier/easytier.env";
  logFile = "/var/log/easytier.log";
in
{
  environment.systemPackages = [ easytier ];

  launchd.daemons.easytier = {
    script = ''
      set -eu
      if [ "$(/usr/bin/stat -f '%u %Lp' "${envFile}" 2>/dev/null)" != "0 600" ]; then
        echo "easytier: ${envFile} must exist, be owned by root and mode 0600; refusing to start" >&2
        exit 1
      fi
      set -a
      . "${envFile}"
      set +a

      # Paused while sing-box carries the mesh through the bastion (Mesh =
      # bastion, .chezmoitemplates/sing-box/mesh-follow.sh): in a network that
      # blocks EasyTier, no packet of it may leave. The marker is in /var/db, so
      # a reboot there stays quiet too; sing-box removes it to resume.
      while [ -e /var/db/easytier-paused ]; do /bin/sleep 2; done

      exec ${easytier}/bin/easytier-core \
        --hostname {{ .hostname }} \
        --dhcp true \
        --peers tcp://{{ $et.bastion }}:{{ .easytier.bastion.peerPort }} \
        --listeners{{ range .easytier.listeners }} {{ . }}{{ end }} \
        --stun-servers{{ range .easytier.bastion.stunPorts }} {{ $et.bastion }}:{{ . }}{{ end }} \
        --default-protocol udp \
        --disable-tcp-hole-punching true \
        --bind-device true \
        --private-mode true \
        --enable-quic-proxy true \
        --enable-kcp-proxy true \
        --disable-kcp-input true \
        --disable-quic-input true \
        --rpc-portal 127.0.0.1:15888 \
        --rpc-portal-whitelist 127.0.0.1/32 \
        --console-log-level info
    '';
    serviceConfig = {
      RunAtLoad = true;
      KeepAlive = true;
      ThrottleInterval = 30;
      StandardOutPath = logFile;
      StandardErrorPath = logFile;
    };
  };

  # --bind-device sockets keep the address they bound at start. After a Wi-Fi
  # rejoin or DHCP change the IPv4 punch sockets go stale: peers reachable only
  # over IPv4 (gpuserver, pve) drop to relay(2), and --p2p-only members then
  # time out, while IPv6 peers keep working. EasyTier never rebinds by itself,
  # so restart it whenever the physical (en*) IPv4 addresses change. The state
  # file lives in /var/db so a reboot with unchanged addresses restarts nothing.
  launchd.daemons.easytier-netwatch = {
    script = ''
      set -u
      state=/var/db/easytier-netwatch.state
      now=$(/sbin/ifconfig -a | /usr/bin/awk '/^[a-z]/ { i = $1 } i ~ /^en/ && $1 == "inet" { print i, $2 }' | /usr/bin/sort)
      [ -n "$now" ] || exit 0 # offline: keep the last state, restart once back
      old=$(/bin/cat "$state" 2>/dev/null || true)
      [ "$now" = "$old" ] && exit 0
      printf '%s\n' "$now" > "$state"
      [ -n "$old" ] || exit 0 # first run: record only
      echo "$(/bin/date '+%F %T') easytier-netwatch: addresses changed, restarting easytier"
      /bin/launchctl kickstart -k system/org.nixos.easytier
    '';
    serviceConfig = {
      RunAtLoad = true;
      # Network changes rewrite these; the interval catches a DHCP renewal
      # that changes the address without touching them.
      WatchPaths = [
        "/Library/Preferences/SystemConfiguration"
        "/var/run/resolv.conf"
      ];
      StartInterval = 60;
      ThrottleInterval = 10;
      StandardOutPath = logFile;
      StandardErrorPath = logFile;
    };
  };

  # Rotate the daemon log at 10 MiB, keeping 5 compressed generations.
  environment.etc."newsyslog.d/easytier.conf".text = ''
    # logfilename        [owner:group]  mode count size(KB) when flags
    ${logFile}  root:wheel     640  5     10240    *    JN
  '';
}
{{- end }}
