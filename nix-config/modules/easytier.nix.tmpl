{{- $node := dig "nodes" .hostname "" .easytier -}}
{{- if not $node -}}
# EasyTier: {{ .hostname }} is not listed in .chezmoidata/easytier.yaml nodes.
_: { }
{{- else -}}
{{- $arch := "aarch64" -}}
{{- $sha256 := .versions.easytierDarwinArm64Sha256 -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{-   $arch = "x86_64" -}}
{{-   $sha256 = .versions.easytierDarwinAmd64Sha256 -}}
{{- end -}}
# ─────────────────────────────────────────────────────────────────────────────
# EasyTier node (root LaunchDaemon; TUN needs root on macOS)
# ─────────────────────────────────────────────────────────────────────────────
# Node/network parameters come from .chezmoidata/easytier.yaml; the version and
# release-asset digests from .chezmoidata/versions.yaml (bumped by the
# update-versions workflow from GitHub's asset digests, stable releases only).
#
# This packages the official release zip, NOT the nixpkgs easytier package. The
# store path is immutable and root-owned, so the root daemon executes it in
# place and easytier-cli on PATH is always the same build as the daemon.
#
# Credentials (ET_NETWORK_NAME / ET_NETWORK_SECRET) are NOT in this repo:
# .chezmoiscripts/run_after_24_easytier-credentials.sh writes them from gopass
# to /etc/easytier/easytier.env (root:wheel 0600). Until that file exists the
# daemon refuses to start and launchd retries every ThrottleInterval.
{ pkgs, ... }:
let
  version = "{{ .versions.easytier }}";
  easytier = pkgs.stdenvNoCC.mkDerivation {
    pname = "easytier";
    inherit version;
    src = pkgs.fetchurl {
      url = "https://github.com/EasyTier/EasyTier/releases/download/v${version}/easytier-macos-{{ $arch }}-v${version}.zip";
      sha256 = "{{ $sha256 }}";
    };
    nativeBuildInputs = [ pkgs.unzip ];
    sourceRoot = "easytier-macos-{{ $arch }}";
    # Upstream binaries are ad-hoc linker-signed; stripping or patching them
    # would invalidate the signature and arm64 macOS would refuse to run them.
    dontConfigure = true;
    dontBuild = true;
    dontFixup = true;
    installPhase = ''
      runHook preInstall
      install -Dm755 easytier-core "$out/bin/easytier-core"
      install -Dm755 easytier-cli "$out/bin/easytier-cli"
      runHook postInstall
    '';
  };
  envFile = "/etc/easytier/easytier.env";
  logFile = "/var/log/easytier.log";
in
{
  environment.systemPackages = [ easytier ];

  launchd.daemons.easytier = {
    script = ''
      set -eu
      if [ "$(/usr/bin/stat -f '%u %Lp' "${envFile}" 2>/dev/null)" != "0 600" ]; then
        echo "easytier: ${envFile} must exist, be owned by root and mode 0600; refusing to start" >&2
        exit 1
      fi
      set -a
      . "${envFile}"
      set +a

      exec ${easytier}/bin/easytier-core \
        --hostname {{ .hostname }} \
        --ipv4 {{ $node.ipv4 }} \
        --peers{{ range .easytier.peers }} {{ . }}{{ end }} \
        --listeners tcp://0.0.0.0:11010 udp://0.0.0.0:11010 \
        --stun-servers{{ range .easytier.stunServers }} {{ . }}{{ end }} \
        --enable-quic-proxy true \
        --enable-kcp-proxy true \
        --rpc-portal 127.0.0.1:15888 \
        --rpc-portal-whitelist 127.0.0.1/32 \
        --console-log-level info
    '';
    serviceConfig = {
      RunAtLoad = true;
      KeepAlive = true;
      ThrottleInterval = 30;
      StandardOutPath = logFile;
      StandardErrorPath = logFile;
    };
  };

  # Rotate the daemon log at 10 MiB, keeping 5 compressed generations.
  environment.etc."newsyslog.d/easytier.conf".text = ''
    # logfilename        [owner:group]  mode count size(KB) when flags
    ${logFile}  root:wheel     640  5     10240    *    JN
  '';
}
{{- end }}
