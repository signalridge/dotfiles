{{- $node := dig "nodes" .hostname "" .easytier -}}
{{- if not $node -}}
# EasyTier: {{ .hostname }} is not listed in .chezmoidata/easytier.yaml nodes.
_: { }
{{- else -}}
# ─────────────────────────────────────────────────────────────────────────────
# EasyTier node (root LaunchDaemon; TUN needs root on macOS)
# ─────────────────────────────────────────────────────────────────────────────
# Node/network parameters come from .chezmoidata/easytier.yaml; the package
# (official release zip, NOT nixpkgs) from ./easytier-package.nix. The store
# path is immutable and root-owned, so the root daemon executes it in place and
# easytier-cli on PATH is always the same build as the daemon.
#
# Credentials (ET_NETWORK_NAME / ET_NETWORK_SECRET) are NOT in this repo:
# .chezmoiscripts/run_after_24_easytier-node.sh writes them from gopass
# to /etc/easytier/easytier.env (root:wheel 0600). Until that file exists the
# daemon refuses to start and launchd retries every ThrottleInterval.
{ pkgs, ... }:
let
  easytier = import ./easytier-package.nix { inherit pkgs; };
  envFile = "/etc/easytier/easytier.env";
  logFile = "/var/log/easytier.log";
in
{
  environment.systemPackages = [ easytier ];

  launchd.daemons.easytier = {
    script = ''
      set -eu
      if [ "$(/usr/bin/stat -f '%u %Lp' "${envFile}" 2>/dev/null)" != "0 600" ]; then
        echo "easytier: ${envFile} must exist, be owned by root and mode 0600; refusing to start" >&2
        exit 1
      fi
      set -a
      . "${envFile}"
      set +a

      exec ${easytier}/bin/easytier-core \
        --hostname {{ .hostname }} \
        --ipv4 {{ $node.ipv4 }} \
        --peers{{ range .easytier.peers }} {{ . }}{{ end }} \
        --listeners{{ range .easytier.listeners }} {{ . }}{{ end }} \
        --stun-servers{{ range .easytier.stunServers }} {{ . }}{{ end }} \
        --default-protocol udp \
        --disable-tcp-hole-punching true \
        --private-mode true \
        --enable-quic-proxy true \
        --enable-kcp-proxy true \
        --rpc-portal 127.0.0.1:15888 \
        --rpc-portal-whitelist 127.0.0.1/32 \
        --console-log-level info
    '';
    serviceConfig = {
      RunAtLoad = true;
      KeepAlive = true;
      ThrottleInterval = 30;
      StandardOutPath = logFile;
      StandardErrorPath = logFile;
    };
  };

  # Rotate the daemon log at 10 MiB, keeping 5 compressed generations.
  environment.etc."newsyslog.d/easytier.conf".text = ''
    # logfilename        [owner:group]  mode count size(KB) when flags
    ${logFile}  root:wheel     640  5     10240    *    JN
  '';
}
{{- end }}
