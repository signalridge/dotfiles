# ─────────────────────────────────────────────────────────────────────────────
# sing-box (official release, ./sing-box-package.nix)
# ─────────────────────────────────────────────────────────────────────────────
# The CLI on every Mac; the per-user LaunchAgent com.signalridge.sing-box runs
# /run/current-system/sw/bin/sing-box (private_Library/LaunchAgents). No root
# daemon: sing-box never takes over the system proxy here.
{ pkgs, ... }:
let
  sing-box = import ./sing-box-package.nix { inherit pkgs; };
in
{
  environment.systemPackages = [ sing-box ];
}
