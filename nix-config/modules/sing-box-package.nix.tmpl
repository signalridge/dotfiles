{{- $arch := "amd64" -}}
{{- $sha256 := .versions.singBoxDarwinAmd64Sha256 -}}
{{- if eq .chezmoi.arch "arm64" -}}
{{-   $arch = "arm64" -}}
{{-   $sha256 = .versions.singBoxDarwinArm64Sha256 -}}
{{- end -}}
# sing-box from the signalridge/sing-box-patches release tarball (macOS):
# upstream's release plus patches to its dependencies (F5 SAML login for the
# OpenConnect endpoint), laid out like upstream's. Used by ./sing-box.nix for
# the CLI and the LaunchDaemon on every Mac. Version, patch level and digests:
# .chezmoidata/versions.yaml, bumped by the update-versions workflow from
# GitHub's release-asset digests.
{ pkgs }:
let
  version = "{{ .versions.singBox }}";
  tag = "v${version}-{{ .versions.singBoxPatch }}";
in
pkgs.stdenvNoCC.mkDerivation {
  pname = "sing-box";
  inherit version;
  src = pkgs.fetchurl {
    url = "https://github.com/signalridge/sing-box-patches/releases/download/${tag}/sing-box-${version}-darwin-{{ $arch }}.tar.gz";
    sha256 = "{{ $sha256 }}";
  };
  sourceRoot = "sing-box-${version}-darwin-{{ $arch }}";
  # Release binary untouched (stripping would break its ad-hoc signature).
  dontConfigure = true;
  dontBuild = true;
  dontFixup = true;
  installPhase = ''
    runHook preInstall
    install -Dm755 sing-box "$out/bin/sing-box"
    runHook postInstall
  '';
}
