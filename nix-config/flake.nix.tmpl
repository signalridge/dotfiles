{
  description = "YixianLu's system flake";

  inputs = {
    # Core
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    flake-utils.url = "github:numtide/flake-utils";

    # Cross-platform package management
    flakey-profile.url = "github:lf-/flakey-profile";

{{- if eq .platform "darwin" }}

    # macOS only
    nix-darwin = {
      url = "github:LnL7/nix-darwin";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    mac-app-util = {
      url = "github:hraban/mac-app-util";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    nix-homebrew.url = "github:zhaofengli-wip/nix-homebrew";
    homebrew-core = {
      url = "github:homebrew/homebrew-core";
      flake = false;
    };
    homebrew-cask = {
      url = "github:homebrew/homebrew-cask";
      flake = false;
    };
    homebrew-bundle = {
      url = "github:homebrew/homebrew-bundle";
      flake = false;
    };
    # sing-box with the F5 SAML patches (signalridge/sing-box-patches),
    # built from source; bump with `nix flake update signalridge-nur`.
    signalridge-nur = {
      url = "github:signalridge/nur-packages";
      inputs.nixpkgs.follows = "nixpkgs";
    };
{{- end }}
  };

  outputs =
    inputs@{
      self,
      nixpkgs,
      flake-utils,
      flakey-profile,
{{- if eq .platform "darwin" }}
      nix-darwin,
      mac-app-util,
      nix-homebrew,
      homebrew-core,
      homebrew-cask,
      homebrew-bundle,
      signalridge-nur,
{{- end }}
      ...
    }:
    let
      # Architecture conversion: chezmoi arch → nix system
      {{- $arch := .chezmoi.arch -}}
      {{- if eq $arch "arm64" -}}
        {{- $arch = "aarch64" -}}
      {{- else if eq $arch "amd64" -}}
        {{- $arch = "x86_64" -}}
      {{- end }}
      system = "{{ $arch }}-{{ .platform }}";
      hostname = "{{ .hostname }}";
      username = "{{ .chezmoi.username }}";

      pkgs = import nixpkgs {
        inherit system;
        config.allowUnfree = true;
      };

      # flakey-profile for user packages (cross-platform)
      myProfile = import ./modules/profile.nix {
        inherit pkgs flakey-profile;
      };
{{- if eq .platform "darwin" }}

      specialArgs = inputs // {
        inherit username hostname;
      };
{{- end }}
    in
    {
{{- if eq .platform "darwin" }}
      # ─────────────────────────────────────────────────────────────────────────
      # Darwin Configuration (macOS only)
      # Usage: darwin-rebuild switch --flake .#<hostname>
      # ─────────────────────────────────────────────────────────────────────────
      darwinConfigurations.${hostname} = nix-darwin.lib.darwinSystem {
        inherit system specialArgs;
        modules = [
          ./modules/system.nix
          ./modules/apps.nix
          ./modules/host-users.nix
          ./modules/easytier.nix
          ./modules/sing-box.nix
          mac-app-util.darwinModules.default
          nix-homebrew.darwinModules.nix-homebrew
          {
            nix-homebrew = {
              enable = true;
              # No Intel (/usr/local) prefix: nothing here needs x86_64 brews and
              # Rosetta is not installed, so enabling it only produced a warning.
              enableRosetta = false;
              user = username;
            };
          }
        ];
      };

{{- end }}
      # ─────────────────────────────────────────────────────────────────────────
      # Package Profile (cross-platform)
      # flakey-profile provides: .switch, .rollback, .pin
      # Usage: nix run .#<hostname>.switch
      # ─────────────────────────────────────────────────────────────────────────
      packages.${system} = {
        ${hostname} = myProfile;
        # Official EasyTier release binaries; Linux EasyTier nodes run this store
        # path from a systemd unit (.chezmoiscripts/run_after_24_easytier-node.sh).
        easytier = import ./modules/easytier-package.nix { inherit pkgs; };
{{- if eq .platform "darwin" }}
        # First bootstrap uses the locked nix-darwin input, never a floating
        # remote branch executed as root.
        darwin-rebuild = nix-darwin.packages.${system}.default;
{{- end }}
      };

      # Formatter
      formatter.${system} = pkgs.alejandra;
    };
}
