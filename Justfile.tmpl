# Verify Codex configuration
[group('ai')]
codex-verify:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Verifying Codex configuration..."

    config="$HOME/.codex/config.toml"
    agents="$HOME/.codex/AGENTS.md"
    skills_link="$HOME/.codex/skills"
    shared_skills_dir="$HOME/.agents/skills"

    [[ -f "$config" ]] && echo "✓ config.toml exists" || { echo "❌ config.toml not found"; exit 1; }
    [[ -f "$agents" ]] && echo "✓ AGENTS.md exists" || { echo "❌ AGENTS.md not found"; exit 1; }

    if [[ -L "$skills_link" ]]; then
        target=$(readlink "$skills_link")
        echo "✓ ~/.codex/skills is symlink → $target"
    else
        echo "⚠ ~/.codex/skills is not a symlink"
    fi

    [[ -d "$shared_skills_dir" ]] && echo "✓ ~/.agents/skills exists" || { echo "❌ ~/.agents/skills not found"; exit 1; }

    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import sys,tomllib; from pathlib import Path; data=tomllib.loads(Path(sys.argv[1]).read_text(encoding='utf-8')); print('✓ TOML parses successfully'); provider=data.get('model_provider'); model=data.get('model'); print(f'✓ model/provider set: {model} @ {provider}' if provider and model else (f'✓ model set: {model}' if model else '⚠ model is not explicitly set')); profile=data.get('profile'); profiles=data.get('profiles', {}); assert (not profile) or (profile in profiles), f'❌ active profile missing in [profiles.*]: {profile}'; assert ('web_search' not in data) or isinstance(data['web_search'], bool), '❌ web_search must be boolean'; [(_ for _ in ()).throw(AssertionError(f'❌ profiles.{name}.web_search must be boolean')) for name,p in profiles.items() if ('web_search' in p and not isinstance(p['web_search'], bool))]; print('✓ semantic checks passed')" "$config"
    else
        echo "⚠ python3 not found; skipped TOML semantic checks"
    fi

# Validate Claude/Codex registry contracts
[group('ai')]
ai-contracts:
    #!/usr/bin/env bash
    set -euo pipefail
    root="$HOME/.local/share/chezmoi"

    claude_yaml="$root/.chezmoidata/claude.yaml"
    codex_tmpl="$root/dot_codex/config.toml.tmpl"
    codex_templates_dir="$root/dot_codex"

    [[ -f "$claude_yaml" ]] || { echo "❌ Missing $claude_yaml"; exit 1; }
    [[ -f "$codex_tmpl" ]] || { echo "❌ Missing $codex_tmpl"; exit 1; }

    # Contract 1: third-party Claude accounts must include 5 model fields
    yq -e '
      . as $root |
      [
        $root.claude.accounts
        | to_entries[]
        | select((.value.provider // (.key | split("@")[0])) as $p | ($root.claude.providers[$p].base_url // "") != "")
        | select((.value.model // "") == "" or (.value.small_model // "") == "" or (.value.sonnet_model // "") == "" or (.value.opus_model // "") == "" or (.value.haiku_model // "") == "")
        | .key
      ] | length == 0
    ' "$claude_yaml" >/dev/null || {
      echo "❌ Third-party Claude accounts must include: model, small_model, sonnet_model, opus_model, haiku_model"
      yq -r '
        . as $root |
        .claude.accounts
        | to_entries[]
        | select((.value.provider // (.key | split("@")[0])) as $p | ($root.claude.providers[$p].base_url // "") != "")
        | select((.value.model // "") == "" or (.value.small_model // "") == "" or (.value.sonnet_model // "") == "" or (.value.opus_model // "") == "" or (.value.haiku_model // "") == "")
        | .key
      ' "$claude_yaml"
      exit 1
    }

    # Contract 2: Codex templates must not reference .claude.*
    if rg -n '\.claude\.' "$codex_templates_dir" >/dev/null; then
      echo "❌ dot_codex templates must not reference .claude.*"
      rg -n '\.claude\.' "$codex_templates_dir"
      exit 1
    fi

    echo "✓ AI contracts validated"
