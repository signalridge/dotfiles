# Validate skills for duplicate names and required metadata
[group('ai')]
validate-skills:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Scanning skills metadata..."
    skills_dir="$HOME/.agents/skills"
    if [[ ! -d "$skills_dir" ]]; then
        echo "Skills directory not found: $skills_dir"
        exit 1
    fi

    # Ensure every SKILL.md has required frontmatter fields
    missing=0
    while IFS= read -r file; do
        if ! grep -q '^name:' "$file"; then
            echo "❌ Missing name: $file"
            missing=1
        fi
        if ! grep -q '^description:' "$file"; then
            echo "❌ Missing description: $file"
            missing=1
        fi
    done < <(find "$skills_dir" -name "SKILL.md" -type f)

    [[ $missing -eq 0 ]] || exit 1

    names=$(find "$skills_dir" -name "SKILL.md" -exec grep -h '^name:' {} \; | sed 's/^name:[[:space:]]*//' | sed '/^$/d' | sort)
    duplicates=$(echo "$names" | uniq -d)
    if [[ -n "$duplicates" ]]; then
        echo "❌ Duplicate skill names found:"
        echo "$duplicates"
        exit 1
    fi

    count=$(echo "$names" | sed '/^$/d' | wc -l | tr -d ' ')
    echo "✓ $count skills validated, no duplicate names"

