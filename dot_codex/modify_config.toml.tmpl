#!/usr/bin/env bash
# chezmoi modify_ script: render Codex config, preserving any [projects.*] sections
# that Codex CLI writes when the user trusts a project directory.
set -euo pipefail

EXISTING=$(cat)

cat <<'CHEZMOI_TEMPLATE_EOF'
#:schema https://developers.openai.com/codex/config-schema.json
# Codex CLI Configuration
# Managed by chezmoi - do not edit directly (except [projects.*] sections, which are preserved)
# Run: chezmoi edit ~/.codex/config.toml

{{- /* codexProviderAccount can be openai or provider@label */ -}}
{{- $accountKey := "openai" -}}
{{- if hasKey . "codexProviderAccount" -}}
{{-   $accountKey = .codexProviderAccount -}}
{{- end -}}
{{- $providerName := (split "@" $accountKey)._0 -}}

# =============================================================================
# Core Settings
# =============================================================================

# Default model
model = "gpt-5.5"

# Model provider (only for third-party providers)
{{- if ne $providerName "openai" }}
model_provider = "{{ $providerName }}"
{{- end }}

# Approval policy: untrusted | on-failure | on-request | never
approval_policy = "on-request"

# Sandbox mode: read-only | workspace-write | danger-full-access
sandbox_mode = "danger-full-access"

# Network access: enabled | disabled
network_access = "enabled"

# Disable response storage
disable_response_storage = true

# Windows WSL setup acknowledgement
windows_wsl_setup_acknowledged = true

# Suppress unstable feature warnings
suppress_unstable_features_warning = true

# =============================================================================
# Model Configuration
# =============================================================================

# Reasoning effort: none | minimal | low | medium | high | xhigh
model_reasoning_effort = "xhigh"


# Personality: none | friendly | pragmatic
personality = "pragmatic"

# Verbosity: low | medium | high
model_verbosity = "high"

# Web search mode: disabled | cached | live
web_search = "live"

# =============================================================================
# Project Documentation
# =============================================================================

project_doc_fallback_filenames = ["CLAUDE.md", "TEAM_GUIDE.md", ".harnesses.md", "CODEX.md"]
project_doc_max_bytes = 65536

# =============================================================================
# Feature Flags
# =============================================================================

[features]
hooks = true
apps = true
shell_tool = true
memories = true
fast_mode = false
apply_patch_freeform = true
unified_exec = true
shell_snapshot = true
runtime_metrics = true
undo = true
request_rule = true
responses_websockets = false
remote_compaction = true
remote_models = true
skill_mcp_dependency_install = true
skill_env_var_dependency_prompt = true

# =============================================================================
# Tools
# =============================================================================

[tools]
view_image = true

# =============================================================================
# Plugins
# =============================================================================

[plugins."slack@openai-curated"]
enabled = true

# =============================================================================
# History Settings
# =============================================================================

[history]
persistence = "save-all"
max_bytes = 104857600

# =============================================================================
# TUI Settings
# =============================================================================

[tui]
notifications = true
animations = true
show_tooltips = true
# Built-in status line segments (declarative — no external script, unlike Claude Code's).
status_line = ["model-with-reasoning", "git-branch", "pull-request-number", "branch-changes", "run-state", "permissions", "approval-mode", "context-used", "weekly-limit", "context-window-size"]
status_line_use_colors = true

# =============================================================================
# Lifecycle Hooks
# =============================================================================

[[hooks.SessionStart]]
hooks = [
  { type = "command", command = "bash '{{ .chezmoi.homeDir }}/.codex/herdr-agent-state.sh' session", timeout = 10 },
  { type = "command", command = "{{ .chezmoi.homeDir }}/.local/bin/tmux-ai-agent-state codex idle", timeout = 1 },
]

[[hooks.UserPromptSubmit]]
hooks = [{ type = "command", command = "{{ .chezmoi.homeDir }}/.local/bin/tmux-ai-agent-state codex busy", timeout = 1 }]

[[hooks.Stop]]
hooks = [{ type = "command", command = "{{ .chezmoi.homeDir }}/.local/bin/tmux-ai-agent-state codex idle", timeout = 1 }]

# =============================================================================
# Model Providers (Third-Party)
# =============================================================================

[model_providers.deepseek]
name = "Deepseek"
base_url = "https://api.deepseek.com/v1"

[model_providers.doubao]
name = "Doubao"
base_url = "https://ark.cn-beijing.volces.com/api/v3"

[model_providers.glm]
name = "Glm"
base_url = "https://open.bigmodel.cn/api/paas/v4"

[model_providers.kimi]
name = "Kimi"
base_url = "https://api.moonshot.ai/v1"

[model_providers.krill]
name = "krill"
base_url = "https://api.krill-ai.com/codex/v1"
requires_openai_auth = true
wire_api = "responses"

[model_providers.minimax]
name = "Minimax"
base_url = "https://api.minimax.io/v1"

[model_providers.qwen]
name = "Qwen"
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

# =============================================================================
# MCP Servers
# =============================================================================

[mcp_servers.notion]
url = "https://mcp.notion.com/mcp"

[mcp_servers.context7]
# Official hosted Context7 MCP endpoint. The old local HTTP daemon used
# @upstash/context7-mcp@2.1.1 and can fail repeated Streamable HTTP handshakes.
url = "https://mcp.context7.com/mcp"

[mcp_servers.serena]
command = "uvx"
args = ["--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--context", "codex", "--project", ".", "--enable-web-dashboard", "false"]
startup_timeout_sec = 30
[mcp_servers.serena.env]
AQUA_GLOBAL_CONFIG = "{{ .chezmoi.homeDir }}/.config/aquaproj-aqua/aqua.yaml"

[mcp_servers.tavily]
command = "{{ .chezmoi.homeDir }}/.local/bin/mcp-tavily"
args = []

[mcp_servers.gitmcp]
url = "https://gitmcp.io/docs"

[mcp_servers.deepwiki]
url = "https://mcp.deepwiki.com/mcp"

# =============================================================================
# Profiles
# =============================================================================

[profiles.deep-review]
model_reasoning_effort = "xhigh"
approval_policy = "on-request"

[profiles.research]
model_reasoning_effort = "xhigh"
web_search = "live"

# =============================================================================
# Shell Environment Policy
# =============================================================================

[shell_environment_policy]
inherit = "all"
exclude = []
ignore_default_excludes = true
experimental_use_profile = true

# =============================================================================
# Sandbox Workspace Write Settings
# =============================================================================

[sandbox_workspace_write]
network_access = true
exclude_slash_tmp = false
CHEZMOI_TEMPLATE_EOF

preserve_toml_tables() {
  local header_regex="$1"

  printf '%s\n' "$EXISTING" | awk -v header_regex="$header_regex" '
    $0 ~ header_regex             { in_table = 1; print; next }
    in_table && /^\[/             { in_table = 0 }
    in_table                      { print }
  '
}

preserve_managed_hooks_state() {
  printf '%s\n' "$EXISTING" | awk '
    /^\[hooks\.state\]$/ {
      in_table = 1
      print
      next
    }
    /^\[hooks\.state\./ {
      in_table = ($0 ~ /:(session_start|user_prompt_submit|stop):/ && $0 !~ /\/\.codex\/hooks\.json:/)
      if (in_table) {
        print
      }
      next
    }
    in_table && /^\[/ {
      in_table = 0
    }
    in_table {
      print
    }
  '
}

# Preserve Codex hook trust state for inline/project config hooks, but drop
# legacy standalone hooks.json state now that hooks live in config.toml.
hooks_state=$(preserve_managed_hooks_state)

# Preserve [projects.*] sections (Codex CLI writes these when trusting a directory).
# Capture from the first [projects.*] header until a different top-level table appears.
projects=$(preserve_toml_tables '^\\[projects\\.')

if [ -n "$hooks_state" ]; then
  printf '\n%s\n' "$hooks_state"
fi

if [ -n "$projects" ]; then
  printf '\n%s\n' "$projects"
fi
