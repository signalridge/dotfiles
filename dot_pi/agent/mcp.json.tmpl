{{- /*
  ~/.pi/agent/mcp.json — standard MCP server definitions, read by Pi and
  pi-mcp-adapter. Keep only transport/client fields here. Adapter-only settings
  and per-server overrides live in dot_pi/agent/mcp-adapter.json.tmpl; putting
  lifecycle, directTools, or settings here is ignored and warns at startup.
  The adapter package is declared in .chezmoidata/pi.yaml.
  The server list lives in .chezmoidata/mcp.yaml (harness key "pi").
*/ -}}
{{- $harness := "pi" -}}
{{- $servers := list -}}
{{- range .mcp.servers -}}
{{-   $on := true -}}
{{-   if hasKey . "only" -}}{{- $on = has $harness .only -}}{{- end -}}
{{-   if hasKey . "exclude" -}}{{- if has $harness .exclude -}}{{- $on = false -}}{{- end -}}{{- end -}}
{{-   if $on -}}{{- $servers = append $servers . -}}{{- end -}}
{{- end -}}
{
  "mcpServers": {
{{- range $i, $s := $servers }}
    {{ $s.name | toJson }}: {
{{-   if hasKey $s "url" }}
      "url": {{ $s.url | toJson }}
{{-   else }}
{{-     $cmd := $s.command -}}
{{-     if hasPrefix "~/" $cmd -}}{{- $cmd = printf "%s/%s" $.chezmoi.homeDir (trimPrefix "~/" $cmd) -}}{{- end }}
      "command": {{ $cmd | toJson }},
      "args": [{{ range $j, $a := $s.args }}{{ if $j }}, {{ end }}{{ $a | toJson }}{{ end }}]
{{-   end }}
    }{{ if lt (add1 $i) (len $servers) }},{{ end }}
{{- end }}
  }
}
