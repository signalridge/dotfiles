{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "**/.aws/credentials": "deny",
      "**/.config/gopass/*": "deny"
    },
    "bash": {
      "*": "allow"
    },
    "external_directory": {
      "*": "allow"
    }
  }
}
