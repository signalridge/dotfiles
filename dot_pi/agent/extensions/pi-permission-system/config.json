{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "**/.aws/credentials": "deny",
      "**/.config/gopass/*": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "sudo *": "ask",
      "git push --force*": "ask",
      "git push -f *": "ask",
      "git push * --force*": "ask",
      "dd *": "deny",
      "mkfs*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.pi/*": "allow",
      "~/.cargo/registry/*": "allow",
      "~/.local/share/mise/*": "allow"
    }
  }
}
