{{- /*
  ~/.pi/agent/subagents.json — pi-subagents runtime policy.

  agentTiers is the subagent model policy and the ONE tier table; other files
  point here instead of restating rungs (agent frontmatter and
  workflows/settings.json.tmpl name tier keys only). Identical on both machines
  (no `.work` branch); the rungs are the variables just below:
    low    = $lowModel / $lowThink        search, navigation, read-heavy work
    medium = $mediumModel / $mediumThink  implementation, review, verification
    high   = $highModel / $highThink      architecture, high-risk review

  Resolution: resolveAgentTier() is the only resolver. A call (or an agent's
  frontmatter `tier:`, e.g. Explore's `low`) names a key from this catalogue;
  a call naming none takes agentTiers.defaultTier (medium), and the shipped
  fallback is also `medium`. The host cannot pass model or thinking directly.
  Keep the low/medium/high names: the built-in workflows and ad-hoc scripts
  resolve against them. The shipped `fast` profile is gone; nothing may name it.

  The parent session is emitted separately by modify_settings.json.tmpl and is
  this catalogue's `medium` row verbatim, so an interactive turn and a spawn
  that names no tier cost the same. Keep the two in lockstep, and do not collapse the rungs back to one
  model/effort without an explicit policy change.

  Workflows: pi-workflows names a *strength*, and its `strengths` table in
  workflows/settings.json.tmpl maps each one onto a key from THIS catalogue
  (identity mapping here). No `workflow` key may appear in this file. To price
  workflow work separately, add a profile here and point a strength at it;
  do not edit a rung the rest of the catalogue shares. The built-in quality
  helpers request `low` (verify, judgePanel) and `medium` (completenessCheck);
  a requested tier outranks defaultTier.

  Before changing a pin, check availability and thinkingLevelMap with
  `pi --list-models`. Do not infer per-task cost from historical measurements.

  maxConcurrent sizes every background agent on the machine: direct Agent
  fan-out, and workflow fan-out (pi-workflows reads it over the ping handshake
  as both default width and ceiling). Keep it <= 64: pi-workflows clamps at 64,
  so a larger value would silently diverge between the two.
*/ -}}
{{- $highModel := "gpt-6-astra" -}}
{{- $highThink := "medium" -}}
{{- $mediumModel := "gpt-6.1-sol" -}}
{{- $mediumThink := "high" -}}
{{- $lowModel := "gpt-6.1-sol" -}}
{{- $lowThink := "low" -}}
{
  "maxConcurrent": 40,
  "defaultMaxTurns": 640,
  "defaultMaxToolCalls": 1024,
  "defaultMaxTokens": 3000000,
  "graceTurns": 8,
  "defaultJoinMode": "smart",
  "schedulingEnabled": true,
  "scopeModels": false,
  "disableDefaultAgents": true,
  "fallbackSubagent": "none",
  "toolDescriptionMode": "full",
  "fleetView": true,
  "outputTranscript": true,
  "agentTiers": {
    "defaultTier": "medium",
    "profiles": {
      "low": {
        "description": "Search, navigation, and read-heavy work where breadth beats depth",
        "model": "openai-codex/{{ $lowModel }}",
        "thinking": "{{ $lowThink }}"
      },
      "medium": {
        "description": "Implementation, review, and verification",
        "model": "openai-codex/{{ $mediumModel }}",
        "thinking": "{{ $mediumThink }}"
      },
      "high": {
        "description": "Architecture and high-risk review, where a wrong call is expensive to reverse",
        "model": "openai-codex/{{ $highModel }}",
        "thinking": "{{ $highThink }}"
      }
    }
  }
}
