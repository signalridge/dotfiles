{{- /*
  ~/.pi/agent/subagents.json — pi-subagents runtime policy.

  agentTiers is the catalogue of named model profiles. Agent files do not pin a
  profile; the host may pass a catalogue key on an Agent call for explicit routing.
  If omitted, agentTiers.defaultTier applies. The host cannot pass model or thinking
  directly.

  As of 2026-08-17 the three profiles are DELIBERATELY IDENTICAL: every subagent
  runs opencode-go/deepseek-v4-flash at thinking level max, the same pin the parent
  session carries in modify_settings.json.tmpl (user request — one model, one
  effort, everywhere). That is the opencode Go SUBSCRIPTION route; the per-token
  direct route to the same model stays configured as `deepseek/deepseek-v4-flash`.
  `max` is a real provider rung on both, not a nominal one — see the
  thinkingLevelMaps in .chezmoidata/pi.yaml, where the direct provider's used to
  flatten it to `high`. The catalogue keys are kept rather than collapsed to a single
  profile so that `tier` values already passed by prompts and by pi-workflows keep
  resolving, and so re-differentiating later is a value edit rather than a
  protocol change. Descriptions state the routing INTENT, not a current difference.

  Keep these names separate from pi-workflows' `workflow.tiers`, whose fixed
  protocol remains portable.

  Note the `.work` ternaries that used to vary model and thinking budget per
  machine are gone; nothing in this file branches on chezmoi data any more.
*/ -}}
{{- $model := "opencode-go/deepseek-v4-flash" -}}
{{- $thinking := "max" -}}
{
  "maxConcurrent": 16,
  "defaultMaxTurns": 0,
  "graceTurns": 8,
  "defaultJoinMode": "smart",
  "schedulingEnabled": true,
  "scopeModels": false,
  "disableDefaultAgents": true,
  "toolDescriptionMode": "full",
  "fleetView": true,
  "outputTranscript": true,
  "agentTiers": {
    "defaultTier": "medium",
    "profiles": {
      "low": {
        "description": "Search, navigation, and read-heavy work where breadth beats depth",
        "model": "{{ $model }}",
        "thinking": "{{ $thinking }}"
      },
      "medium": {
        "description": "Planning, implementation, review, and verification",
        "model": "{{ $model }}",
        "thinking": "{{ $thinking }}"
      },
      "high": {
        "description": "Architecture and high-risk review, where a wrong call is expensive to reverse",
        "model": "{{ $model }}",
        "thinking": "{{ $thinking }}"
      }
    }
  }
}
