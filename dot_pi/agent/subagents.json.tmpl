{{- /*
  ~/.pi/agent/subagents.json — pi-subagents runtime policy.

  agentTiers is the catalogue of named model profiles. Agent files do not pin a
  profile; the host may pass a catalogue key on an Agent call for explicit routing.
  If omitted, agentTiers.defaultTier applies (medium). The host cannot pass model
  or thinking directly.

  The three profiles are DELIBERATELY IDENTICAL: every subagent runs one model at
  one effort. As of 2026-08-20 that is openai-codex/gpt-5.6-luna at thinking max
  (user request), over the native Codex OAuth in ~/.pi/agent/auth.json.

  This MATCHES THE PARENT, which carries the same pin in
  modify_settings.json.tmpl — the standing "one model, one effort, everywhere"
  request. Both sides moved together three times on 2026-08-20
  (muse-spark-1.2/max -> gpt-5.6-sol/xhigh -> gpt-5.6-luna/max). Change both or
  neither.

  Why luna: probed against the same route on the same day, luna and sol share the
  same measured ~921K input ceiling, and luna's input price is a fraction of
  sol's. Same window, cheaper token. The numbers and the probe method are in the
  openai-codex block of .chezmoidata/pi.yaml.

  `max` is a REAL rung on gpt-5.6-luna, not a clamp — its thinkingLevelMap is
  {minimal: low, xhigh: xhigh, max: max} — and it is also the value that survives
  a runtime /model switch intact: max reaches the TOP rung of every model
  reachable from here because each translates it through its own map, whereas
  xhigh clamps DOWN to high on any model whose map has no xhigh key
  (opencode-go/deepseek-v4-flash and the direct deepseek route both qualify).

  The catalogue keys are kept rather than collapsed to a single profile so that
  `tier` values already passed by prompts and by pi-workflows keep resolving, and
  so re-differentiating later is a value edit rather than a protocol change.
  Descriptions state the routing INTENT, not a current difference.

  Keep these names separate from pi-workflows' `workflow.tiers`, whose fixed
  protocol remains portable.

  Nothing in this file branches on chezmoi data.
*/ -}}
{{- $model := "openai-codex/gpt-5.6-luna" -}}
{{- $thinking := "max" -}}
{
  "maxConcurrent": 16,
  "defaultMaxTurns": 640,
  "defaultMaxToolCalls": 1024,
  "defaultMaxTokens": 3000000,
  "graceTurns": 8,
  "defaultJoinMode": "smart",
  "schedulingEnabled": true,
  "scopeModels": false,
  "disableDefaultAgents": true,
  "fallbackSubagent": "none",
  "toolDescriptionMode": "full",
  "fleetView": true,
  "outputTranscript": true,
  "agentTiers": {
    "defaultTier": "medium",
    "profiles": {
      "low": {
        "description": "Search, navigation, and read-heavy work where breadth beats depth",
        "model": "{{ $model }}",
        "thinking": "{{ $thinking }}"
      },
      "medium": {
        "description": "Implementation, review, and verification",
        "model": "{{ $model }}",
        "thinking": "{{ $thinking }}"
      },
      "high": {
        "description": "Architecture and high-risk review, where a wrong call is expensive to reverse",
        "model": "{{ $model }}",
        "thinking": "{{ $thinking }}"
      }
    }
  }
}
