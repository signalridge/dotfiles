{{- /*
  ~/.pi/agent/subagents.json — pi-subagents runtime policy.

  agentTiers is the catalogue of named model profiles. Agent files do not pin a
  profile; the host may pass a catalogue key on an Agent call for explicit routing.
  If omitted, agentTiers.defaultTier applies. The host cannot pass model or thinking
  directly.

  The three profiles are DELIBERATELY IDENTICAL: every subagent runs one model at
  thinking level max. As of 2026-08-19 that model is opencode-go/muse-spark-1.2
  (user request), over the opencode Go SUBSCRIPTION route.

  This MATCHES THE PARENT, which carries the same pin in
  modify_settings.json.tmpl — the standing "one model, one effort, everywhere"
  request. Both sides ran opencode-go/deepseek-v4-flash from 2026-08-17 and moved
  together on 2026-08-19. Change both or neither.

  `max` is NOT a provider rung on muse-spark-1.2 — unlike deepseek-v4-flash, where
  it is real on both the subscription and the direct `deepseek/deepseek-v4-flash`
  route. The gateway rejects `"effort":"max"` outright with invalid_request_error
  (probed 2026-08-19, alongside minimal/low/medium/high/xhigh which all answer
  200). `thinking: max` below is still correct and still the right value: pi
  clamps a rung a model does not offer down to its top one before sending
  (clampThinkingLevel in pi-ai/dist/models.js), so this dispatches at xhigh. Keep
  it at max rather than "honestly" writing xhigh — max is the only value that
  reaches the TOP rung of every model reachable from here, and
  deepseek-v4-flash's built-in map has no `xhigh` key at all.

  The catalogue keys are kept rather than collapsed to a single profile so that
  `tier` values already passed by prompts and by pi-workflows keep resolving, and
  so re-differentiating later is a value edit rather than a protocol change.
  Descriptions state the routing INTENT, not a current difference.

  Keep these names separate from pi-workflows' `workflow.tiers`, whose fixed
  protocol remains portable.

  Note the `.work` ternaries that used to vary model and thinking budget per
  machine are gone; nothing in this file branches on chezmoi data any more.
*/ -}}
{{- $model := "opencode-go/muse-spark-1.2" -}}
{{- $thinking := "max" -}}
{
  "maxConcurrent": 16,
  "defaultMaxTurns": 0,
  "graceTurns": 8,
  "defaultJoinMode": "smart",
  "schedulingEnabled": true,
  "scopeModels": false,
  "disableDefaultAgents": true,
  "toolDescriptionMode": "full",
  "fleetView": true,
  "outputTranscript": true,
  "agentTiers": {
    "defaultTier": "medium",
    "profiles": {
      "low": {
        "description": "Search, navigation, and read-heavy work where breadth beats depth",
        "model": "{{ $model }}",
        "thinking": "{{ $thinking }}"
      },
      "medium": {
        "description": "Planning, implementation, review, and verification",
        "model": "{{ $model }}",
        "thinking": "{{ $thinking }}"
      },
      "high": {
        "description": "Architecture and high-risk review, where a wrong call is expensive to reverse",
        "model": "{{ $model }}",
        "thinking": "{{ $thinking }}"
      }
    }
  }
}
