#!/usr/bin/env bash
# chezmoi modify_ script: merge managed Pi settings into ~/.pi/agent/settings.json,
# preserving any keys Pi or the user writes (e.g. via /settings, /model). Managed
# keys (defaultProvider/defaultModel/theme/...) always win on re-apply.
#
# Defaults come from .chezmoidata/pi.yaml. Switch provider/model at runtime with
# Pi's native /model command; this only sets the startup default.
set -euo pipefail

EXISTING="$(cat)"
{{ $d := .pi.defaults -}}
{{/* Parent model + effort, machine-scoped: work -> luna/xhigh, private -> luna/max.
     Pi is intentionally configured independently from Codex. These values have to
     stay in a template: .chezmoidata files cannot branch on the machine-scoped
     `work` flag because chezmoi reads them before the template engine starts. */ -}}
{{- $model := "gpt-5.6-luna" -}}
{{- $effort := ternary "xhigh" "max" .work -}}
{{/* Keep external npm dependencies first, then the exact pi.signalridgePackages
     order rendered as unpinned npm specs. No version suffix is emitted on
     purpose: Pi resolves the latest release at install time and
     run_after_20_update-pi-extensions.sh keeps it current. */ -}}
{{- $packageSources := .pi.packages -}}
{{- range .pi.signalridgePackages -}}
{{- $packageSources = append $packageSources (printf "npm:@signalridge/%s" .) -}}
{{- end -}}
{{- $managed := dict "defaultProvider" $d.defaultProvider "defaultModel" $model "theme" $d.theme "quietStartup" $d.quietStartup "defaultThinkingLevel" $effort "enableSkillCommands" true "npmCommand" $d.npmCommand "compaction" $d.compaction "branchSummary" $d.branchSummary "retry" $d.retry "packages" $packageSources -}}
MANAGED="$(cat <<'PI_SETTINGS_EOF'
{{ $managed | toPrettyJson }}
PI_SETTINGS_EOF
)"

if command -v jq >/dev/null 2>&1 && printf '%s' "$EXISTING" | jq -e . >/dev/null 2>&1; then
    # Deep-merge managed values, then remove the legacy pi-subagents settings
    # block; the repository-owned package reads ~/.pi/agent/subagents.json.
    jq -s '.[0] * .[1] | del(.subagents)' <(printf '%s' "$EXISTING") <(printf '%s' "$MANAGED")
else
    printf '%s\n' "$MANAGED"
fi
