#!/usr/bin/env bash
# chezmoi modify_ script: merge managed Pi settings into ~/.pi/agent/settings.json,
# preserving any keys Pi or the user writes (e.g. via /settings, /model). Managed
# keys (defaultProvider/defaultModel/theme/...) always win on re-apply.
#
# Defaults come from .chezmoidata/pi.yaml. Switch provider/model at runtime with
# Pi's native /model command; this only sets the startup default.
set -euo pipefail

EXISTING="$(cat)"
{{ $d := .pi.defaults -}}
{{/* Parent model + effort match the Agent catalogue's medium/default baseline
     on both work and private machines: gpt-6.1-sol at high. Keep this pair in
     lockstep with subagents.json.tmpl so interactive turns and unqualified
     spawns use the same rung.
     defaultProvider comes from .chezmoidata/pi.yaml (native Codex OAuth).
     Pi is intentionally configured independently from Codex. */ -}}
{{- $model := "gpt-6.1-sol" -}}
{{- $effort := "high" -}}
{{/* Keep external npm dependencies first, then the exact pi.signalridgePackages
     order rendered as unpinned npm specs. No version suffix is emitted on
     purpose: Pi resolves the latest release at install time and
     run_after_20_update-pi-extensions.sh keeps it current. */ -}}
{{- $packageSources := .pi.packages -}}
{{- range .pi.signalridgePackages -}}
{{- $packageSources = append $packageSources (printf "npm:@signalridge/%s" .) -}}
{{- end -}}
{{- $managed := dict "defaultProvider" $d.defaultProvider "defaultModel" $model "theme" $d.theme "quietStartup" $d.quietStartup "defaultThinkingLevel" $effort "enableSkillCommands" true "npmCommand" $d.npmCommand "defaultTools" $d.defaultTools "compaction" $d.compaction "branchSummary" $d.branchSummary "retry" $d.retry "packages" $packageSources -}}
MANAGED="$(cat <<'PI_SETTINGS_EOF'
{{ $managed | toPrettyJson }}
PI_SETTINGS_EOF
)"

if [[ -z "${EXISTING//[[:space:]]/}" ]]; then
    printf '%s\n' "$MANAGED"
    exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
    printf '%s\n' 'Cannot merge existing Pi settings without jq; leaving settings unchanged.' >&2
    exit 1
fi
if ! printf '%s' "$EXISTING" | jq -se 'length == 1 and (.[0] | type == "object")' >/dev/null 2>&1; then
    printf '%s\n' 'Existing Pi settings must be a single valid JSON object; leaving settings unchanged.' >&2
    exit 1
fi

# Deep-merge managed values, then remove legacy settings. Pi 1.3 reads the
# agent delay cap and provider retry limit separately; retry.maxRetryDelayMs
# at the retry root is ignored. The subagent package reads subagents.json.
jq -s '.[0] * .[1] | del(.subagents, .retry.maxRetryDelayMs)' \
    <(printf '%s' "$EXISTING") <(printf '%s' "$MANAGED")
