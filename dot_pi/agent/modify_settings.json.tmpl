#!/usr/bin/env bash
# chezmoi modify_ script: merge managed Pi settings into ~/.pi/agent/settings.json,
# preserving any keys Pi or the user writes (e.g. via /settings, /model). Managed
# keys (defaultProvider/defaultModel/theme/...) always win on re-apply.
#
# Defaults come from .chezmoidata/pi.yaml. Switch provider/model at runtime with
# Pi's native /model command; this only sets the startup default.
set -euo pipefail

EXISTING="$(cat)"
{{ $d := .pi.defaults -}}
{{/* Parent model + effort. ONE pin on every machine, matching all three
     pi-subagents tiers in subagents.json.tmpl: one model, one effort, everywhere.
     gpt-5.6-luna at max as of 2026-08-20 (user request). Same day, in order:
     muse-spark-1.2/max -> gpt-5.6-sol/xhigh -> gpt-5.6-luna/max.
     `defaultProvider` — openai-codex, the native Codex OAuth route — still comes
     from .chezmoidata/pi.yaml, so the model id here is intentionally bare: it is
     resolved against whatever that provider is. Nothing here branches on chezmoi
     data; these values stay in a template only because settings.json is
     assembled here.

     Why luna over sol: they were probed against the same route on the same day
     and share the same measured ~921K input ceiling (see the openai-codex
     modelOverrides block in .chezmoidata/pi.yaml), while luna's input price is a
     fraction of sol's. Same window, cheaper token.

     $effort is `max`, and on luna that is a REAL rung, not a clamp: its
     thinkingLevelMap is {minimal: low, xhigh: xhigh, max: max}. max is also the
     value that keeps working after a runtime /model switch — it is the only one
     that reaches the TOP rung of every model reachable from here, because each
     translates it through its own map, whereas `xhigh` clamps DOWN to high on
     any model whose map lacks an xhigh key (opencode-go/deepseek-v4-flash and
     the direct deepseek route both qualify).
     Pi is intentionally configured independently from Codex. */ -}}
{{- $model := "gpt-5.6-luna" -}}
{{- $effort := "max" -}}
{{/* Keep external npm dependencies first, then the exact pi.signalridgePackages
     order rendered as unpinned npm specs. No version suffix is emitted on
     purpose: Pi resolves the latest release at install time and
     run_after_20_update-pi-extensions.sh keeps it current. */ -}}
{{- $packageSources := .pi.packages -}}
{{- range .pi.signalridgePackages -}}
{{- $packageSources = append $packageSources (printf "npm:@signalridge/%s" .) -}}
{{- end -}}
{{- $managed := dict "defaultProvider" $d.defaultProvider "defaultModel" $model "theme" $d.theme "quietStartup" $d.quietStartup "defaultThinkingLevel" $effort "enableSkillCommands" true "npmCommand" $d.npmCommand "compaction" $d.compaction "branchSummary" $d.branchSummary "retry" $d.retry "packages" $packageSources -}}
MANAGED="$(cat <<'PI_SETTINGS_EOF'
{{ $managed | toPrettyJson }}
PI_SETTINGS_EOF
)"

if command -v jq >/dev/null 2>&1 && printf '%s' "$EXISTING" | jq -e . >/dev/null 2>&1; then
    # Deep-merge managed values, then remove the legacy pi-subagents settings
    # block; the repository-owned package reads ~/.pi/agent/subagents.json.
    jq -s '.[0] * .[1] | del(.subagents)' <(printf '%s' "$EXISTING") <(printf '%s' "$MANAGED")
else
    printf '%s\n' "$MANAGED"
fi
