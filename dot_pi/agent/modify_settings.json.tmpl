#!/usr/bin/env bash
# chezmoi modify_ script: merge managed Pi settings into ~/.pi/agent/settings.json,
# preserving any keys Pi or the user writes (e.g. via /settings, /model). Managed
# keys (defaultProvider/defaultModel/theme/...) always win on re-apply.
#
# Defaults come from .chezmoidata/pi.yaml. Switch provider/model at runtime with
# Pi's native /model command; this only sets the startup default.
set -euo pipefail

EXISTING="$(cat)"
{{ $d := .pi.defaults -}}
{{/* Parent model + effort are the medium/default baseline and remain
     machine-scoped to match the Agent tier catalogue in subagents.json.tmpl —
     since protocol v4 the single tier vocabulary, which managed workflow spawns
     name directly: work -> gpt-5.6-luna at max, private -> gpt-6-astra at
     medium.
     `defaultProvider` — openai-codex, the native Codex OAuth route — still
     comes from .chezmoidata/pi.yaml, so the model id here is intentionally bare
     and resolved against that provider. These values stay in a template because
     the machine-scoped `work` flag is not available in the static .chezmoidata
     data pass.

     These two values ARE that catalogue's `medium` row, character for
     character, and the pair is meant to move together: an interactive turn and
     a managed spawn that names no tier should cost the same. The full catalogue
     as of 2026-09-07 is private low = luna/max, medium = astra/medium, high =
     astra/high; work low = luna/xhigh, medium = luna/max, high = astra/medium —
     work being private shifted down one rung. If you reprice `medium` there,
     reprice this; the alignment test asserts both sides, on both machines.

     Cost, per task at codexradar: the private parent sat at astra/high ($2.84)
     from 2026-09-06 and moves down to astra/medium on 2026-09-07, so it gets
     cheaper by an amount nobody has measured yet — astra/medium has no row in
     that table on purpose, so read it before interpolating one. The work parent
     does not move: luna/max, $0.53, as it has been.
     Pi is intentionally configured independently from Codex. */ -}}
{{- $model := ternary "gpt-5.6-luna" "gpt-6-astra" .work -}}
{{- $effort := ternary "max" "medium" .work -}}
{{/* Keep external npm dependencies first, then the exact pi.signalridgePackages
     order rendered as unpinned npm specs. No version suffix is emitted on
     purpose: Pi resolves the latest release at install time and
     run_after_20_update-pi-extensions.sh keeps it current. */ -}}
{{- $packageSources := .pi.packages -}}
{{- range .pi.signalridgePackages -}}
{{- $packageSources = append $packageSources (printf "npm:@signalridge/%s" .) -}}
{{- end -}}
{{- $managed := dict "defaultProvider" $d.defaultProvider "defaultModel" $model "theme" $d.theme "quietStartup" $d.quietStartup "defaultThinkingLevel" $effort "enableSkillCommands" true "npmCommand" $d.npmCommand "compaction" $d.compaction "branchSummary" $d.branchSummary "retry" $d.retry "packages" $packageSources -}}
MANAGED="$(cat <<'PI_SETTINGS_EOF'
{{ $managed | toPrettyJson }}
PI_SETTINGS_EOF
)"

if command -v jq >/dev/null 2>&1 && printf '%s' "$EXISTING" | jq -e . >/dev/null 2>&1; then
    # Deep-merge managed values, then remove the legacy pi-subagents settings
    # block; the repository-owned package reads ~/.pi/agent/subagents.json.
    jq -s '.[0] * .[1] | del(.subagents)' <(printf '%s' "$EXISTING") <(printf '%s' "$MANAGED")
else
    printf '%s\n' "$MANAGED"
fi
