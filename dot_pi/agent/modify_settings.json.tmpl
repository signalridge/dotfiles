#!/usr/bin/env bash
# chezmoi modify_ script: merge managed Pi settings into ~/.pi/agent/settings.json,
# preserving any keys Pi or the user writes (e.g. via /settings, /model). Managed
# keys (defaultProvider/defaultModel/theme/...) always win on re-apply.
#
# Defaults come from .chezmoidata/pi.yaml. Switch provider/model at runtime with
# Pi's native /model command; this only sets the startup default.
set -euo pipefail

EXISTING="$(cat)"
{{ $d := .pi.defaults -}}
{{/* Parent model + effort, machine-scoped: work -> luna/xhigh, private -> luna/max.
     KEEP IN LOCKSTEP with dot_codex/modify_config.toml.tmpl, which carries the
     same two lines — the point of the pair is that pi and codex agree. It has to
     be duplicated: .chezmoidata files cannot be templates (chezmoi reads them
     before the template engine starts), and .chezmoi.toml.tmpl's data section,
     which can, only runs on `chezmoi init` — a value resolved there would freeze
     into the user's config and stop tracking this repo on a plain apply. */ -}}
{{- $model := "gpt-5.6-luna" -}}
{{- $effort := ternary "xhigh" "max" .work -}}
{{- $managed := dict "defaultProvider" $d.defaultProvider "defaultModel" $model "theme" $d.theme "quietStartup" $d.quietStartup "defaultThinkingLevel" $effort "enableSkillCommands" true "npmCommand" $d.npmCommand "compaction" $d.compaction "branchSummary" $d.branchSummary "retry" $d.retry "packages" .pi.packages -}}
MANAGED="$(cat <<'PI_SETTINGS_EOF'
{{ $managed | toPrettyJson }}
PI_SETTINGS_EOF
)"

if command -v jq >/dev/null 2>&1 && printf '%s' "$EXISTING" | jq -e . >/dev/null 2>&1; then
    # Deep-merge managed values, then remove the legacy nicobailon/pi-subagents
    # settings block; @tintinweb/pi-subagents uses ~/.pi/agent/subagents.json.
    jq -s '.[0] * .[1] | del(.subagents)' <(printf '%s' "$EXISTING") <(printf '%s' "$MANAGED")
else
    printf '%s\n' "$MANAGED"
fi
