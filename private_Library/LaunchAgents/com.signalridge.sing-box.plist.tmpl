<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.signalridge.sing-box</string>

    <!-- sing-box on every Mac, no system proxy (point the browser's proxy
         extension or `proxy-on` at it).{{ if .work }} Work Mac: started at login, kept alive.{{ else }} Surge stays the default here, so it is
         loaded but NOT started at login.{{ end }} Start/stop by hand:
           launchctl kickstart gui/$(id -u)/com.signalridge.sing-box
           launchctl kill TERM gui/$(id -u)/com.signalridge.sing-box
         Proxy 127.0.0.1:{{ .singBox.mixedPort }}, panel http://127.0.0.1:{{ .singBox.clashApiPort }}/ui.
         Binary: the nix-darwin system package (nix-config/modules/sing-box.nix). -->
    <key>ProgramArguments</key>
    <array>
        <string>/run/current-system/sw/bin/sing-box</string>
        <string>run</string>
        <string>-c</string>
        <string>{{ .chezmoi.homeDir }}/.config/sing-box/config.json</string>
        <string>-D</string>
        <string>{{ .chezmoi.homeDir }}/.local/state/sing-box</string>
    </array>

{{- if .work }}
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
{{- else }}
    <key>RunAtLoad</key>
    <false/>
{{- end }}
    <key>ProcessType</key>
    <string>Background</string>
    <key>Umask</key>
    <integer>63</integer>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/sing-box.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/sing-box.launchd.log</string>
</dict>
</plist>
