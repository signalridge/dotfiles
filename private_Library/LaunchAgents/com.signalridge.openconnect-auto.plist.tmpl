{{- if eq (includeTemplate "sing-box/auto-auth.tmpl" .) "true" -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.signalridge.openconnect-auto</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.local/bin/openconnect-auto</string>
        <string>watch</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
        <key>PATH</key>
        <string>{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/.local/share/aquaproj-aqua/bin:/run/current-system/sw/bin:{{ .chezmoi.homeDir }}/.nix-profile/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>AQUA_GLOBAL_CONFIG</key>
        <string>{{ .chezmoi.homeDir }}/.config/aquaproj-aqua/aqua.yaml</string>
        <key>AQUA_POLICY_CONFIG</key>
        <string>{{ .chezmoi.homeDir }}/.config/aquaproj-aqua/aqua-policy.yaml</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/openconnect-auto.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/openconnect-auto.log</string>
</dict>
</plist>
{{- end }}
