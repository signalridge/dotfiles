# ─────────────────────────────────────────────────────────────────────────────
# Always ignore (repo metadata)
# ─────────────────────────────────────────────────────────────────────────────
*.tmp
README.md

# Python bytecode (defensive -- bundled skill scripts are currently bash, but
# leave the ignore in place for future Python-backed helpers)
**/__pycache__/
**/*.pyc

# OS-specific lock files (used by flake.lock.tmpl)
nix-config/.flake-darwin.lock
nix-config/.flake-linux.lock
README.ja.md
README.zh-CN.md
.editorconfig
.git/
.gitignore
.github/
.pre-commit-config.yaml
init.sh
docs/
node_modules/
selene.toml
stylua.toml
treefmt.toml
typos.toml

# ─────────────────────────────────────────────────────────────────────────────
# macOS-only exclusions (skip on Linux)
# ─────────────────────────────────────────────────────────────────────────────
{{- if ne .chezmoi.os "darwin" }}
# macOS-specific nix modules (these are source paths, OK for non-script files)
nix-config/modules/system.nix
nix-config/modules/apps.nix
nix-config/modules/host-users.nix

# macOS-specific scripts (target paths)
.chezmoiscripts/02_init.sh
.chezmoiscripts/09_install-paperlib.sh
.chezmoiscripts/10_update_homebrew_packages.sh

# macOS-only GUI apps (target paths)
Library/
.config/aerospace/
.config/borders/
.config/karabiner/
.config/ghostty/
.config/hammerspoon/
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# Headless/server exclusions (no GUI, reserved for future use)
# ─────────────────────────────────────────────────────────────────────────────
{{- if .headless }}
# GUI apps (not needed on headless servers)
.chezmoiscripts/09_install-paperlib.sh
.chezmoiscripts/15_load-qmk-hid-host-agent.sh
Library/LaunchAgents/com.signalridge.qmk-hid-host.plist
.config/aerospace/
.config/borders/
.config/karabiner/
.config/ghostty/
.config/hammerspoon/
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# Encryption-related exclusions (skip when useEncryption is false)
# ─────────────────────────────────────────────────────────────────────────────
{{- if not .useEncryption }}
.chezmoiscripts/01_setup-encryption-key.sh
.chezmoiscripts/06_setup-gopass.sh
# gopass is an encryption-gated feature (06_setup-gopass.sh above is skipped);
# don't write its config with an empty source_url when encryption is disabled.
.config/gopass/config
.ssh/*
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# Pi coding agent runtime/secret state — Pi writes these into ~/.pi/agent at
# runtime; never version-control them (settings.json/models.json/extensions are
# managed via dot_pi/, everything below is owned by Pi or the user).
# ─────────────────────────────────────────────────────────────────────────────
.pi/agent/auth.json
.pi/agent/sessions/
.pi/agent/trust.json
.pi/agent/keybindings.json
.pi/agent/npm/
.pi/agent/git/
.pi/agent/logs/
.pi/agent/extensions/*/node_modules/

# ─────────────────────────────────────────────────────────────────────────────
# Ignored directories
# ─────────────────────────────────────────────────────────────────────────────
backup/
tests/
