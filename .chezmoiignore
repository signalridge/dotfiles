# ─────────────────────────────────────────────────────────────────────────────
# Always ignore (repo metadata)
# ─────────────────────────────────────────────────────────────────────────────
*.tmp
README.md
README.ja.md
README.zh-CN.md
SECURITY.md
CLAUDE.md
AGENTS.md

# Local build artifacts and stray logs. These are in .gitignore, but .gitignore
# does not stop chezmoi: anything left in the source tree becomes a managed
# target, so a `nix build` here would apply `~/result` and a proxy/tool log
# dropped in this directory would be copied into $HOME.
result
result-*
*.log

# Python bytecode (defensive -- bundled skill scripts are currently bash, but
# leave the ignore in place for future Python-backed helpers)
**/__pycache__/
**/*.pyc

# OS-specific lock files (used by flake.lock.tmpl)
nix-config/.flake-darwin.lock
nix-config/.flake-linux.lock
.editorconfig
.git/
.gitignore
.github/
.pre-commit-config.yaml
init.sh
docs/
node_modules/
tools/
selene.toml
stylua.toml
treefmt.toml
typos.toml

# ─────────────────────────────────────────────────────────────────────────────
# macOS-only exclusions (skip on Linux)
# ─────────────────────────────────────────────────────────────────────────────
{{- if ne .chezmoi.os "darwin" }}
# macOS-specific nix modules (these are source paths, OK for non-script files)
nix-config/modules/system.nix
nix-config/modules/apps.nix
nix-config/modules/host-users.nix

# macOS-specific scripts (target paths)
.chezmoiscripts/02_init.sh
.chezmoiscripts/09_install-paperlib.sh
.chezmoiscripts/10_update_homebrew_packages.sh
.chezmoiscripts/17_load-launch-agents.sh
.chezmoiscripts/21_terminal-profile.sh
.chezmoiscripts/22_wezterm-icon.sh

# macOS-only GUI apps (target paths)
Library/
.config/aerospace/
.config/karabiner/
.config/wezterm/
.config/terminal/
.config/hammerspoon/
{{- else }}
# Linux-only: systemd --user units have no meaning on macOS (launchd is used
# there via Library/LaunchAgents). Exclude the script and units from the macOS
# target so the Linux-only script is not rendered or executed during apply.
.chezmoiscripts/19_load-systemd-user-units.sh
.config/systemd/
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# Headless/server exclusions (no GUI)
# ─────────────────────────────────────────────────────────────────────────────
{{- if .headless }}
# GUI apps (not needed on headless servers)
.chezmoiscripts/09_install-paperlib.sh
.chezmoiscripts/17_load-launch-agents.sh
.chezmoiscripts/22_wezterm-icon.sh
Library/LaunchAgents/com.signalridge.qmk-hid-host.plist
.config/aerospace/
.config/karabiner/
.config/wezterm/
.config/terminal/
.config/hammerspoon/
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# Encryption-related exclusions (skip when useEncryption is false)
# ─────────────────────────────────────────────────────────────────────────────
{{- if not .useEncryption }}
.chezmoiscripts/01_setup-encryption-key.sh
.chezmoiscripts/06_setup-gopass.sh
# gopass is an encryption-gated feature (06_setup-gopass.sh above is skipped);
# don't write its config with an empty source_url when encryption is disabled.
.config/gopass/config
.ssh/*
{{- end }}

# ─────────────────────────────────────────────────────────────────────────────
# Pi coding agent runtime/secret state — Pi writes these into ~/.pi/agent at
# runtime; never version-control them (settings.json/models.json/extensions are
# managed via dot_pi/, everything below is owned by Pi or the user).
# ─────────────────────────────────────────────────────────────────────────────
.pi/agent/auth.json
.pi/agent/sessions/
.pi/agent/trust.json
# keybindings.json is intentionally MANAGED (dot_pi/agent/keybindings.json): it
# holds our declarative key remaps (e.g. app.session.rename -> shift+r, freeing
# Ctrl+R for the @signalridge/pi-input-history popup). Pi only reads it unless you
# edit keys via its TUI, in which case `chezmoi diff` surfaces the drift.
.pi/agent/npm/
.pi/agent/git/
.pi/agent/logs/
.pi/agent/extensions/*/node_modules/

# ─────────────────────────────────────────────────────────────────────────────
# Ignored directories
# ─────────────────────────────────────────────────────────────────────────────
backup/
tests/
