#!/usr/bin/env bash
# chezmoi modify_ script: merge the managed keys from .chezmoidata/antigravity.yaml
# into ~/.gemini/antigravity-cli/settings.json, preserving everything the
# Antigravity CLI writes there itself (trustedWorkspaces, model, permissions, ...).
# Managed keys always win on re-apply; unmanaged keys are never touched.
#
# `private_` keeps the 0600 mode the CLI creates the file with.
set -euo pipefail

EXISTING="$(cat)"
MANAGED="$(cat <<'AGY_SETTINGS_EOF'
{{ .antigravity.settings | toPrettyJson }}
AGY_SETTINGS_EOF
)"

# Same guard as dot_pi/agent/modify_settings.json.tmpl: on a fresh machine the
# file does not exist yet (empty stdin), and a half-written one must not take the
# managed keys down with it.
if command -v jq >/dev/null 2>&1 && printf '%s' "$EXISTING" | jq -e . >/dev/null 2>&1; then
    jq -s '.[0] * .[1]' <(printf '%s' "$EXISTING") <(printf '%s' "$MANAGED")
else
    printf '%s\n' "$MANAGED"
fi
