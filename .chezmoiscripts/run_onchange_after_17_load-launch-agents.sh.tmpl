#!/bin/bash

set -euo pipefail

# (Re)load macOS LaunchAgents. Re-runs whenever any managed plist changes.
# qmk-hid-host plist sha256: {{ includeTemplate "private_Library/LaunchAgents/com.signalridge.qmk-hid-host.plist.tmpl" . | sha256sum }}
# mcp-reaper plist sha256: {{ includeTemplate "private_Library/LaunchAgents/com.signalridge.mcp-reaper.plist.tmpl" . | sha256sum }}
# cliproxyapi plist sha256: {{ includeTemplate "private_Library/LaunchAgents/com.signalridge.cliproxyapi.plist.tmpl" . | sha256sum }}
# sing-box plist sha256: {{ includeTemplate "private_Library/LaunchAgents/com.signalridge.sing-box.plist.tmpl" . | sha256sum }}
# sing-box config sha256: {{ includeTemplate "private_dot_config/private_sing-box/private_config.json.tmpl" . | sha256sum }}
{{ if and (eq .chezmoi.os "darwin") (not .headless) -}}
domain="gui/$(id -u)"

reload_launch_agent() {
    local label="$1"
    local plist="${HOME}/Library/LaunchAgents/${label}.plist"
    local bootstrap_output
    local bootstrap_status

    echo "    ${label}"

    if [[ ! -f "$plist" ]]; then
        echo "      plist not found at $plist, skipping"
        return 0
    fi

    if [[ "$label" == "com.signalridge.cliproxyapi" ]]; then
        # launchd opens StandardOutPath itself, before applying the job Umask.
        # Pre-create the log privately so startup output is not world-readable.
        (umask 077; mkdir -p "$HOME/Library/Logs"; touch "$HOME/Library/Logs/cliproxyapi.launchd.log")
        chmod 600 "$HOME/Library/Logs/cliproxyapi.launchd.log"
    fi

    if launchctl print "${domain}/${label}" >/dev/null 2>&1; then
        launchctl bootout "${domain}/${label}" 2>/dev/null || true
        for _ in {1..20}; do
            if ! launchctl print "${domain}/${label}" >/dev/null 2>&1; then
                break
            fi
            sleep 0.25
        done
    fi

    if launchctl print "${domain}/${label}" >/dev/null 2>&1; then
        echo "      ${label} is still registered after bootout; refusing duplicate bootstrap" >&2
        launchctl print "${domain}/${label}" >&2 || true
        return 5
    fi

    set +e
    bootstrap_output="$(launchctl bootstrap "$domain" "$plist" 2>&1)"
    bootstrap_status=$?
    set -e
    if [[ $bootstrap_status -ne 0 ]]; then
        printf '%s\n' "$bootstrap_output" >&2
        echo "      bootstrap failed for $plist; launchd state follows" >&2
        launchctl print "${domain}/${label}" >&2 || true
        return "$bootstrap_status"
    fi

    launchctl enable "${domain}/${label}"
    if [[ "${2:-}" == "on-demand" ]]; then
        echo "      loaded (on demand: launchctl kickstart ${domain}/${label})"
        return 0
    fi
    launchctl kickstart -k "${domain}/${label}"
    echo "      loaded"
}

remove_launch_agent() {
    local label="$1"
    local plist="${HOME}/Library/LaunchAgents/${label}.plist"

    echo "    ${label} (removed)"

    if launchctl print "${domain}/${label}" >/dev/null 2>&1; then
        launchctl bootout "${domain}/${label}" 2>/dev/null || true
    fi

    rm -f "$plist"
}

echo ":: [17] (re)loading macOS LaunchAgents"
mkdir -p "${HOME}/Library/Logs"

remove_launch_agent "com.signalridge.mcp-context7"
reload_launch_agent "com.signalridge.qmk-hid-host"
reload_launch_agent "com.signalridge.mcp-reaper"
{{ if .work -}}
# CLIProxyAPI never runs on work machines (.chezmoiignore skips its files);
# unload and delete any copy left from before.
remove_launch_agent "com.signalridge.cliproxyapi"
{{ else -}}
reload_launch_agent "com.signalridge.cliproxyapi"
{{ end -}}
{{ if eq (includeTemplate "sing-box/mode.tmpl" .) "agent" -}}
# Surge stays the default here, so load without starting (bootout above stops a
# running instance; start it again by hand after a config change).
mkdir -p "${HOME}/.local/state/sing-box"
reload_launch_agent "com.signalridge.sing-box" on-demand
{{ else -}}
remove_launch_agent "com.signalridge.sing-box"
{{ end -}}
{{ end -}}
