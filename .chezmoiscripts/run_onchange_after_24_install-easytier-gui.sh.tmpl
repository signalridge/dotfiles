{{- $suffix := "aarch64" -}}
{{- $sha256 := .versions.easytierGuiArm64Sha256 -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{-   $suffix = "x64" -}}
{{-   $sha256 = .versions.easytierGuiAmd64Sha256 -}}
{{- end -}}
#!/bin/bash

set -euo pipefail

echo ":: [24] Installing EasyTier GUI"

# EasyTier's macOS GUI is only ad-hoc (linker) signed: no Developer ID, not
# notarized, and every `codesign --verify` variant rejects the bundle. Unlike
# 09_install-paperlib, the trust anchor here is therefore the pinned DMG
# SHA-256 (GitHub release asset digest) plus bundle identity checks. curl does
# not set com.apple.quarantine, so Gatekeeper never prompts for this copy;
# installing it via this script is the explicit approval.
#
# The GUI's "service mode" installs a root LaunchDaemon that runs this bundle's
# binary; after an upgrade, restart that service from the GUI.
VERSION="{{ .versions.easytierGui }}"
REPO="EasyTier/EasyTier"
BUNDLE_ID="com.kkrainbow.easytier"
DMG_NAME="easytier-gui_${VERSION}_{{ $suffix }}.dmg"
DMG_URL="${EASYTIER_GUI_OVERRIDE_URL:-https://github.com/${REPO}/releases/download/v${VERSION}/${DMG_NAME}}"
EXPECTED_SHA256="${EASYTIER_GUI_OVERRIDE_SHA256:-{{ $sha256 }}}"
APPLICATIONS_DIR="${EASYTIER_GUI_APPLICATIONS_DIR:-/Applications}"
TEMP_DMG="$(mktemp "${TMPDIR:-/tmp}/easytier-gui.dmg.XXXXXX")"
VOLUME=""
INSTALL_TMP=""
BACKUP_ROOT=""
BACKUP_PATH=""
DESTINATION=""
NEW_INSTALLED=false
INSTALL_COMMITTED=false
cleanup() {
    if [[ -n "$VOLUME" ]]; then
        hdiutil detach "$VOLUME" -quiet 2>/dev/null || true
    fi
    rm -f "$TEMP_DMG"

    if [[ "$NEW_INSTALLED" == true && "$INSTALL_COMMITTED" != true && -n "$DESTINATION" ]]; then
        rm -rf "$DESTINATION" 2>/dev/null || true
    fi
    if [[ "$INSTALL_COMMITTED" != true && -n "$BACKUP_PATH" ]] &&
        [[ -e "$BACKUP_PATH" || -L "$BACKUP_PATH" ]]; then
        if [[ ! -e "$DESTINATION" && ! -L "$DESTINATION" ]] &&
            mv "$BACKUP_PATH" "$DESTINATION" 2>/dev/null; then
            BACKUP_PATH=""
        else
            echo "    CRITICAL: EasyTier GUI rollback could not complete; backup retained at $BACKUP_PATH" >&2
        fi
    fi

    [[ -z "$INSTALL_TMP" ]] || rm -rf "$INSTALL_TMP"
    if [[ -n "$BACKUP_ROOT" && -z "$BACKUP_PATH" ]]; then
        rm -rf "$BACKUP_ROOT"
    fi
}
trap cleanup EXIT

# Bundle identity is the only per-copy check available without a signature.
check_bundle() {
    local app="$1" plist="$1/Contents/Info.plist"
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$plist" 2>/dev/null)" == "$BUNDLE_ID" ]] &&
        [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist" 2>/dev/null)" == "$VERSION" ]] &&
        [[ -x "$app/Contents/MacOS/easytier-gui" ]]
}

if [[ ! "$EXPECTED_SHA256" =~ ^[0-9a-f]{64}$ ]]; then
    echo "    Invalid EasyTier GUI SHA-256" >&2
    exit 1
fi

if ! curl -fsSL "$DMG_URL" -o "$TEMP_DMG"; then
    echo "    Failed to download EasyTier GUI v${VERSION}" >&2
    exit 1
fi

actual_sha256="$(shasum -a 256 "$TEMP_DMG" | awk '{print $1}')"
if [[ "$actual_sha256" != "$EXPECTED_SHA256" ]]; then
    echo "    SHA-256 mismatch for $DMG_NAME" >&2
    exit 1
fi

# Defense in depth: reject an error page even if release metadata is miswired.
if ! file "$TEMP_DMG" | grep -q "zlib compressed"; then
    echo "    Downloaded file is not a valid DMG" >&2
    exit 1
fi

VOLUME="$(hdiutil attach -nobrowse -readonly "$TEMP_DMG" | awk -F '\t' '/\/Volumes\// && !found { print $NF; found=1 }')"
if [[ -z "$VOLUME" ]]; then
    echo "    Failed to locate mounted EasyTier GUI volume" >&2
    exit 1
fi
APP_PATH="$(find "$VOLUME" -maxdepth 1 -type d -name '*.app' -print -quit)"
if [[ -z "$APP_PATH" ]] || ! check_bundle "$APP_PATH"; then
    echo "    EasyTier GUI app ($BUNDLE_ID $VERSION) not found in mounted DMG" >&2
    exit 1
fi
APP_NAME="$(basename "$APP_PATH")"

if [[ ! -d "$APPLICATIONS_DIR" || -L "$APPLICATIONS_DIR" ]]; then
    echo "    Applications directory is missing or unsafe: $APPLICATIONS_DIR" >&2
    exit 1
fi
APPLICATIONS_DIR="$(cd -P -- "$APPLICATIONS_DIR" && pwd -P)"
INSTALL_TMP="$(mktemp -d "${APPLICATIONS_DIR}/.easytier-gui-install.XXXXXX")"
CANDIDATE_APP="${INSTALL_TMP}/${APP_NAME}"
ditto "$APP_PATH" "$CANDIDATE_APP"
if ! check_bundle "$CANDIDATE_APP"; then
    echo "    Copied EasyTier GUI app failed bundle checks" >&2
    exit 1
fi

# The candidate no longer depends on the mounted image.
hdiutil detach "$VOLUME" -quiet
VOLUME=""

DESTINATION="${APPLICATIONS_DIR}/${APP_NAME}"
if [[ -e "$DESTINATION" || -L "$DESTINATION" ]]; then
    BACKUP_ROOT="$(mktemp -d "${APPLICATIONS_DIR}/.easytier-gui-backup.XXXXXX")"
    BACKUP_PATH="${BACKUP_ROOT}/${APP_NAME}"
    if ! mv "$DESTINATION" "$BACKUP_PATH"; then
        echo "    Failed to stage the existing EasyTier GUI app for replacement" >&2
        exit 1
    fi
fi

if ! mv "$CANDIDATE_APP" "$DESTINATION"; then
    echo "    Failed to install the EasyTier GUI candidate" >&2
    exit 1
fi
NEW_INSTALLED=true

if ! check_bundle "$DESTINATION"; then
    echo "    Installed EasyTier GUI app failed bundle checks; rolling back" >&2
    exit 1
fi
INSTALL_COMMITTED=true

[[ -z "$BACKUP_ROOT" ]] || rm -rf "$BACKUP_ROOT"
BACKUP_ROOT=""
BACKUP_PATH=""
rm -rf "$INSTALL_TMP"
INSTALL_TMP=""

echo "    Installed $APP_NAME $VERSION to $APPLICATIONS_DIR"
