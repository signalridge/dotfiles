#!/bin/bash

set -euo pipefail

# (Re)load systemd --user units for the orphan reaper. Linux analog of the macOS
# LaunchAgent loader (13).
# Re-runs whenever any unit file changes (hashes below).
# reaper.service  sha256: {{ include "private_dot_config/systemd/user/mcp-reaper.service" | sha256sum }}
# reaper.timer    sha256: {{ include "private_dot_config/systemd/user/mcp-reaper.timer" | sha256sum }}
{{ if eq .chezmoi.os "linux" -}}
echo ":: [15] (re)loading systemd --user MCP units"

if ! command -v systemctl >/dev/null 2>&1; then
    echo "    systemctl not found, skipping"
    exit 0
fi

# Need a running user service manager (D-Bus) to talk to. Absent in minimal
# containers / non-systemd hosts — skip gracefully there.
if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "    no systemd --user instance available, skipping"
    exit 0
fi

# Keep the user manager alive after logout so the timer + daemon persist on a
# headless server (no graphical session pinning it).
if command -v loginctl >/dev/null 2>&1; then
    loginctl enable-linger "$(id -un)" >/dev/null 2>&1 || true
fi

systemctl --user daemon-reload

# The local Context7 HTTP daemon was replaced by the official hosted MCP
# endpoint. Stop any older user unit left behind by previous installs.
systemctl --user disable --now mcp-context7.service >/dev/null 2>&1 || true

# Orphan reaper: enable the timer (it pulls in the oneshot service on schedule).
systemctl --user enable --now mcp-reaper.timer
systemctl --user try-restart mcp-reaper.timer || true

echo "    enabled mcp-reaper.timer"
{{ end -}}
