#!/bin/bash

set -euo pipefail

# Reconcile pi extensions (npm: packages) to latest.
#
# Source of truth for WHICH packages is .chezmoidata/pi.yaml -> settings.json
# `packages` (written by dot_pi/agent/modify_settings.json.tmpl). pi itself
# auto-installs any missing registered package on startup; this script keeps the
# unversioned ones at latest. `pi update --extensions` updates unversioned
# `npm:` specs and reconciles pinned git refs; version-pinned specs are skipped.
# It writes only to ~/.pi/agent/npm/ (never settings.json), so there is no
# chezmoi conflict.
#
# CADENCE: this run_after script checks a last-success key made from the ISO week
# and package list. A failed update remains non-fatal to chezmoi apply but is
# retried on the next apply instead of being suppressed until the following week.
# This goes through bun/npm, NOT mise, so it is not subject to mise's release-age
# gate — unpinned extensions move directly to the newest published version.
{{- $week := output "date" "+%G-%V" | trim }}
{{ $packages := .pi.packages | toJson }}
update_key="{{ printf "%s:%s" $week $packages | sha256sum }}"

echo ":: [20] Updating pi extensions"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi"
state_file="$state_dir/pi-extensions-last-success"
last_success="$(cat "$state_file" 2>/dev/null || true)"
if [[ "$last_success" == "$update_key" ]]; then
    echo "    Skipped (extensions already reconciled for this week/package set)"
    exit 0
fi

# pi is mise-managed and the user strips mise shims at the zshenv phase, so this
# non-interactive shell has neither pi nor its node/bun runtime on PATH. Inject
# the real mise tool bin dirs via `mise env` (not `activate`, which needs a shell
# hook that never fires here), same idiom as the aqua updater.
aqua_bin_dir="${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}/bin"
# aqua is mise's backend for some tools, so `mise env` needs it discoverable.
# Both mise and aqua live in this dir; put it on PATH before invoking mise.
if [[ -d "$aqua_bin_dir" ]]; then
    export PATH="$aqua_bin_dir:$PATH"
fi
mise_bin="$aqua_bin_dir/mise"
if [[ ! -x "$mise_bin" ]]; then
    mise_bin="$(command -v mise 2>/dev/null || true)"
fi
if [[ -z "$mise_bin" ]]; then
    echo "    Skipped (mise not found)"
    exit 0
fi
eval "$("$mise_bin" env -s bash)"

if ! command -v pi >/dev/null 2>&1; then
    echo "    Skipped (pi not found; first pi launch will install extensions)"
    exit 0
fi

# Keep transient npm/network failures non-fatal, but only record successful
# reconciliation so the next apply retries a failure.
if pi update --extensions; then
    umask 077
    mkdir -p "$state_dir"
    tmp_state="$(mktemp "${state_file}.XXXXXX")"
    printf '%s\n' "$update_key" >"$tmp_state"
    mv "$tmp_state" "$state_file"
    echo "    pi extensions reconciled to latest"
else
    echo "    Warning: 'pi update --extensions' failed (non-fatal); next apply will retry" >&2
fi

# ---- Vendored fork upstream watch (advisory only; never updates anything) ----
#
# `pi update --extensions` only knows the `packages` list, so the VENDORED forks under
# ~/.pi/agent/extensions/ are the one pi component nothing can keep current — a rebase
# would clobber the local changes, so it stays a human decision. What this closes is the
# blind spot: it reports when an upstream publishes something new, once per release.
#
# Deliberately compares against the LAST SEEN upstream version, not the fork's own
# version (forks renumber themselves), so the first run just records a baseline
# silently and later runs speak up only when upstream actually moves.
fork_state="$state_dir/pi-vendored-upstream"
forks=(
{{- range .pi.vendoredForks }}
    {{ printf "%s|%s" .dir .upstream | quote }}
{{- end }}
)

if [[ ${#forks[@]} -gt 0 ]] && command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    fork_state_next=""
    for fork_entry in ${forks[@]+"${forks[@]}"}; do
        fork_dir="${fork_entry%%|*}"
        fork_pkg="${fork_entry#*|}"
        # Scoped names need the slash percent-encoded for the registry path.
        fork_latest="$(curl -fsS --max-time 10 \
            "https://registry.npmjs.org/${fork_pkg//\//%2F}/latest" 2>/dev/null |
            jq -r '.version // empty' 2>/dev/null || true)"
        # A lookup that failed (offline, rate limited, renamed package) carries its
        # previous baseline forward untouched rather than resetting it.
        if [[ -z "$fork_latest" ]]; then
            fork_prev_line="$(grep -F "$fork_pkg	" "$fork_state" 2>/dev/null || true)"
            [[ -n "$fork_prev_line" ]] && fork_state_next+="$fork_prev_line"$'\n'
            continue
        fi
        fork_seen="$(awk -F'\t' -v k="$fork_pkg" '$1 == k { print $2 }' "$fork_state" 2>/dev/null || true)"
        if [[ -n "$fork_seen" && "$fork_seen" != "$fork_latest" ]]; then
            echo "    Note: upstream $fork_pkg moved $fork_seen -> $fork_latest;" \
                "vendored fork dot_pi/agent/extensions/$fork_dir may need a rebase" >&2
        fi
        fork_state_next+="$fork_pkg	$fork_latest"$'\n'
    done
    if [[ -n "$fork_state_next" ]]; then
        umask 077
        mkdir -p "$state_dir"
        tmp_fork_state="$(mktemp "${fork_state}.XXXXXX")"
        printf '%s' "$fork_state_next" >"$tmp_fork_state"
        mv "$tmp_fork_state" "$fork_state"
    fi
fi
