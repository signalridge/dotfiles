#!/bin/bash

set -euo pipefail

# Reconcile every Pi package from npm. All of them — external infrastructure and
# the signalridge packages alike — are declared unpinned in settings.json, so
# `pi update --extensions` is what actually moves them to the latest release.
# Re-run weekly, or immediately whenever the declared package set changes.
{{- $week := output "date" "+%G-%V" | trim }}
{{- $externalPackages := .pi.packages | toJson }}
{{- $signalridgePackages := .pi.signalridgePackages | toJson }}
external_packages='{{ $externalPackages }}'
signalridge_packages='{{ $signalridgePackages }}'

sha256_stdin() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | awk '{print $1}'
        return
    fi
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | awk '{print $1}'
        return
    fi
    if command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 | awk '{print $NF}'
        return
    fi
    return 1
}

if ! update_key="$(printf '%s\0%s\0%s' '{{ $week }}' "$external_packages" "$signalridge_packages" | sha256_stdin)"; then
    echo "    Skipped (no SHA-256 tool available; need sha256sum, shasum, or openssl)"
    exit 0
fi

echo ":: [20] Updating pi extensions"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi"
state_file="$state_dir/pi-extensions-last-success"
last_success="$(cat "$state_file" 2>/dev/null || true)"
if [[ "$last_success" == "$update_key" ]]; then
    echo "    Skipped (extensions already reconciled for this week/package set)"
    exit 0
fi

# pi is mise-managed and the user strips mise shims at the zshenv phase, so this
# non-interactive shell has neither pi nor its node/bun runtime on PATH. Inject
# the real mise tool bin dirs via `mise env` (not `activate`, which needs a shell
# hook that never fires here), same idiom as the aqua updater.
aqua_bin_dir="${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}/bin"
if [[ -d "$aqua_bin_dir" ]]; then
    export PATH="$aqua_bin_dir:$PATH"
fi
mise_bin="$aqua_bin_dir/mise"
if [[ ! -x "$mise_bin" ]]; then
    mise_bin="$(command -v mise 2>/dev/null || true)"
fi
if [[ -z "$mise_bin" ]]; then
    echo "    Skipped (mise not found)"
    exit 0
fi
eval "$("$mise_bin" env -s bash)"

if ! command -v pi >/dev/null 2>&1; then
    echo "    Skipped (pi not found; first pi launch will install extensions)"
    exit 0
fi

# Keep transient npm/network failures non-fatal, but only record successful
# reconciliation so the next apply retries a failure.
if pi update --extensions; then
    umask 077
    mkdir -p "$state_dir"
    tmp_state="$(mktemp "${state_file}.XXXXXX")"
    printf '%s\n' "$update_key" >"$tmp_state"
    mv "$tmp_state" "$state_file"
    echo "    pi extensions reconciled to latest"
else
    echo "    Warning: 'pi update --extensions' failed (non-fatal); next apply will retry" >&2
fi
