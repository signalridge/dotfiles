#!/bin/bash
# Clone or verify the gopass store. The implementation lives in
# .bootstrap/setup-gopass-store.sh, shared with the read-source-state hook that
# clones the store on a fresh machine before chezmoi reads the source state;
# here it reruns when it or the store URL changes and verifies the store.
# implementation: {{ include ".bootstrap/setup-gopass-store.sh" | sha256sum }}
set -euo pipefail

# Prefer aqua's pinned gopass once it is installed (05).
{{ include ".chezmoitemplates/shell/source_aqua_env.sh" }}
export NIXPKGS_BOOTSTRAP_REV="{{ .versions.nixpkgsBootstrapRev }}"
exec bash "{{ .chezmoi.sourceDir }}/.bootstrap/setup-gopass-store.sh" {{ .gopassRepository | quote }}
