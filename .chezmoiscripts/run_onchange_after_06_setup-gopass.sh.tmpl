#!/bin/bash
# Setup gopass on new device
# Prerequisites: age encryption key already restored by 01_setup-encryption-key.sh
set -euo pipefail
{{- $gopassRepository := .gopassRepository -}}
{{- if hasPrefix "git@github.com:" $gopassRepository -}}
{{-   $gopassRepository = printf "https://github.com/%s" (trimPrefix "git@github.com:" $gopassRepository) -}}
{{- else if hasPrefix "ssh://git@github.com/" $gopassRepository -}}
{{-   $gopassRepository = printf "https://github.com/%s" (trimPrefix "ssh://git@github.com/" $gopassRepository) -}}
{{- end }}

# Ensure aqua-managed CLIs are discoverable for this non-interactive shell.
aqua_bin_dir="${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}/bin"
if [[ -d "$aqua_bin_dir" ]]; then
    export PATH="$aqua_bin_dir:$PATH"
fi

echo ":: [06] Setting up gopass password store"

# A valid store is a cloned git repo; a bare empty directory (for example,
# one left by a failed clone) must not count as initialized.
store_dir="$HOME/.local/share/gopass/stores/root"
if [[ -d "$store_dir" ]] && [[ ! -d "$store_dir/.git" ]] &&
    [[ -z "$(ls -A "$store_dir" 2>/dev/null)" ]]; then
    echo "⚠ Removing empty gopass store directory (not a valid store): $store_dir"
    rmdir "$store_dir"
fi

# The managed store always depends on this identity and on aqua's gopass.
if [[ ! -f "$HOME/.ssh/main" ]]; then
    echo "⚠ Age encryption key not found at ~/.ssh/main"
    echo "Please run: chezmoi apply"
    exit 1
fi
if ! command -v gopass &>/dev/null; then
    echo "⚠ gopass not installed"
    echo "Please run: chezmoi apply"
    exit 1
fi

verify_store() {
    local first_password

    if ! gopass ls >/dev/null 2>&1; then
        echo "✗ gopass cannot read the password store" >&2
        return 1
    fi

    first_password="$(gopass ls --flat 2>/dev/null | head -n 1 || true)"
    if [[ -n "$first_password" ]] && ! gopass show "$first_password" >/dev/null 2>&1; then
        echo "✗ gopass cannot decrypt '$first_password' with ~/.ssh/main" >&2
        return 1
    fi
}

if [[ -d "$store_dir/.git" ]]; then
    verify_store || exit 1
    echo "✓ gopass store already exists and is readable"
    exit 0
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Clone gopass password store from Git"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "This will clone your password store from:"
echo "  {{ $gopassRepository }}"
echo ""
echo "Note: ~/.config/gopass/config is already configured by chezmoi"
echo "      It points to ~/.ssh/main for age decryption"
echo ""

if ! read -r -p "Clone password store now? (yes/no): " confirm; then
    echo ""
    echo "Cancelled"
    exit 0
fi

if [[ "$confirm" != "yes" ]]; then
    echo ""
    echo "Skipped. You can clone later with:"
    printf '  gopass clone %s\n' {{ $gopassRepository | quote }}
    echo ""
    exit 0
fi

# Move age native identities out of the active config path if they exist.
# gopass is configured to use ~/.ssh/main, but existing identity material should
# never be deleted by bootstrap automation.
age_dir="$HOME/.config/gopass/age"
if [[ -d "$age_dir" ]]; then
    backup_dir="$HOME/.config/gopass/age.backup.$(date +%Y%m%d%H%M%S)"
    echo "Backing up age identities directory to: $backup_dir"
    mv "$age_dir" "$backup_dir"
    chmod 700 "$backup_dir" 2>/dev/null || true
fi

echo ""
echo "Cloning password store..."
# --check-keys=false: Don't generate new keys, use existing SSH key
gopass clone --check-keys=false {{ $gopassRepository | quote }}

echo ""
echo "✓ gopass password store cloned successfully"
echo ""

# Verify the clone before allowing run_onchange to record success.
echo "Verifying decryption..."
verify_store || exit 1
echo "✓ Store is readable (using SSH key: ~/.ssh/main)"

echo ""
echo "Verification commands:"
echo "  gopass ls                    # List all passwords"
echo "  gopass config | grep age     # Check age configuration"
echo "  ccm list                     # Test claude-manage integration"
echo ""
