#!/bin/sh
# shellcheck shell=dash
# Install Nix, or move it to the pinned version. The implementation lives in
# .bootstrap/install-nix.sh, shared with the read-source-state hook that installs
# Nix on a fresh machine before chezmoi reads the source state. This wrapper
# reruns whenever a pin or the implementation changes:
# implementation: {{ include ".bootstrap/install-nix.sh" | sha256sum }}
set -eu
NIX_INSTALLER_VERSION="${NIX_INSTALLER_VERSION:-{{ .versions.nixInstaller }}}"
NIX_VERSION="{{ .versions.nixVersion }}"
NIX_INSTALLER_SHA256_AARCH64_DARWIN="{{ .versions.nixInstallerAarch64DarwinSha256 }}"
NIX_INSTALLER_SHA256_AARCH64_LINUX="{{ .versions.nixInstallerAarch64LinuxSha256 }}"
NIX_INSTALLER_SHA256_X86_64_LINUX="{{ .versions.nixInstallerX8664LinuxSha256 }}"
export NIX_INSTALLER_VERSION NIX_VERSION NIX_INSTALLER_SHA256_AARCH64_DARWIN \
    NIX_INSTALLER_SHA256_AARCH64_LINUX NIX_INSTALLER_SHA256_X86_64_LINUX
exec sh "{{ .chezmoi.sourceDir }}/.bootstrap/install-nix.sh"
