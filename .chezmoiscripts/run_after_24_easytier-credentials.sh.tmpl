{{- if and (eq .chezmoi.os "darwin") (hasKey .easytier.nodes .hostname) -}}
#!/bin/bash

set -euo pipefail

# EasyTier credentials for the nix-darwin LaunchDaemon (nix-config/modules/
# easytier.nix). Source of truth is gopass; the daemon can only read a
# root-owned file, so this writes /etc/easytier/easytier.env (root:wheel 0600).
#
# Runs on every apply but only touches sudo when the gopass values changed
# since the last write (tracked by a hash in the user's state dir), so a
# rotation in gopass is rolled out on the next apply. On a fresh machine where
# gopass is not ready yet it skips; the daemon keeps refusing to start (and
# launchd keeps retrying) until the file exists. Delete the state file to force
# a rewrite.

echo ":: [24] EasyTier credentials"

ENV_DIR="/etc/easytier"
ENV_FILE="${ENV_DIR}/easytier.env"
LABEL="org.nixos.easytier"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi"
STATE="${STATE_DIR}/easytier-env.sha256"

if ! command -v gopass >/dev/null 2>&1; then
    echo "    Skipped (gopass not installed)"
    exit 0
fi
if ! name="$(gopass show -o easytier/network-name 2>/dev/null)" ||
    ! secret="$(gopass show -o easytier/network-secret 2>/dev/null)"; then
    echo "    Skipped (gopass easytier/network-name or network-secret unavailable)"
    exit 0
fi
# The daemon sources this file with sh, so only accept plain alphanumerics.
for value in "$name" "$secret"; do
    if [[ ! "$value" =~ ^[A-Za-z0-9]{32,}$ ]]; then
        echo "    EasyTier credentials in gopass must be >=32 alphanumeric characters" >&2
        exit 1
    fi
done

render() { printf 'ET_NETWORK_NAME=%s\nET_NETWORK_SECRET=%s\n' "$name" "$secret"; }
want="$(render | shasum -a 256 | cut -d' ' -f1)"
if [[ -f "$STATE" && "$(cat "$STATE")" == "$want" ]]; then
    echo "    Skipped (unchanged)"
    exit 0
fi

if ! sudo -v; then
    echo "    Skipped (sudo unavailable; rerun chezmoi apply interactively)" >&2
    exit 0
fi
sudo install -d -o root -g wheel -m 700 "$ENV_DIR"
# shellcheck disable=SC2016 # expanded by the root shell, not here
render | sudo /bin/sh -c 'umask 077
tmp="$(/usr/bin/mktemp "$1/.easytier.env.XXXXXX")"
/bin/cat >"$tmp"
/usr/sbin/chown root:wheel "$tmp"
/bin/chmod 600 "$tmp"
/bin/mv -f "$tmp" "$2"' sh "$ENV_DIR" "$ENV_FILE"

mkdir -p "$STATE_DIR"
printf '%s\n' "$want" >"$STATE"

if sudo launchctl print "system/${LABEL}" >/dev/null 2>&1; then
    sudo launchctl kickstart -k "system/${LABEL}"
    echo "    Wrote ${ENV_FILE}; restarted ${LABEL}"
else
    echo "    Wrote ${ENV_FILE} (${LABEL} not loaded yet; darwin-rebuild switch installs it)"
fi
{{- end }}
