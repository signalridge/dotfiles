#!/usr/bin/env bash
# Restore the files keys-manage backs up (~/.ssh/main, ...). The implementation
# lives in .bootstrap/restore-keys.sh, shared with the read-source-state hook
# that restores them on a fresh machine before chezmoi reads the source state;
# here it runs on every apply and is a fast no-op once everything is present.
set -euo pipefail
export NIXPKGS_BOOTSTRAP_REV="{{ .versions.nixpkgsBootstrapRev }}"
{{- if hasKey . "keysRepository" }}
export KEYS_REPO="${KEYS_REPO:-{{ .keysRepository }}}"
{{- end }}
exec bash "{{ .chezmoi.sourceDir }}/.bootstrap/restore-keys.sh"
