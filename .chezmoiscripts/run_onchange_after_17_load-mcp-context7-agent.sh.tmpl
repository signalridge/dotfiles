#!/bin/bash

set -euo pipefail

# (Re)load the shared context7 HTTP MCP daemon. Re-runs whenever the plist changes.
# plist sha256: {{ include "private_Library/LaunchAgents/com.signalridge.mcp-context7.plist.tmpl" | sha256sum }}
{{ if and (eq .chezmoi.os "darwin") (not .headless) -}}
label="com.signalridge.mcp-context7"
plist="${HOME}/Library/LaunchAgents/${label}.plist"
domain="gui/$(id -u)"

echo ":: [17] (re)loading ${label} LaunchAgent"

if [[ ! -f "$plist" ]]; then
    echo "    plist not found at $plist, skipping"
    exit 0
fi

mkdir -p "${HOME}/Library/Logs"

launchctl bootout "${domain}/${label}" 2>/dev/null || true
launchctl bootstrap "$domain" "$plist"
launchctl enable "${domain}/${label}"
launchctl kickstart -k "${domain}/${label}"
echo "    loaded ${label}"
{{ else -}}
echo ":: [17] context7 HTTP MCP daemon skipped (macOS GUI profile only)"
{{ end -}}
