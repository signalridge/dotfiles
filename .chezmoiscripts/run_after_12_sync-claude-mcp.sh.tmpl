#!/bin/bash

set -euo pipefail

# Sync Claude Code MCP servers on every chezmoi apply.
# Fast path: only add when missing, avoid remove+add churn.

echo ":: [12] Syncing Claude Code MCP servers"

# Ensure common install locations are discoverable in non-interactive shells.
PATH="$HOME/.nix-profile/bin:/opt/homebrew/bin:$HOME/.local/share/aquaproj-aqua/bin:$PATH"
# aqua shims need AQUA_GLOBAL_CONFIG too (code 004 on a fresh machine).
{{ include ".chezmoitemplates/shell/source_aqua_env.sh" }}
claude_cmd="$(command -v claude 2>/dev/null || true)"

if [[ -z "$claude_cmd" ]]; then
    echo "    Skipped (claude not found)"
    exit 0
fi

if ! command -v jq &>/dev/null; then
    echo "    Skipped (jq not found)"
    exit 0
fi

CLAUDE_JSON="$HOME/.claude.json"

check_user_mcp_json() {
    local name="$1"
    local expected_json="$2"

    if [[ ! -f "$CLAUDE_JSON" ]]; then
        echo "missing"
        return 0
    fi

    local server
    server="$(jq -e --arg n "$name" '.mcpServers[$n]' "$CLAUDE_JSON" 2>/dev/null)" || {
        echo "missing"
        return 0
    }

    local actual_cmp expected_cmp actual_type
    actual_cmp="$(jq -cS '{command, args: (.args // []), env: (.env // {})}' <<<"$server")"
    expected_cmp="$(jq -cS '{command, args: (.args // []), env: (.env // {})}' <<<"$expected_json")"
    actual_type="$(jq -r '.type // "stdio"' <<<"$server")"

    if [[ "$actual_type" == "stdio" && "$actual_cmp" == "$expected_cmp" ]]; then
        echo "match"
    else
        echo "mismatch"
    fi
}

check_user_mcp_http() {
    local name="$1"
    local expected_url="$2"

    if [[ ! -f "$CLAUDE_JSON" ]]; then
        echo "missing"
        return 0
    fi

    local server
    server="$(jq -e --arg n "$name" '.mcpServers[$n]' "$CLAUDE_JSON" 2>/dev/null)" || {
        echo "missing"
        return 0
    }

    local actual_type actual_url
    actual_type="$(jq -r '.type // "stdio"' <<<"$server")"
    actual_url="$(jq -r '.url // empty' <<<"$server")"

    if [[ "$actual_type" == "http" && "$actual_url" == "$expected_url" ]]; then
        echo "match"
    else
        echo "mismatch"
    fi
}

ensure_user_mcp_json() {
    local name="$1"
    local json="$2"

    local status
    status="$(check_user_mcp_json "$name" "$json")"

    case "$status" in
    match)
        echo "    Exists: $name"
        ;;
    missing)
        "$claude_cmd" mcp add-json -s user "$name" "$json"
        ;;
    mismatch)
        echo "    Updating: $name"
        "$claude_cmd" mcp remove -s user "$name" >/dev/null 2>&1 || true
        "$claude_cmd" mcp add-json -s user "$name" "$json"
        ;;
    *)
        echo "    Skipped: $name (unknown check status: $status)"
        ;;
    esac
}

ensure_user_mcp_http() {
    local name="$1"
    local url="$2"

    local status
    status="$(check_user_mcp_http "$name" "$url")"

    case "$status" in
    match)
        echo "    Exists: $name"
        ;;
    missing)
        "$claude_cmd" mcp add --transport http -s user "$name" "$url"
        ;;
    mismatch)
        echo "    Updating: $name"
        "$claude_cmd" mcp remove -s user "$name" >/dev/null 2>&1 || true
        "$claude_cmd" mcp add --transport http -s user "$name" "$url"
        ;;
    *)
        echo "    Skipped: $name (unknown check status: $status)"
        ;;
    esac
}

# Pin a server as always-loaded so Claude Code never defers its tools behind the
# Tool Search / ToolSearch step (schemas load at session start regardless of the
# ENABLE_TOOL_SEARCH budget). Patches ~/.claude.json in place via jq — works for
# both stdio and http servers and retrofits entries added by a prior run (the
# ensure_* match-checks above ignore alwaysLoad, so this is the sole owner of it).
ensure_always_load() {
    local name="$1"

    if [[ ! -f "$CLAUDE_JSON" ]] || ! jq -e --arg n "$name" '.mcpServers[$n]' "$CLAUDE_JSON" >/dev/null 2>&1; then
        echo "    alwaysLoad skip: $name (not registered)"
        return 0
    fi

    if [[ "$(jq -r --arg n "$name" '.mcpServers[$n].alwaysLoad // false' "$CLAUDE_JSON")" == "true" ]]; then
        echo "    alwaysLoad set: $name"
        return 0
    fi

    local tmp
    tmp="$(mktemp)"
    if jq --arg n "$name" '.mcpServers[$n].alwaysLoad = true' "$CLAUDE_JSON" >"$tmp"; then
        mv "$tmp" "$CLAUDE_JSON"
        echo "    alwaysLoad add: $name"
    else
        rm -f "$tmp"
        echo "    alwaysLoad FAILED: $name" >&2
        return 1
    fi
}

# Reconcile only the MCP servers owned by this repository (.chezmoidata/mcp.yaml,
# harness key "claude"). User-added servers (including Slack, Notion, and
# project-specific tools) are never deleted.
{{- $harness := "claude" -}}
{{- $servers := list -}}
{{- range .mcp.servers -}}
{{-   $on := true -}}
{{-   if hasKey . "only" -}}{{- $on = has $harness .only -}}{{- end -}}
{{-   if hasKey . "exclude" -}}{{- if has $harness .exclude -}}{{- $on = false -}}{{- end -}}{{- end -}}
{{-   if $on -}}{{- $servers = append $servers . -}}{{- end -}}
{{- end }}
{{  range $servers -}}
{{-   if hasKey . "url" -}}
ensure_user_mcp_http "{{ .name }}" "{{ .url }}"
{{    else -}}
{{-     $cmd := .command -}}
{{-     if hasPrefix "~/" $cmd -}}{{- $cmd = printf "%s/%s" $.chezmoi.homeDir (trimPrefix "~/" $cmd) -}}{{- end -}}
ensure_user_mcp_json "{{ .name }}" '{"command":{{ $cmd | toJson }},"args":{{ .args | toJson }}}'
{{    end -}}
{{- end }}
# Pin high-value servers (`claude.alwaysLoad`) so their tools are always in
# context (never deferred); the rest stay deferrable behind ToolSearch.
{{  range $servers -}}
{{-   if and (hasKey . "claude") (hasKey .claude "alwaysLoad") -}}
{{-     if .claude.alwaysLoad -}}
ensure_always_load "{{ .name }}"
{{      end -}}
{{-   end -}}
{{- end -}}
