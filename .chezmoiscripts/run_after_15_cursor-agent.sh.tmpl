#!/bin/bash

set -euo pipefail

# Cursor Agent CLI — installed from Cursor's official download service, not
# Homebrew, so the same managed path works on macOS and Linux. Version and
# per-platform archive hashes are updated from the latest installer metadata by
# the version-update workflow; apply only executes repository-pinned bytes.

echo ":: [15] Installing Cursor Agent CLI"

case "$(uname -s)" in
Darwin) os="darwin" ;;
Linux) os="linux" ;;
*)
    echo "    Skipped (unsupported OS: $(uname -s))"
    exit 0
    ;;
esac

case "$(uname -m)" in
x86_64 | amd64) arch="x64" ;;
arm64 | aarch64) arch="arm64" ;;
*)
    echo "    Skipped (unsupported architecture: $(uname -m))"
    exit 0
    ;;
esac

version="${CURSOR_AGENT_OVERRIDE_VERSION:-{{ .versions.cursorAgentVersion }}}"
case "${os}-${arch}" in
darwin-arm64) expected_sha256="{{ .versions.cursorAgentDarwinArm64Sha256 }}" ;;
darwin-x64) expected_sha256="{{ .versions.cursorAgentDarwinX64Sha256 }}" ;;
linux-arm64) expected_sha256="{{ .versions.cursorAgentLinuxArm64Sha256 }}" ;;
linux-x64) expected_sha256="{{ .versions.cursorAgentLinuxX64Sha256 }}" ;;
*)
    echo "    Error: missing Cursor Agent checksum for ${os}/${arch}" >&2
    exit 1
    ;;
esac
expected_sha256="${CURSOR_AGENT_OVERRIDE_SHA256:-$expected_sha256}"

if ! command -v curl >/dev/null 2>&1; then
    echo "    Error: curl is required to install Cursor Agent CLI" >&2
    exit 1
fi

if ! command -v tar >/dev/null 2>&1; then
    echo "    Error: tar is required to install Cursor Agent CLI" >&2
    exit 1
fi

bin_dir="$HOME/.local/bin"
agent_link="${bin_dir}/agent"
cursor_agent_link="${bin_dir}/cursor-agent"

# The version ultimately originates in remote metadata and later becomes an
# rm -rf target. Fail closed if the update workflow's expected format changes.
version_re='^[0-9]{4}\.(0[1-9]|1[0-2])\.(0[1-9]|[12][0-9]|3[01])-[0-9a-f]{7}$'
if [[ ! "$version" =~ $version_re ]]; then
    echo "    Error: invalid Cursor Agent version: $version" >&2
    exit 1
fi
if [[ ! "$expected_sha256" =~ ^[0-9a-f]{64}$ ]]; then
    echo "    Error: invalid Cursor Agent SHA-256 for ${os}/${arch}" >&2
    exit 1
fi

download_url="${CURSOR_AGENT_OVERRIDE_URL:-https://downloads.cursor.com/lab/${version}/${os}/${arch}/agent-cli-package.tar.gz}"
install_root="${XDG_DATA_HOME:-$HOME/.local/share}/cursor-agent/versions"

mkdir -p "$install_root" "$bin_dir"
install_root="$(cd "$install_root" && pwd -P)"
target_dir="${install_root}/${version}"
archive_hash_file="${target_dir}/.archive.sha256"
if [[ "${target_dir%/*}" != "$install_root" || -L "$target_dir" ]]; then
    echo "    Error: unsafe Cursor Agent target directory: $target_dir" >&2
    exit 1
fi

fix_macos_quarantine() {
    [[ "$os" == "darwin" ]] || return 0

    # Cursor ships signed native .node modules. Some macOS/MDM setups tag freshly
    # downloaded files with com.apple.quarantine, which can make cursor-agent fail
    # during dlopen with "library load disallowed by system policy".
    if command -v xattr >/dev/null 2>&1; then
        xattr -dr com.apple.quarantine "$1" 2>/dev/null || true
    fi
}

ensure_links() {
    ln -sfn "${target_dir}/cursor-agent" "$agent_link"
    ln -sfn "${target_dir}/cursor-agent" "$cursor_agent_link"
}

if [[ -x "${target_dir}/cursor-agent" ]] &&
    [[ "$(cat "$archive_hash_file" 2>/dev/null || true)" == "$expected_sha256" ]]; then
    fix_macos_quarantine "$target_dir"
    ensure_links
    echo "    Already installed (${version})"
    exit 0
fi

echo "    Downloading ${os}/${arch} ${version}"

tmp_tgz=""
tmp_dir=""
cleanup() {
    [[ -z "$tmp_tgz" ]] || rm -f "$tmp_tgz"
    [[ -z "$tmp_dir" ]] || rm -rf "$tmp_dir"
}
trap cleanup EXIT

tmp_tgz="$(mktemp "${TMPDIR:-/tmp}/cursor-agent.tar.gz.XXXXXX")"
tmp_dir="$(mktemp -d "${install_root}/.tmp-${version}.XXXXXX")"

if ! curl -fL --retry 5 --retry-delay 2 -o "$tmp_tgz" "$download_url"; then
    echo "    Error: download failed (${download_url})" >&2
    exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
    actual_sha256="$(sha256sum "$tmp_tgz" | awk '{print $1}')"
elif command -v shasum >/dev/null 2>&1; then
    actual_sha256="$(shasum -a 256 "$tmp_tgz" | awk '{print $1}')"
else
    echo "    Error: sha256sum or shasum is required" >&2
    exit 1
fi
if [[ "$actual_sha256" != "$expected_sha256" ]]; then
    echo "    Error: SHA-256 mismatch for Cursor Agent ${os}/${arch} ${version}" >&2
    exit 1
fi

tar --strip-components=1 -xzf "$tmp_tgz" -C "$tmp_dir"
rm -f "$tmp_tgz"
tmp_tgz=""

candidate="${tmp_dir}/cursor-agent"
if [[ ! -f "$candidate" || -L "$candidate" ]]; then
    echo "    Error: archive does not contain a regular cursor-agent executable" >&2
    exit 1
fi
chmod +x "$candidate"
fix_macos_quarantine "$tmp_dir"
if ! "$candidate" --version >/dev/null 2>&1; then
    echo "    Error: downloaded cursor-agent failed smoke test" >&2
    exit 1
fi
printf '%s\n' "$expected_sha256" >"${tmp_dir}/.archive.sha256"

# Replace only after the candidate has executed successfully.
rm -rf "$target_dir"
mv "$tmp_dir" "$target_dir"
tmp_dir=""
ensure_links

# Prune older script-installed versions. The runtime config/state lives outside
# versions/, under ~/.cursor and ~/.local/share/cursor-agent.
find "$install_root" -mindepth 1 -maxdepth 1 -type d ! -name "$version" -exec rm -rf {} + 2>/dev/null || true

echo "    Installed cursor-agent ${version} -> ${cursor_agent_link}"
