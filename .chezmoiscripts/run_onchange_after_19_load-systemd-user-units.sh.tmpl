#!/bin/bash

set -euo pipefail

# (Re)load systemd --user units for the orphan reaper. Linux analog of the macOS
# LaunchAgent loader (17).
# Re-runs whenever any unit file changes (hashes below).
# reaper.service  sha256: {{ include "private_dot_config/systemd/user/mcp-reaper.service" | sha256sum }}
# reaper.timer    sha256: {{ include "private_dot_config/systemd/user/mcp-reaper.timer" | sha256sum }}
# ss-exit unit   sha256: {{ includeTemplate "private_dot_config/systemd/user/ss-exit.service.tmpl" . | sha256sum }}
# ss-exit config sha256: {{ includeTemplate "private_dot_config/private_ss-exit/config.json.tmpl" . | sha256sum }}
# ss-exit acl    sha256: {{ includeTemplate "private_dot_config/private_ss-exit/acl.list.tmpl" . | sha256sum }}
# ss-exit env    sha256: {{ includeTemplate "private_dot_config/private_ss-exit/private_env.tmpl" . | sha256sum }}
# sing-box unit   sha256: {{ includeTemplate "private_dot_config/systemd/user/sing-box.service.tmpl" . | sha256sum }}
# sing-box config sha256: {{ includeTemplate "private_dot_config/private_sing-box/private_config.json.tmpl" . | sha256sum }}
{{ if eq .chezmoi.os "linux" -}}
echo ":: [19] (re)loading systemd --user MCP units"

if ! command -v systemctl >/dev/null 2>&1; then
    echo "    systemctl not found, skipping"
    exit 0
fi

# Need a running user service manager (D-Bus) to talk to. Absent in minimal
# containers / non-systemd hosts — skip gracefully there.
if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "    no systemd --user instance available, skipping"
    exit 0
fi

# Keep the user manager alive after logout so the timer + daemon persist on a
# headless server (no graphical session pinning it).
if command -v loginctl >/dev/null 2>&1; then
    loginctl enable-linger "$(id -un)" >/dev/null 2>&1 || true
fi

systemctl --user daemon-reload

# The local Context7 HTTP daemon was replaced by the official hosted MCP
# endpoint. Stop any older user unit left behind by previous installs.
systemctl --user disable --now mcp-context7.service >/dev/null 2>&1 || true

# Orphan reaper: enable the timer (it pulls in the oneshot service on schedule).
systemctl --user enable --now mcp-reaper.timer
systemctl --user try-restart mcp-reaper.timer || true

# EasyTier exit (shadowsocks-rust): present only on Linux exits (`easytierExit`).
if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/ss-exit.service" ]]; then
    systemctl --user daemon-reload
    systemctl --user enable --now ss-exit.service
    systemctl --user try-restart ss-exit.service || true
fi

# sing-box proxy client: present only on headless Linux with the gopass keys.
if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/sing-box.service" ]]; then
    systemctl --user daemon-reload
    systemctl --user enable --now sing-box.service
    systemctl --user try-restart sing-box.service || true
fi

echo "    enabled mcp-reaper.timer"
{{ end -}}
