{{- if eq (includeTemplate "sing-box/mode.tmpl" .) "system" -}}
#!/bin/bash

set -euo pipefail

# sing-box on every Mac (mode "system", .chezmoitemplates/sing-box/mode.tmpl):
# writes /etc/sing-box/config.json
# (root:wheel 0600) for the LaunchDaemon from nix-config/modules/sing-box.nix,
# then restarts it. The config embeds two gopass values, so it is built here at
# run time rather than rendered into the store or $HOME:
#   easytier/exit-ss-password    Shadowsocks 2022 key of the EasyTier exits
#   sing-box/clash-api-secret    Bearer secret of the web panel / Clash API
#   sing-box/bastion-outbounds   optional bastion outbounds (bastion-import)
#   easytier/bastion-host        the bastion's public IPv4, dialled by its outbounds
#   sing-box/ssh-tunnel          optional, work Macs: `ssh -D` outbound (JSON)
#   sing-box/ssh-tunnel-key      its private key (stored with `gopass cat`)
# Runs on every apply; sudo only when the rendered config changed (tracked by
# hash, since the file is root-only) or the daemon is not running.
#
# Like a Tailscale exit node: a TUN with auto_route carries every app's traffic
# and DNS (no system proxy; lookups go over DoH through the same exit); the `Egress` selector defaults to
# direct. Pick the exit in the panel: http://127.0.0.1:{{ .singBox.clashApiPort }}/ui (secret above).

echo ":: [25] sing-box"

CONFIG_DIR="/etc/sing-box"
CONFIG="${CONFIG_DIR}/config.json"
LABEL="org.nixos.sing-box"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi"
STATE="${STATE_DIR}/sing-box-config.sha256"

if ! command -v gopass >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    echo "    Skipped (gopass or jq not installed)"
    exit 0
fi
if ! ss_password="$(gopass show -o easytier/exit-ss-password 2>/dev/null)" ||
    ! secret="$(gopass show -o sing-box/clash-api-secret 2>/dev/null)"; then
    echo "    Skipped (gopass easytier/exit-ss-password or sing-box/clash-api-secret unavailable)"
    exit 0
fi
# Optional bastion outbounds (bastion-import): "[]" when absent; anything else
# but the three tagged outbounds stops the apply rather than half-configuring.
bastion_outbounds="$(gopass show -o sing-box/bastion-outbounds 2>/dev/null || echo '[]')"
jq -e 'type == "array" and (length == 0 or (map(.tag) | sort) == ["AnyTLS", "Hysteria2", "Reality"])' \
    <<<"$bastion_outbounds" >/dev/null || { echo "    gopass sing-box/bastion-outbounds is malformed; re-run bastion-import" >&2; exit 1; }
# The bastion outbounds dial its public IPv4 instead of its domain (TLS still
# names the domain), so reaching the bastion needs no DNS at all. Kept in gopass
# (public repo); dropped when absent or not an IPv4 literal. The address is NOT
# kept off the TUN: EasyTier's STUN to the bastion must take the same path as
# its hole punching (through sing-box, endpoint-independent UDP mapping), or the
# punched ports never match and nas/gpuserver stay relayed via the bastion.
# Inside sing-box it always routes Direct (SSH to it, EasyTier's TCP link):
# the bastion refuses connections to itself, so it must never ride Egress.
bastion_ip="$(gopass show -o easytier/bastion-host 2>/dev/null || true)"
[[ "$bastion_ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || bastion_ip=""
# Optional SSH tunnel on work Macs (singBox.sshTunnelPort, `ssh -D` without
# ssh): the outbound as one-line JSON (tag, server, server_port, user,
# host_key) and its private key. `gopass cat` inserts from stdin unless it is
# closed. Both reach jq through its environment, never its command line.
ssh_tunnel=""
ssh_tunnel_key=""
{{- $store := joinPath .chezmoi.homeDir ".local/share/gopass/stores/root" }}
{{- $hasTunnel := and (dig "work" false .) (stat (joinPath $store "sing-box/ssh-tunnel.age")) (stat (joinPath $store "sing-box/ssh-tunnel-key.age")) }}
{{- if $hasTunnel }}
if ! ssh_tunnel="$(gopass show -o sing-box/ssh-tunnel 2>/dev/null)" ||
    ! ssh_tunnel_key="$(gopass cat sing-box/ssh-tunnel-key </dev/null 2>/dev/null)"; then
    echo "    gopass sing-box/ssh-tunnel or sing-box/ssh-tunnel-key unreadable" >&2
    exit 1
fi
jq -e 'type == "object" and (.tag | type == "string") and (.server | type == "string") and (.host_key | type == "array" and length > 0)' \
    <<<"$ssh_tunnel" >/dev/null || { echo "    gopass sing-box/ssh-tunnel is malformed" >&2; exit 1; }
{{- end }}

# Structure from .chezmoitemplates/sing-box/config.tmpl (shared with the
# LaunchAgent / systemd variants); the secrets, the bastion outbounds and its
# address are placeholders here and are filled in by jq at run time so they
# never enter the rendered script.
render_config() {
    SSH_TUNNEL="$ssh_tunnel" SSH_TUNNEL_KEY="$ssh_tunnel_key" jq --arg password "$ss_password" --arg secret "$secret" \
        --argjson bastion_outbounds "$bastion_outbounds" --arg bastion_ip "$bastion_ip" '
      walk(if . == "__EXIT_SS_PASSWORD__" then $password
           elif . == "__CLASH_API_SECRET__" then $secret else . end)
      | .outbounds |= map(if . == "__BASTION_OUTBOUNDS__" then $bastion_outbounds[] else . end)
      | if (env.SSH_TUNNEL // "") == "" then . else
          ((env.SSH_TUNNEL | fromjson) + {type: "ssh", private_key: env.SSH_TUNNEL_KEY}) as $tunnel
          | .outbounds |= map(if . == "__SSH_TUNNEL__" then $tunnel else . end)
          | (.route.rules[] | select(.outbound == "__SSH_TUNNEL__") | .outbound) = $tunnel.tag
        end
      | (.outbounds[] | select($bastion_ip != "" and (.tag | IN("Reality", "Hysteria2", "AnyTLS"))) | .server) = $bastion_ip
      | (.route.rules[] | select(.ip_cidr != null and (.ip_cidr | index("__BASTION_DIRECT__")) != null) | .ip_cidr) |=
          (map(select(. != "__BASTION_DIRECT__")) + (if $bastion_ip == "" then [] else [$bastion_ip + "/32"] end))' <<'JSON'
{{- $hasBastion := stat (joinPath .chezmoi.homeDir ".local/share/gopass/stores/root/sing-box/bastion-outbounds.age") }}
{{ includeTemplate "sing-box/config.tmpl" (dict "root" . "password" "__EXIT_SS_PASSWORD__" "secret" "__CLASH_API_SECRET__" "tun" true "directCidr" (list "__BASTION_DIRECT__") "bastion" (ternary "__BASTION_OUTBOUNDS__" "" (not (not $hasBastion))) "sshTunnel" (not (not $hasTunnel))) }}
JSON
}

config="$(render_config)"
want="$(printf '%s\n' "$config" | shasum -a 256 | cut -d' ' -f1)"
changed=true
[[ -f "$STATE" && "$(cat "$STATE")" == "$want" ]] && changed=false
running=true
pgrep -qf 'sing-box run -c /var/run/sing-box/config.json' || running=false

if [[ "$changed" == false && "$running" == true ]]; then
    echo "    Unchanged"
    exit 0
fi
if ! command -v sing-box >/dev/null 2>&1; then
    echo "    Skipped (sing-box not installed yet; darwin-rebuild switch installs it)"
    exit 0
fi
check_dir="$(mktemp -d)"
trap 'rm -f "${check_dir}/config.json"; rmdir "$check_dir"' EXIT
(umask 077 && printf '%s\n' "$config" >"${check_dir}/config.json")
sing-box check -c "${check_dir}/config.json"
if ! sudo -v; then
    echo "    Skipped (sudo unavailable; rerun chezmoi apply interactively)" >&2
    exit 0
fi

if [[ "$changed" == true ]]; then
    sudo install -d -o root -g wheel -m 700 "$CONFIG_DIR"
    # shellcheck disable=SC2016 # expanded by the root shell, not here
    printf '%s\n' "$config" | sudo /bin/sh -c 'umask 077
tmp="$(mktemp "$1/.config.json.XXXXXX")"
cat >"$tmp"
chown root:wheel "$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$2"' sh "$CONFIG_DIR" "$CONFIG"
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$want" >"$STATE"
    echo "    Wrote ${CONFIG}"
fi
if sudo launchctl print "system/${LABEL}" >/dev/null 2>&1; then
    sudo launchctl kickstart -k "system/${LABEL}"
    echo "    Restarted ${LABEL}"
else
    echo "    ${LABEL} not loaded yet; darwin-rebuild switch installs it"
fi
{{- end }}
