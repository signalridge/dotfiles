#!/bin/bash
# darwin-only: excluded on linux via .chezmoiignore

set -euo pipefail

# Hash rendered source state, not the pre-apply target files in $HOME. This
# makes run_onchange converge in the same apply that changes the configuration.
# flake.nix: {{ includeTemplate "nix-config/flake.nix.tmpl" . | sha256sum }}
# flake.lock: {{ includeTemplate "nix-config/flake.lock.tmpl" . | sha256sum }}
# apps.nix: {{ includeTemplate "nix-config/modules/apps.nix.tmpl" . | sha256sum }}
# system.nix: {{ includeTemplate "nix-config/modules/system.nix.tmpl" . | sha256sum }}
# host-users.nix: {{ include "nix-config/modules/host-users.nix" | sha256sum }}

echo ":: [02] Configuring nix-darwin"

# Source nix environment if not already available
{{ include ".chezmoitemplates/shell/source_nix_env.sh" }}
if ! command -v darwin-version >/dev/null 2>&1; then
    echo "    Installing nix-darwin..."
    sudo nix run ~/nix-config#darwin-rebuild -- switch --flake ~/nix-config#{{ .hostname }} --show-trace --verbose
else
    echo "    Switching nix-darwin configuration..."
    sudo darwin-rebuild switch --flake ~/nix-config#{{ .hostname }} --show-trace --verbose
fi
