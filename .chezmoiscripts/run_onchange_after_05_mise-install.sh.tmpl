#!/bin/bash

set -euo pipefail

{{ $miseConfig := joinPath .chezmoi.homeDir ".config/mise/config.toml" -}}
{{- $sha256 := "if command -v sha256sum >/dev/null 2>&1; then sha256sum \"$1\" | awk '{print $1}'; elif command -v shasum >/dev/null 2>&1; then shasum -a 256 \"$1\" | awk '{print $1}'; elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 \"$1\" | awk '{print $NF}'; else echo no-sha256; fi" -}}
# mise config: {{ if stat $miseConfig }}{{ output "sh" "-c" $sha256 "_" $miseConfig | trim }}{{ else }}n/a{{ end }}

echo ":: [05] Installing mise tools"

if command -v mise &>/dev/null; then
    mise install --yes
else
    echo "    Skipped (mise not found)"
fi
