{{- /*
  ~/.kimi-code/mcp.json — user-global MCP servers for Kimi Code (K3).

  Kimi loads MCP declarations from three files and merges them, later files
  overriding earlier ones (verified in the kimi-code binary):
    1. user-global   ~/.kimi-code/mcp.json   ← THIS file (lowest precedence)
    2. project-root  <repo>/.mcp.json         (Claude-compatible, per-repo)
    3. project-local <cwd>/.kimi-code/mcp.json (highest precedence)
  So this file is the shared default set; a repo can still override any entry.

  Same functional set as the other harnesses (claude/codex/pi/cursor). Kimi's
  schema is a discriminatedUnion on "transport" with a preprocessor that infers
  it: a bare "url" → http, a bare "command" → stdio, so no explicit type is
  needed (same shape as ~/.cursor/mcp.json). stdio servers reuse the shared
  ~/.local/bin/mcp-* wrappers or uvx/uv; remote servers use "url". The pi-only
  "lifecycle"/"directTools" fields are omitted — Kimi has no such lifecycle.
  Managed by chezmoi (dot_kimi-code/mcp.json.tmpl).
  The server list lives in .chezmoidata/mcp.yaml (harness key "kimi").
*/ -}}
{{- $harness := "kimi" -}}
{{- $servers := list -}}
{{- range .mcp.servers -}}
{{-   $on := true -}}
{{-   if hasKey . "only" -}}{{- $on = has $harness .only -}}{{- end -}}
{{-   if hasKey . "exclude" -}}{{- if has $harness .exclude -}}{{- $on = false -}}{{- end -}}{{- end -}}
{{-   if $on -}}{{- $servers = append $servers . -}}{{- end -}}
{{- end -}}
{
  "mcpServers": {
{{- range $i, $s := $servers }}
    {{ $s.name | toJson }}: {
{{-   if hasKey $s "url" }}
      "url": {{ $s.url | toJson }}
{{-   else }}
{{-     $cmd := $s.command -}}
{{-     if hasPrefix "~/" $cmd -}}{{- $cmd = printf "%s/%s" $.chezmoi.homeDir (trimPrefix "~/" $cmd) -}}{{- end }}
      "command": {{ $cmd | toJson }},
      "args": [{{ range $j, $a := $s.args }}{{ if $j }}, {{ end }}{{ $a | toJson }}{{ end }}]
{{-   end }}
    }{{ if lt (add1 $i) (len $servers) }},{{ end }}
{{- end }}
  }
}
