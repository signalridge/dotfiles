#!/usr/bin/env bash
# chezmoi modify_ script: merge managed Cursor CLI settings into
# ~/.cursor/cli-config.json, preserving the internal/cached state that Cursor
# writes and owns (authInfo, model/selectedModel/modelParameters, version,
# privacyCache, showSandboxIntro, ...). Managed keys (permissions, approvalMode,
# editor.vimMode, display) always win on re-apply.
#
# Mirrors the Codex (modify_config.toml) / pi (modify_settings.json) pattern:
# the shared MCP set lives in ~/.cursor/mcp.json; this file owns the CLI posture.
# Posture: unrestricted/yolo — Cursor's persistent equivalent of --yolo.
# The managed allow list is intentionally broad and the deny list is empty;
# switch model at runtime via the CLI's model picker (never here).
set -euo pipefail

EXISTING="$(cat)"

# Fallbacks only fill the documented required fields when the file is new; they
# never override anything Cursor already wrote.
FALLBACK="$(cat <<'CURSOR_FALLBACK_EOF'
{
  "version": 1,
  "editor": { "vimMode": false },
  "permissions": { "allow": [], "deny": [] }
}
CURSOR_FALLBACK_EOF
)"

# Managed posture — these win over both fallback and existing.
MANAGED="$(cat <<'CURSOR_MANAGED_EOF'
{
  "editor": { "vimMode": false },
  "approvalMode": "unrestricted",
  "display": {
    "showLineNumbers": false,
    "showThinkingBlocks": true,
    "showStatusIndicators": true
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Shell(*)",
      "Mcp(*:*)",
      "WebFetch(*)"
    ],
    "deny": []
  }
}
CURSOR_MANAGED_EOF
)"

if command -v jq >/dev/null 2>&1 && printf '%s' "$EXISTING" | jq -e . >/dev/null 2>&1; then
    # Deep-merge: fallback (required-field seed) < existing (internal state) <
    # managed (posture always wins). Arrays in managed replace existing ones.
    jq -s '.[0] * .[1] * .[2]' \
        <(printf '%s' "$FALLBACK") \
        <(printf '%s' "$EXISTING") \
        <(printf '%s' "$MANAGED")
else
    # New/corrupt file: emit fallback + managed so required fields are present.
    jq -s '.[0] * .[1]' \
        <(printf '%s' "$FALLBACK") \
        <(printf '%s' "$MANAGED")
fi
