{{- /* sing-box client config, shared by every platform (docs/easytier.md).
       Called with (dict "root" $ "password" … "secret" … ["tun" true]
       ["edge" <outbound object, or a placeholder string replaced later>]).
       "edge" (gopass sing-box/edge-outbound, from
       edge-import) joins the Exit selector as tag "edge". Never
       sets the system proxy. With "tun": a TUN inbound with auto_route (every
       app, like a Tailscale exit node) that leaves system DNS alone and
       excludes private/overlay ranges; the exit outbounds then get
       bind_interface injected at start (nix-config/modules/sing-box.nix).
       Mixed SOCKS5/HTTP inbound on 127.0.0.1; private/overlay destinations go
       direct, singBox.exitRoutes destinations through their pinned exits,
       everything else through the `Exit` selector (default direct)
       over the EasyTier exits, minus this machine's own exit; Clash API + web
       panel on 127.0.0.1. Values from .chezmoidata/{sing-box,easytier}.yaml. */ -}}
{{- $r := .root -}}
{{- $self := (includeTemplate "easytier/role.tmpl" $r | fromJson).exit -}}
{{- $tags := list "direct" -}}
{{- $outbounds := list (dict "type" "direct" "tag" "direct") -}}
{{- range $name, $ip := $r.easytier.exits -}}
{{-   if ne $name $self -}}
{{-     $tags = append $tags $name -}}
{{-     $outbounds = append $outbounds (dict "type" "shadowsocks" "tag" $name "server" $ip "server_port" $r.easytier.exitProxy.port "method" $r.easytier.exitProxy.method "password" $.password) -}}
{{-   end -}}
{{- end -}}
{{- $edge := dig "edge" "" . -}}
{{- if $edge -}}
{{-   $tags = append $tags "edge" -}}
{{-   $outbounds = append $outbounds $edge -}}
{{- end -}}
{{- $outbounds = prepend $outbounds (dict "type" "selector" "tag" "Exit" "default" "direct" "outbounds" $tags) -}}
{{- /* Exit routes (singBox.exitRoutes): one urltest group per entry, members in
       priority order. A tolerance far above any real latency gap keeps the
       first live member selected; a failed member loses its history and the
       next one takes over. Existing connections (long mirror downloads) are
       never interrupted by a switch. */ -}}
{{- $rules := list (dict "action" "sniff") (dict "ip_is_private" true "outbound" "direct") (dict "ip_cidr" (list $r.easytier.network "100.64.0.0/10") "outbound" "direct") -}}
{{- range $r.singBox.exitRoutes -}}
{{-   $members := list -}}
{{-   range .exits -}}
{{-     if not (hasKey $r.easytier.exits .) -}}{{ fail (printf "singBox.exitRoutes: %q is not in easytier.exits" .) }}{{- end -}}
{{-     $members = append $members (ternary "direct" . (eq . $self)) -}}
{{-   end -}}
{{-   $outbounds = append $outbounds (dict "type" "urltest" "tag" .tag "outbounds" $members "tolerance" 10000 "interrupt_exist_connections" false) -}}
{{-   $rules = append $rules (dict "domain_suffix" .domainSuffix "ip_cidr" .ipCidr "outbound" .tag) -}}
{{- end -}}
{{- $inbounds := list (dict "type" "mixed" "tag" "mixed-in" "listen" "127.0.0.1" "listen_port" $r.singBox.mixedPort "set_system_proxy" false) -}}
{{- if dig "tun" false . -}}
{{- /* The TUN's IPv4 /30 must stay outside tunExcludeAddress: excluding it
       (172.16.0.0/12 once held 172.19.0.1/30) routes the stack's own peer
       address to en0 and breaks every IPv4 TCP connection. 198.18.0.0/15 is
       the RFC 2544 benchmark range, unused on real networks. */ -}}
{{-   $inbounds = append $inbounds (dict
        "type" "tun" "tag" "tun-in"
        "address" (list "198.18.0.1/30" "fdfe:dcba:9876::1/126")
        "auto_route" true
        "strict_route" false
        "dns_mode" "disabled"
        "route_exclude_address" $r.singBox.tunExcludeAddress) -}}
{{- end -}}
{{- $config := dict
      "log" (dict "level" "info" "timestamp" true)
      "dns" (dict "servers" (list (dict "type" "local" "tag" "local")))
      "inbounds" $inbounds
      "outbounds" $outbounds
      "route" (dict
        "rules" $rules
        "final" "Exit"
        "default_domain_resolver" "local"
        "auto_detect_interface" true)
      "experimental" (dict
        "cache_file" (dict "enabled" true)
        "clash_api" (dict
          "external_controller" (printf "127.0.0.1:%v" $r.singBox.clashApiPort)
          "external_ui" "ui"
          "external_ui_download_url" $r.singBox.webUiUrl
          "external_ui_download_detour" "direct"
          "secret" .secret)) -}}
{{- toPrettyJson $config -}}
