{{- /* sing-box client config, shared by every platform (docs/easytier.md).
       Called with (dict "root" $ "password" … "secret" … ["tun" true]
       ["bastion" <list of outbounds, or the placeholder string
       "__BASTION_OUTBOUNDS__" spliced in later>]).
       Panel groups (names are what the web panel shows):
         Egress   like a Tailscale exit node: whose network this machine uses.
                  Direct (default), every EasyTier exit except this machine,
                  bastion, and each exit chained through bastion (for networks
                  that only let the bastion through).
         bastion  how to reach the bastion: Reality (default), Hysteria2 or
                  AnyTLS, picked by hand (no automatic switching).
                  "bastion" (gopass sing-box/bastion-outbounds, bastion-import)
                  holds the outbounds tagged Reality, Hysteria2 and AnyTLS.
         <exitRoutes tag>  pinned destinations, e.g. jaist; see below.
       Never sets the system proxy. With "tun": a TUN inbound with auto_route
       (every app) that becomes the default resolver (DoH through Egress, see
       below) and excludes private/overlay ranges; the mesh exit outbounds then get bind_interface injected at start
       (nix-config/modules/sing-box.nix). Mixed SOCKS5/HTTP inbound on
       127.0.0.1; private/overlay destinations go Direct, singBox.exitRoutes
       destinations through their pinned exits, everything else through Egress;
       Clash API + web panel on 127.0.0.1. Values from
       .chezmoidata/{sing-box,easytier}.yaml. */ -}}
{{- $r := .root -}}
{{- $self := (includeTemplate "easytier/role.tmpl" $r | fromJson).exit -}}
{{- $direct := "Direct" -}}
{{- $outbounds := list (dict "type" "direct" "tag" $direct) -}}
{{- $mesh := list -}}
{{- range $name, $ip := $r.easytier.exits -}}
{{-   if ne $name $self -}}
{{-     $mesh = append $mesh $name -}}
{{-     $outbounds = append $outbounds (dict "type" "shadowsocks" "tag" $name "server" $ip "server_port" $r.easytier.exitProxy.port "method" $r.easytier.exitProxy.method "password" $.password) -}}
{{-   end -}}
{{- end -}}
{{- $exits := prepend $mesh $direct -}}
{{- $bastion := dig "bastion" "" . -}}
{{- $chained := dict -}}
{{- if $bastion -}}
{{- /* The protocol outbounds keep the tags bastion-import gives them. Each mesh
       exit gets a twin that reaches it through the bastion (the bastion relays
       to 10.144.144.x:1080 over its own EasyTier link), following whatever
       protocol the bastion group has selected. */ -}}
{{-   $protocols := list "Reality" "Hysteria2" "AnyTLS" -}}
{{-   $outbounds = append $outbounds (dict "type" "selector" "tag" "bastion" "default" "Reality" "outbounds" $protocols) -}}
{{-   if kindIs "string" $bastion -}}
{{-     $outbounds = append $outbounds $bastion -}}
{{-   else -}}
{{-     $outbounds = concat $outbounds $bastion -}}
{{-   end -}}
{{-   $exits = append $exits "bastion" -}}
{{-   range $mesh -}}
{{-     $tag := printf "%s via bastion" . -}}
{{-     $_ := set $chained . $tag -}}
{{-     $exits = append $exits $tag -}}
{{-     $outbounds = append $outbounds (dict "type" "shadowsocks" "tag" $tag "server" (index $r.easytier.exits .) "server_port" $r.easytier.exitProxy.port "method" $r.easytier.exitProxy.method "password" $.password "detour" "bastion") -}}
{{-   end -}}
{{- end -}}
{{- $outbounds = prepend $outbounds (dict "type" "selector" "tag" "Egress" "default" $direct "outbounds" $exits) -}}
{{- /* EasyTier's own packets must never ride an exit: the exits are carried by
       EasyTier, and the peers' public addresses can fall inside an exit route
       (the JAIST range holds gpuserver and nas), which looped hole-punching
       UDP to 11010 back into the mesh. --bind-device misses some of those
       sockets, so match the process, and the peer/STUN ports as a fallback. */ -}}
{{- $etPorts := prepend $r.easytier.bastion.stunPorts $r.easytier.bastion.peerPort -}}
{{- /* "directCidr": more destinations that always go Direct, whatever Egress
       says; the Mac script adds the bastion's own address here (SSH to it,
       EasyTier's TCP link), since the bastion refuses connections to itself
       and no other exit should carry them either. */ -}}
{{- $rules := list (dict "action" "sniff") (dict "process_name" (list "easytier-core") "outbound" $direct) (dict "port" $etPorts "outbound" $direct) (dict "ip_is_private" true "outbound" $direct) (dict "ip_cidr" (concat (list $r.easytier.network "100.64.0.0/10") (dig "directCidr" (list) .)) "outbound" $direct) -}}
{{- /* Exit routes (singBox.exitRoutes): one selector per entry, picked by hand
       in the panel and remembered across restarts (cache_file). Members are
       `Egress` first and by default (unpinned: the same route as everything
       else; nothing is pinned until picked), then the exits in order, then
       the same exits through the bastion for networks that block the mesh.
       Not a urltest:
       the bastion detour is only ~30-35 ms slower than the mesh link (84 vs
       118 ms on 2026-10-25), so latency picks kept landing on it (taken at
       start while EasyTier was still punching through, then held by the
       tolerance), and sing-box has no priority fallback group. When p2p
       fails, EasyTier itself relays through the bastion. Switching never cuts
       existing connections (long mirror downloads). */ -}}
{{- /* Destinations match by sniffed domain (domainSuffix), by address (ipCidr)
       and by remote rule-sets (ruleSets: SagerNet/sing-geosite builds of
       v2fly's community lists; sing-box refreshes them weekly and caches them
       in cache_file). Without a cache sing-box refuses to start until the
       download succeeds, so initial_path points at the copy chezmoi keeps
       under ~/.local/share/sing-box/rule-set (.chezmoiexternal.toml), and a
       boot without network still comes up. exceptKeyword names domains
       bundled in those lists that must not take the route; they fall through
       to Egress like anything else, so a broad keyword costs nothing. */ -}}
{{- $ruleSets := dict -}}
{{- range $r.singBox.exitRoutes -}}
{{-   $members := list -}}
{{-   $twins := list -}}
{{-   range .exits -}}
{{-     if not (hasKey $r.easytier.exits .) -}}{{ fail (printf "singBox.exitRoutes: %q is not in easytier.exits" .) }}{{- end -}}
{{-     $members = append $members (ternary $direct . (eq . $self)) -}}
{{-     if hasKey $chained . -}}{{- $twins = append $twins (index $chained .) -}}{{- end -}}
{{-   end -}}
{{-   $outbounds = append $outbounds (dict "type" "selector" "tag" .tag "outbounds" (concat (list "Egress") $members $twins) "default" "Egress" "interrupt_exist_connections" false) -}}
{{-   if hasKey . "exceptKeyword" -}}{{- $rules = append $rules (dict "domain_keyword" .exceptKeyword "outbound" "Egress") -}}{{- end -}}
{{-   $match := dict "outbound" .tag -}}
{{-   if hasKey . "domainSuffix" -}}{{- $_ := set $match "domain_suffix" .domainSuffix -}}{{- end -}}
{{-   if hasKey . "ipCidr" -}}{{- $_ := set $match "ip_cidr" .ipCidr -}}{{- end -}}
{{-   if hasKey . "ruleSets" -}}
{{-     $_ := set $match "rule_set" .ruleSets -}}
{{-     range .ruleSets -}}
{{-       $_ := set $ruleSets . (dict "type" "remote" "tag" . "format" "binary" "url" (replace "{tag}" . $r.singBox.ruleSetUrl) "initial_path" (printf "%s/.local/share/sing-box/rule-set/%s.srs" $r.chezmoi.homeDir .) "update_interval" "7d") -}}
{{-     end -}}
{{-   end -}}
{{-   $rules = append $rules $match -}}
{{- end -}}
{{- $inbounds := list (dict "type" "mixed" "tag" "mixed-in" "listen" "127.0.0.1" "listen_port" $r.singBox.mixedPort "set_system_proxy" false) -}}
{{- /* DNS. Without a TUN (headless Linux, apps opt in via proxy-on) apps hand
       the proxy domain names, so they resolve at the exit already and the
       local server only serves sing-box itself. */ -}}
{{- $dns := dict "servers" (list (dict "type" "local" "tag" "local")) -}}
{{- $resolver := "local" -}}
{{- if dig "tun" false . -}}
{{- /* The TUN's IPv4 /30 must stay outside tunExcludeAddress: excluding it
       (172.16.0.0/12 once held 172.19.0.1/30) routes the stack's own peer
       address to en0 and breaks every IPv4 TCP connection. 198.18.0.0/15 is
       the RFC 2544 benchmark range, unused on real networks.
       dns_mode native has sing-box answer DNS on the TUN's next address
       (198.18.0.2). It does not make that the system resolver for a plain
       process (only Network Extension VPNs can), so the LaunchDaemon points the
       physical network services at it while it answers
       (nix-config/modules/sing-box.nix); macOS keeps its per-domain resolvers
       (Tailscale's ts.net, a company VPN's domains, mDNS .local).
       sing-box resolves over DoH through Egress, so lookups leave from the same
       exit as the traffic, encrypted, and get answers for that location. The
       network's own DHCP-provided resolver ("lan"; not "local", which would
       ask the system, i.e. sing-box itself) keeps local names, reverse lookups
       and captive-portal probes, which must work before a hotspot login, and
       resolves the outbounds' own server names. */ -}}
{{-   $inbounds = append $inbounds (dict
        "type" "tun" "tag" "tun-in"
        "address" (list "198.18.0.1/30" "fdfe:dcba:9876::1/126")
        "auto_route" true
        "strict_route" false
        "dns_mode" "native"
        "route_exclude_address" $r.singBox.tunExcludeAddress) -}}
{{-   $dns = dict
        "servers" (list
          (dict "type" "https" "tag" "remote" "server" "1.1.1.1" "detour" "Egress")
          (dict "type" "dhcp" "tag" "lan"))
        "rules" (list
          (dict "domain_suffix" (list "home.arpa" "lan" "localdomain" "internal") "action" "route" "server" "lan")
          (dict "domain" (list "captive.apple.com" "connectivitycheck.gstatic.com" "www.msftconnecttest.com" "detectportal.firefox.com" "nmcheck.gnome.org") "action" "route" "server" "lan")
          (dict "query_type" (list "PTR") "action" "route" "server" "lan"))
        "final" "remote" -}}
{{-   $resolver = "lan" -}}
{{- end -}}
{{- $route := dict
      "rules" $rules
      "final" "Egress"
      "default_domain_resolver" $resolver
      "auto_detect_interface" true -}}
{{- $config := dict
      "log" (dict "level" "info" "timestamp" true)
      "dns" $dns
      "inbounds" $inbounds
      "outbounds" $outbounds
      "route" $route
      "experimental" (dict
        "cache_file" (dict "enabled" true)
        "clash_api" (dict
          "external_controller" (printf "127.0.0.1:%v" $r.singBox.clashApiPort)
          "external_ui" "ui"
          "external_ui_download_url" $r.singBox.webUiUrl
          "external_ui_download_detour" $direct
          "secret" .secret)) -}}
{{- if gt (len $ruleSets) 0 -}}
{{- /* Rule-set downloads dial directly (plain system path, no detour): sing-box
       1.14 wants the HTTP client named explicitly and refuses a detour to a
       bare direct outbound. */ -}}
{{-   $_ := set $route "rule_set" (values $ruleSets) -}}
{{-   $_ := set $route "default_http_client" "rule-sets" -}}
{{-   $_ := set $config "http_clients" (list (dict "tag" "rule-sets")) -}}
{{- end -}}
{{- toPrettyJson $config -}}
