{{- /* How sing-box runs on this machine (docs/easytier.md "sing-box"):
       system  work Mac: root LaunchDaemon, owns the system proxy, always on
       agent   other Macs: LaunchAgent loaded but started on demand (Surge stays
               the default proxy), no system proxy
       service headless Linux: systemd --user unit, always on
       ""      anything else: CLI only
       Every mode but "" also needs gopass easytier/exit-ss-password and
       sing-box/clash-api-secret; without them it degrades to "". */ -}}
{{- $mode := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $mode = ternary "system" "agent" .work -}}
{{- else if and (eq .chezmoi.os "linux") .headless -}}
{{-   $mode = "service" -}}
{{- end -}}
{{- $store := joinPath .chezmoi.homeDir ".local/share/gopass/stores/root" -}}
{{- if not (and (stat (joinPath $store "easytier/exit-ss-password.age")) (stat (joinPath $store "sing-box/clash-api-secret.age"))) -}}
{{-   $mode = "" -}}
{{- end -}}
{{- $mode -}}
