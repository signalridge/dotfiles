{{- /* EasyTier role of this machine, as JSON (never keyed by hostname):
       every Mac joins as a client with a DHCP-assigned virtual IP; a Linux
       machine joins only when its own chezmoi config data names it: as an exit
       with `easytierExit` (a name in .easytier.exits, whose fixed IP clients
       point at), or as a plain member with `easytierMember` (a name in
       .easytier.members: fixed IP, no exit proxy). Everything else:
       member=false. Membership also needs gopass easytier/bastion-host (kept
       out of this public repo); without it (fresh machine, CI) the machine
       renders as a non-member. */ -}}
{{- $role := dict "member" false "exit" "" "name" "" "ip" "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $role = dict "member" true "exit" "" "name" "" "ip" "" -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   if and (hasKey . "easytierExit") (hasKey . "easytierMember") -}}
{{-     fail "set only one of easytierExit and easytierMember" -}}
{{-   else if hasKey . "easytierExit" -}}
{{-     if not (hasKey .easytier.exits .easytierExit) -}}
{{-       fail (printf "easytierExit %q is not in .chezmoidata/easytier.yaml exits" .easytierExit) -}}
{{-     end -}}
{{-     $role = dict "member" true "exit" .easytierExit "name" .easytierExit "ip" (index .easytier.exits .easytierExit) -}}
{{-   else if hasKey . "easytierMember" -}}
{{-     if not (hasKey .easytier.members .easytierMember) -}}
{{-       fail (printf "easytierMember %q is not in .chezmoidata/easytier.yaml members" .easytierMember) -}}
{{-     end -}}
{{-     $role = dict "member" true "exit" "" "name" .easytierMember "ip" (index .easytier.members .easytierMember) -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $role "bastion" "" -}}
{{- if $role.member -}}
{{-   if stat (joinPath .chezmoi.homeDir ".local/share/gopass/stores/root/easytier/bastion-host.age") -}}
{{-     $_ := set $role "bastion" (output (includeTemplate "gopass/command.tmpl" .) "show" "-o" "easytier/bastion-host" | trim) -}}
{{-   else -}}
{{-     $role = dict "member" false "exit" "" "name" "" "ip" "" "bastion" "" -}}
{{-   end -}}
{{- end -}}
{{- $role | toJson -}}
