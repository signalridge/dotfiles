#!/usr/bin/env bash
# Keys Manager - Unified backup and restore command
# Manages SSH/GPG/Age keys with OpenSSL PBKDF2-encrypted git repository
# Dependencies: bash, git, openssl, jq (python3 for --password-file; fzf optional)
set -euo pipefail

# Resolve script directory robustly (works with symlinked entrypoints too).
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib/common
source "$SCRIPT_DIR/lib/common"

# ===== Constants =====

# Paths from chezmoi data
{{- $keysRepository := .keysRepository -}}
{{- if hasPrefix "git@github.com:" $keysRepository -}}
{{-   $keysRepository = printf "https://github.com/%s" (trimPrefix "git@github.com:" $keysRepository) -}}
{{- else if hasPrefix "ssh://git@github.com/" $keysRepository -}}
{{-   $keysRepository = printf "https://github.com/%s" (trimPrefix "ssh://git@github.com/" $keysRepository) -}}
{{- end }}
KEYS_REPO="{{ $keysRepository }}"
REPO_DIR="$HOME/.local/share/keys-backup"
BACKUP_FILES_DIR="backup-files"  # Generic directory for all backed up files
BACKUP_LIST="$REPO_DIR/backup-list.txt"
BACKUP_LIST_ENC="$REPO_DIR/backup-list.txt.enc"
METADATA_FILE="$REPO_DIR/backup-metadata.json"
METADATA_FILE_ENC="$REPO_DIR/backup-metadata.json.enc"
CONTROL_STATE_DIR="$REPO_DIR/.keys-manage"
CONTROL_BASELINE_LIST="$CONTROL_STATE_DIR/backup-list.remote.sha256"
CONTROL_BASELINE_META="$CONTROL_STATE_DIR/backup-metadata.remote.sha256"
HISTORY_LOG="$REPO_DIR/backup-history.log"
RESTORE_SNAPSHOT_DIR="$REPO_DIR/restore-snapshots"

VERSION=2

# Return codes used for interactive navigation.
RC_BACK=10   # Go back to previous menu
RC_EXIT=130  # User aborted (e.g., ESC in fzf)

# Run a top-level command and normalize interactive navigation return codes.
# When there is no parent menu, Back/ESC should simply exit successfully.
run_cmd() {
    if "$@"; then
        return 0
    else
        local rc=$?
        if [[ $rc -eq $RC_BACK || $rc -eq $RC_EXIT ]]; then
            return 0
        fi
        return "$rc"
    fi
}

# ===== Libraries =====

# shellcheck source=lib/keys-manage/core.sh
source "$SCRIPT_DIR/lib/keys-manage/core.sh"
# shellcheck source=lib/keys-manage/backup.sh
source "$SCRIPT_DIR/lib/keys-manage/backup.sh"
# shellcheck source=lib/keys-manage/restore.sh
source "$SCRIPT_DIR/lib/keys-manage/restore.sh"
# shellcheck source=lib/keys-manage/status.sh
source "$SCRIPT_DIR/lib/keys-manage/status.sh"
# shellcheck source=lib/keys-manage/menu.sh
source "$SCRIPT_DIR/lib/keys-manage/menu.sh"

# ===== Main Entry Point =====

# Open password files once with O_NOFOLLOW, then validate that same descriptor.
# This avoids check/open races and never re-opens the path for reading.
read_password_file_safely() {
    local path="$1"
    local password

    if ! command -v python3 >/dev/null 2>&1; then
        log_error "python3 is required for secure --password-file handling"
        return 1
    fi

    if ! password="$(python3 - "$path" 2>/dev/null <<'PY'
import os
import stat
import sys

path = sys.argv[1]
flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | os.O_NOFOLLOW
fd = os.open(path, flags)
try:
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        raise OSError("not a regular file")
    with os.fdopen(fd, "rb", closefd=False) as handle:
        sys.stdout.buffer.write(handle.read())
finally:
    os.close(fd)
PY
    )"; then
        log_error "Password file must be a readable regular file (not a symlink): $path"
        return 1
    fi

    if [[ -z "$password" ]]; then
        log_error "Password file is empty: $path"
        return 1
    fi
    _CACHED_PASSWORD="$password"
}

main() {
    trap 'clear_password_cache; cleanup_registered_temp_files' EXIT

    # Capture an automation password before spawning any helper, then remove it
    # from the environment inherited by git, credential helpers, hooks, etc.
    if [[ -n "${KEYS_BACKUP_PASSWORD:-}" ]]; then
        _CACHED_PASSWORD="$KEYS_BACKUP_PASSWORD"
        unset KEYS_BACKUP_PASSWORD
    fi

    # Password options are global and may appear before or after the command.
    # Remove them in one pass while preserving command-specific argument order.
    local -a remaining_args=()
    local command_seen=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                if [[ "$command_seen" == false ]]; then
                    show_help
                    exit 0
                fi
                remaining_args+=("$1")
                shift
                ;;
            --password-file)
                if [[ $# -lt 2 ]]; then
                    log_error "Missing value for $1"
                    return 1
                fi
                read_password_file_safely "$2" || return 1
                shift 2
                ;;
            -p|--password)
                log_error "$1 is unsafe because secrets appear in shell history and process arguments"
                log_error "Use --password-file, KEYS_BACKUP_PASSWORD, gopass, or the TTY prompt"
                return 2
                ;;
            *)
                remaining_args+=("$1")
                command_seen=true
                shift
                ;;
        esac
    done
    set -- "${remaining_args[@]}"

    local cmd="${1:-}"
    shift || true

    # If no command, show interactive menu
    if [[ -z "$cmd" ]]; then
        run_cmd cmd_menu
        return $?
    fi

    # Route commands
    case "$cmd" in
        # Backup commands
        init) run_cmd cmd_init "$@" ;;
        menu) run_cmd cmd_menu "$@" ;;
        select) run_cmd cmd_select "$@" ;;
        add) run_cmd cmd_add "$@" ;;
        remove) run_cmd cmd_remove "$@" ;;
        backup) run_cmd cmd_sync "$@" ;;
        sync) run_cmd cmd_sync "$@" ;;
        verify) run_cmd cmd_verify "$@" ;;
        history) run_cmd cmd_history "$@" ;;

        # Restore commands
        restore) run_cmd cmd_restore "$@" ;;
        versions|list-versions) run_cmd cmd_versions "$@" ;;
        validate) run_cmd cmd_validate "$@" ;;

        # Unified commands
        status) run_cmd cmd_status "$@" ;;
        password) run_cmd cmd_password "$@" ;;

        *)
            log_error "Unknown command: $cmd"
            echo "Run 'keys-manage --help' for usage"
            return 1
            ;;
    esac
}

main "$@"
