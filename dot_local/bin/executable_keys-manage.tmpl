#!/usr/bin/env bash
# SSH Keys Manager - Unified backup and restore command
# Manages SSH/GPG/Age keys with OpenSSL PBKDF2-encrypted git repository
set -euo pipefail

# shellcheck source=lib/common.tmpl
source "$(dirname "$0")/lib/common"

# ===== Library Functions (from lib/keys.tmpl) =====


# ===== Constants =====

# Paths from chezmoi data
KEYS_REPO="{{ .keysRepository }}"
REPO_DIR="$HOME/.local/share/keys-backup"
BACKUP_FILES_DIR="backup-files"  # Generic directory for all backed up files
BACKUP_LIST="$REPO_DIR/backup-list.txt"
METADATA_FILE="$REPO_DIR/backup-metadata.json"
HISTORY_LOG="$REPO_DIR/backup-history.log"

VERSION=2

# ===== Utility Functions =====

# Log event to history
log_event() {
    local event="$1"
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    echo "[$timestamp] $event" >> "$HISTORY_LOG"
}

# Convert absolute path to backup path (relative to $HOME)
# Usage: get_backup_path "/Users/user/.ssh/main" -> "backup-files/.ssh/main"
get_backup_path() {
    local file="$1"

    # Validate file is under $HOME
    if [[ "$file" != "$HOME"/* ]]; then
        log_error "Only files under $HOME can be backed up: $file"
        return 1
    fi

    # Convert absolute path to relative path under $HOME
    local rel_path="${file#$HOME/}"
    echo "$BACKUP_FILES_DIR/$rel_path"
}

# Convert backup path to absolute path
# Usage: get_absolute_path "backup-files/.ssh/main" -> "/Users/user/.ssh/main"
get_absolute_path() {
    local backup_path="$1"
    local rel_path="${backup_path#$BACKUP_FILES_DIR/}"
    echo "$HOME/$rel_path"
}

# ===== File Discovery & Filtering =====

# Discover key/certificate files from common directories
discover_key_files() {
    # Common directories for keys and certificates
    local key_dirs=(
        "$HOME/.ssh"           # SSH keys
        "$HOME/.gnupg"         # GPG keys
        "$HOME/.config/age"    # Age encryption keys
    )

    for dir in "${key_dirs[@]}"; do
        [[ ! -d "$dir" ]] && continue

        find "$dir" -type f -print0 2>/dev/null | while IFS= read -r -d $'\0' file; do
            # Skip public keys, known_hosts, authorized_keys
            [[ ! "$file" =~ \.pub$ ]] && \
            [[ ! "$file" =~ known_hosts ]] && \
            [[ ! "$file" =~ authorized_keys ]] && \
            [[ ! "$file" =~ \.lock$ ]] && \
            echo "$file"
        done
    done | sort -u
}

# Get key type from file
detect_key_type() {
    local file="$1"
    [[ ! -f "$file" ]] && { echo "unknown"; return; }

    local first_line
    first_line=$(head -n1 "$file" 2>/dev/null)

    # Use variables to avoid chezmoi template parsing issues
    local openssh_key="BEGIN OPENSSH PRIVATE""KEY"
    local rsa_key="BEGIN RSA PRIVATE""KEY"
    local ec_key="BEGIN EC PRIVATE""KEY"
    local dsa_key="BEGIN DSA PRIVATE""KEY"

    case "$first_line" in
        *"$openssh_key"*)
            if grep -q "ssh-ed25519" "$file"; then
                echo "Ed25519"
            elif grep -q "ecdsa" "$file"; then
                echo "ECDSA"
            else
                echo "OpenSSH"
            fi
            ;;
        *"$rsa_key"*) echo "RSA" ;;
        *"$ec_key"*) echo "ECDSA" ;;
        *"$dsa_key"*) echo "DSA" ;;
        "Host "*) echo "SSH Config" ;;
        *) echo "unknown" ;;
    esac
}

# ===== Checksum & Change Detection =====

# Detect if file has changed since last backup
detect_changes() {
    local file="$1"
    local password="${2:-}"
    [[ ! -f "$file" ]] && return 0  # Missing file = changed

    # Must be in git repo to detect changes
    cd "$REPO_DIR" 2>/dev/null || return 0

    # Get backup path using new structure
    local backup_file
    backup_file=$(get_backup_path "$file") || return 0

    # Check if file exists in git HEAD
    if ! git cat-file -e "HEAD:$backup_file" 2>/dev/null; then
        return 0  # File not in git = new file
    fi

    # Compare source file with decrypted backup
    local current_hash backup_hash
    current_hash=$(calc_checksum "$file")

    # Decrypt backup file to temp location for comparison
    local temp_encrypted="/tmp/keys-detect-$$.enc"
    local temp_decrypted="/tmp/keys-detect-$$"

    if git show "HEAD:$backup_file" > "$temp_encrypted" 2>/dev/null; then
        if decrypt_file "$temp_encrypted" "$temp_decrypted" "$password" 2>/dev/null; then
            backup_hash=$(calc_checksum "$temp_decrypted")
        else
            # Decryption failed, assume changed
            rm -f "$temp_encrypted" "$temp_decrypted"
            return 0
        fi
        rm -f "$temp_encrypted" "$temp_decrypted"
    else
        # Cannot get backup file, assume changed
        return 0
    fi

    [[ "$current_hash" != "$backup_hash" ]]
}

# Get file status (for display)
get_file_status() {
    local file="$1"
    local backed_up=false

    # Check if in backup list
    if [[ -f "$BACKUP_LIST" ]] && grep -qxF "$file" "$BACKUP_LIST"; then
        backed_up=true
    fi

    if [[ "$backed_up" == true ]]; then
        if detect_changes "$file"; then
            echo "${YELLOW}⚠${NC}"  # Modified
        else
            echo "${GREEN}✓${NC}"  # Up to date
        fi
    else
        if [[ -f "$METADATA_FILE" ]] && jq -e ".files[\"$file\"] // empty" "$METADATA_FILE" &>/dev/null; then
            echo "${RED}⊗${NC}"  # Removed from list
        else
            echo "${CYAN}⊕${NC}"  # New file
        fi
    fi
}

# ===== Metadata Management =====

# Initialize metadata file
init_metadata() {
    cat > "$METADATA_FILE" <<'EOF'
{
  "version": 2,
  "filters": {
    "include_patterns": ["*"],
    "exclude_patterns": ["*.pub", "known_hosts*", "authorized_keys*"],
    "custom_paths": []
  },
  "files": {}
}
EOF
    log_event "Initialized metadata v2"
}

# Update file metadata after backup
update_file_metadata() {
    local file="$1"
    [[ ! -f "$file" ]] && return 1
    [[ ! -f "$METADATA_FILE" ]] && init_metadata

    local hash size mtime now count
    hash=$(calc_checksum "$file")
    size=$(get_file_size "$file")
    mtime=$(get_file_mtime "$file")

    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    count=$(jq -r ".files[\"$file\"].backup_count // 0" "$METADATA_FILE")
    count=$((count + 1))

    local tmp
    tmp=$(mktemp)
    jq ".files[\"$file\"] = {
        \"sha256\": \"$hash\",
        \"size\": $size,
        \"mtime\": $mtime,
        \"last_backup\": \"$now\",
        \"backup_count\": $count
    }" "$METADATA_FILE" > "$tmp"
    mv "$tmp" "$METADATA_FILE"
}

# Remove file metadata from JSON
remove_file_metadata() {
    local file="$1"
    [[ ! -f "$METADATA_FILE" ]] && return 0

    local tmp
    tmp=$(mktemp)
    if jq "del(.files[\"$file\"])" "$METADATA_FILE" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$METADATA_FILE"
        return 0
    else
        rm -f "$tmp"
        return 1
    fi
}

# Get file metadata from JSON
get_file_info() {
    local file="$1"
    local field="$2"
    [[ ! -f "$METADATA_FILE" ]] && return 1
    jq -r ".files[\"$file\"].$field // empty" "$METADATA_FILE"
}

# Restore a single file from backup
restore_single_file() {
    local file="$1"
    local commit="${2:-HEAD}"

    cd "$REPO_DIR" || return 1

    # Get backup path using new structure
    local backup_file
    backup_file=$(get_backup_path "$file") || return 1

    # Check if file exists in backup
    if ! git cat-file -e "$commit:$backup_file" 2>/dev/null; then
        log_error "File not found in backup: $file"
        return 1
    fi

    # Create backup of current file if it exists
    if [[ -f "$file" ]]; then
        local backup_dir
        backup_dir="$(dirname "$file")/backup-$(date +%Y%m%d-%H%M%S)"
        mkdir -p "$backup_dir"
        cp "$file" "$backup_dir/"
        [[ -f "$file.pub" ]] && cp "$file.pub" "$backup_dir/"
        echo "  Backed up current file to: $backup_dir"
    fi

    # Extract encrypted file from git to temporary location
    local temp_encrypted="/tmp/keys-restore-$$.enc"
    local temp_decrypted="/tmp/keys-restore-$$"

    # Export encrypted file from git
    git show "$commit:$backup_file" > "$temp_encrypted" 2>/dev/null || {
        log_error "Failed to extract file from git"
        rm -f "$temp_encrypted"
        return 1
    }

    # Decrypt the file
    if ! decrypt_file "$temp_encrypted" "$temp_decrypted"; then
        log_error "Failed to decrypt file"
        rm -f "$temp_encrypted" "$temp_decrypted"
        return 1
    fi

    # Copy decrypted file to destination
    mkdir -p "$(dirname "$file")"
    cp "$temp_decrypted" "$file"
    chmod 600 "$file"

    # Clean up temporary files
    rm -f "$temp_encrypted" "$temp_decrypted"

    # Restore public key if exists (public keys are NOT encrypted)
    if git cat-file -e "$commit:$backup_file.pub" 2>/dev/null; then
        git show "$commit:$backup_file.pub" > "$file.pub" 2>/dev/null
        chmod 644 "$file.pub"
    fi

    log_success "Restored: $(basename "$file")"
    return 0
}

# ===== FZF Builders =====

# Generic FZF wrapper with common options
fzf_select() {
    local header="$1"
    local preview="${2:-}"

    local fzf_opts=(
        --height=50%
        --border=rounded
        --ansi
        --header="$header"
    )

    if [[ -n "$preview" ]]; then
        fzf_opts+=(--preview="$preview" --preview-window='right:50%:wrap')
    fi

    fzf "${fzf_opts[@]}"
}

# Multi-select FZF wrapper
fzf_multi_select() {
    local header="$1"
    local preview="${2:-}"

    local fzf_opts=(
        --height=50%
        --border=rounded
        --ansi
        --multi
        --header="$header"
        --bind='ctrl-a:select-all'
        --bind='ctrl-d:deselect-all'
    )

    if [[ -n "$preview" ]]; then
        fzf_opts+=(--preview="$preview" --preview-window='right:50%:wrap:border-left')
    fi

    fzf "${fzf_opts[@]}"
}

# FZF menu (single selection, no preview)
fzf_menu() {
    local header="$1"
    local preview="${2:-}"

    fzf_select "$header" "$preview"
}

# Build file list with status indicators
build_file_list_with_status() {
    while IFS= read -r file; do
        local status
        status=$(get_file_status "$file")
        printf "%b %s\n" "$status" "$file"
    done < <(discover_key_files)
}

# FZF file preview script
FILE_PREVIEW='
    line=$(echo {} | sed "s/^[[:space:]]*//" | sed "s/^[✓⚠⊕⊗○] //")
    file="$line"

    echo -e "\033[1;34m━━━ File Info ━━━\033[0m"
    echo ""
    echo "Path: $file"

    if [[ -f "$file" ]]; then
        # File metadata
        if stat -f%z "$file" &>/dev/null 2>&1; then
            # macOS
            size=$(stat -f%z "$file")
            mtime=$(stat -f%Sm -t "%Y-%m-%d %H:%M:%S" "$file")
            perms=$(stat -f%Sp "$file")
        else
            # Linux
            size=$(stat -c%s "$file")
            mtime=$(stat -c%y "$file" | cut -d. -f1)
            perms=$(stat -c%A "$file")
        fi
        echo "Size: $size bytes"
        echo "Modified: $mtime"
        echo "Permissions: $perms"

        # Key type detection
        keytype=$('"$(declare -f detect_key_type)"'; detect_key_type "$file")
        echo "Type: $keytype"

        # Show backup status if metadata exists
        meta_file="'"$METADATA_FILE"'"
        if [[ -f "$meta_file" ]]; then
            last_backup=$(jq -r ".files[\"$file\"].last_backup // empty" "$meta_file" 2>/dev/null)
            backup_count=$(jq -r ".files[\"$file\"].backup_count // 0" "$meta_file" 2>/dev/null)
            if [[ -n "$last_backup" ]]; then
                echo ""
                echo -e "\033[1;34m━━━ Backup Info ━━━\033[0m"
                echo "Last backup: $last_backup"
                echo "Backup count: $backup_count"
            fi
        fi

        # Preview first 10 lines
        echo ""
        echo -e "\033[1;34m━━━ Preview ━━━\033[0m"
        head -n 10 "$file" 2>/dev/null || echo "(binary or unreadable)"
    else
        echo ""
        echo -e "\033[0;31m✗ File not found\033[0m"
    fi
'

# Helper function to select custom files using FZF file browser
# Browse filesystem with yazi (file manager)
yazi_select_files() {
    if ! command -v yazi &>/dev/null; then
        log_error "yazi not found. Install with: brew install yazi"
        return 1
    fi

    # Create temp file for yazi output
    local tmpfile
    tmpfile=$(mktemp)

    # Launch yazi with explicit tty redirection
    # This ensures yazi can access the terminal even when called from within FZF
    yazi --chooser-file="$tmpfile" "$HOME" </dev/tty >/dev/tty 2>&1 || {
        rm -f "$tmpfile"
        echo "" >&2
        log_warn "File selection cancelled"
        return 1
    }

    # Read selected files
    local selected_files
    selected_files=$(cat "$tmpfile" 2>/dev/null)
    rm -f "$tmpfile"

    if [[ -z "$selected_files" ]]; then
        echo "" >&2
        log_warn "No files selected"
        return 1
    fi

    # Filter out directories - only allow regular files
    local valid_files=""
    local invalid_items=()
    while IFS= read -r path; do
        if [[ -f "$path" ]]; then
            valid_files="${valid_files}${path}"$'\n'
        elif [[ -d "$path" ]]; then
            invalid_items+=("$path")
        fi
    done <<< "$selected_files"

    # Remove trailing newline
    valid_files="${valid_files%$'\n'}"

    # If some directories were selected, show detailed warning
    if [[ ${#invalid_items[@]} -gt 0 ]]; then
        echo "" >&2
        log_warn "Cannot backup directories (only files are supported):"
        for item in "${invalid_items[@]}"; do
            echo "  • $item" >&2
        done
        echo "" >&2
    fi

    # If no valid files but had invalid items, give helpful message
    if [[ -z "$valid_files" ]]; then
        if [[ ${#invalid_items[@]} -gt 0 ]]; then
            log_error "No files selected - only directories were chosen"
            echo "Tip: Select individual files, not folders" >&2
        else
            log_warn "No files selected"
        fi
        return 1
    fi

    # Return selected files
    echo "$valid_files"
}

# FZF file selector with status and multi-select support (for discovered keys)
fzf_select_files() {
    local header="${1:-Select files to backup}"
    local mode="${2:-discovered}"  # "discovered" or "browse"

    if [[ "$mode" == "browse" ]]; then
        # Use yazi for filesystem browsing
        yazi_select_files
        return $?
    fi

    # Build file list with status indicators (discovered keys only)
    local file_list
    file_list=$(build_file_list_with_status)

    # Add option to browse filesystem
    file_list=$({
        echo "$file_list"
        echo ""
        echo -e "${CYAN}⊕ Browse entire filesystem with yazi...${NC}"
    })

    # FZF multi-select
    local selected
    selected=$(echo "$file_list" | fzf --ansi --multi \
        --height=80% \
        --border=rounded \
        --header="$header (Tab: multi-select, Ctrl-A: select all)" \
        --preview="$FILE_PREVIEW" \
        --preview-window='right:50%:wrap:border-left' \
        --preview-label="[File Preview - Ctrl-/: toggle]" \
        --bind='ctrl-a:select-all' \
        --bind='ctrl-d:deselect-all' \
        --bind='ctrl-r:reload('"$(declare -f build_file_list_with_status)"'; build_file_list_with_status; echo ""; echo -e "'"${CYAN}⊕ Browse entire filesystem with yazi...${NC}"'")' \
        --bind='ctrl-/:toggle-preview') || return 1

    # Check if user selected "Browse filesystem" option
    if echo "$selected" | grep -q "Browse entire filesystem"; then
        # Launch yazi for browsing
        local yazi_files
        yazi_files=$(yazi_select_files)
        if [[ -n "$yazi_files" ]]; then
            echo "$yazi_files"
            return 0
        fi
        return 1
    fi

    # Clean up selected lines (remove status indicators)
    local final_selection=""
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local cleaned
        cleaned=$(echo "$line" | sed 's/^[[:space:]]*//' | sed 's/^[✓⚠⊕⊗○] //')
        final_selection+="$cleaned"$'\n'
    done <<< "$selected"

    # Return final selection (remove trailing newline)
    echo -n "${final_selection%$'\n'}"
}

# ===== Git Operations =====

# Check git sync status with remote
# Returns: 0=in sync, 1=ahead, 2=behind, 3=diverged, 4=no remote
check_git_sync_status() {
    local ahead behind

    # Fetch remote without pulling
    git fetch origin --quiet 2>/dev/null || {
        log_warn "Cannot fetch from remote (offline or no access)"
        return 4
    }

    # Get ahead/behind counts
    local branch
    branch=$(git branch --show-current)
    local counts
    counts=$(git rev-list --left-right --count "HEAD...origin/$branch" 2>/dev/null || echo "0 0")
    ahead=$(echo "$counts" | awk '{print $1}')
    behind=$(echo "$counts" | awk '{print $2}')

    if [[ $ahead -gt 0 ]] && [[ $behind -gt 0 ]]; then
        echo "diverged:$ahead:$behind"
        return 3
    elif [[ $ahead -gt 0 ]]; then
        echo "ahead:$ahead"
        return 1
    elif [[ $behind -gt 0 ]]; then
        echo "behind:$behind"
        return 2
    else
        echo "in-sync"
        return 0
    fi
}

# Sync repository with remote (pull if needed)
sync_with_remote() {
    local status_info
    status_info=$(check_git_sync_status)
    local status_code=$?

    case $status_code in
        0)  # In sync
            return 0
            ;;
        1)  # Ahead of remote
            local ahead
            ahead=$(echo "$status_info" | cut -d: -f2)
            log_warn "Local repository is $ahead commit(s) ahead of remote"
            echo "  You have unpushed changes. They will be pushed with the next backup."
            return 0
            ;;
        2)  # Behind remote
            local behind
            behind=$(echo "$status_info" | cut -d: -f2)
            log_info "Pulling $behind new commit(s) from remote..."
            if git pull --quiet --ff-only 2>/dev/null; then
                log_success "Updated from remote"
                return 0
            else
                log_error "Failed to pull from remote"
                echo "  Possible causes:"
                echo "  - Merge conflicts"
                echo "  - Non-fast-forward changes"
                echo ""
                echo "  To fix:"
                echo "  - Run: cd $REPO_DIR && git pull"
                echo "  - Resolve any conflicts manually"
                return 1
            fi
            ;;
        3)  # Diverged
            local ahead behind
            ahead=$(echo "$status_info" | cut -d: -f2)
            behind=$(echo "$status_info" | cut -d: -f3)
            log_error "Repository has diverged from remote"
            echo "  Local: $ahead commit(s) ahead"
            echo "  Remote: $behind commit(s) ahead"
            echo ""
            echo "  To fix (choose one):"
            echo "  1. Merge: cd $REPO_DIR && git pull"
            echo "  2. Rebase: cd $REPO_DIR && git pull --rebase"
            echo "  3. Reset to remote: cd $REPO_DIR && git reset --hard origin/\$(git branch --show-current)"
            return 1
            ;;
        4)  # Cannot reach remote
            log_warn "Working offline (cannot reach remote)"
            return 0
            ;;
    esac
}

# Safe git commit with error handling
safe_git_commit() {
    local commit_msg="$1"
    local commit_output
    commit_output=$(mktemp)

    if git commit -m "$commit_msg" 2>"$commit_output"; then
        rm -f "$commit_output"
        return 0
    fi

    # Commit failed - analyze error
    local error_content
    error_content=$(cat "$commit_output" 2>/dev/null)
    rm -f "$commit_output"

    if echo "$error_content" | grep -q "nothing to commit"; then
        log_warn "Nothing to commit"
        return 1
    else
        log_error "Git commit failed"
        echo ""
        echo "Git error:"
        echo "$error_content" | sed 's/^/  /'
        return 1
    fi
}

# Safe git push with error handling
safe_git_push() {
    local push_output
    push_output=$(mktemp)

    echo -n "Pushing to remote... "
    if git push 2>"$push_output"; then
        echo "✓"
        rm -f "$push_output"
        return 0
    fi

    echo "✗"
    echo ""

    # Analyze push error
    local error_content
    error_content=$(cat "$push_output" 2>/dev/null)
    rm -f "$push_output"

    if echo "$error_content" | grep -q "non-fast-forward\|rejected"; then
        log_error "Push rejected (non-fast-forward)"
        echo ""
        echo "  Remote has changes you don't have locally."
        echo ""
        echo "  To fix:"
        echo "  1. Pull first: cd $REPO_DIR && git pull"
        echo "  2. Resolve any conflicts"
        echo "  3. Run backup again"
        return 1
    elif echo "$error_content" | grep -q "Authentication\|Permission denied"; then
        log_error "Authentication failed"
        echo ""
        echo "  Cannot push to remote (permission denied)"
        echo ""
        echo "  To fix:"
        echo "  - Check SSH key: ssh -T git@github.com"
        echo "  - Verify repository access rights"
        return 1
    else
        log_error "Push failed"
        echo ""
        echo "Git error:"
        echo "$error_content" | sed 's/^/  /'
        return 1
    fi
}

# Safe git pull with error handling
safe_git_pull() {
    local pull_output
    pull_output=$(mktemp)

    if git pull --quiet --ff-only 2>"$pull_output"; then
        rm -f "$pull_output"
        return 0
    fi

    # Pull failed - analyze error
    local error_content
    error_content=$(cat "$pull_output" 2>/dev/null)
    rm -f "$pull_output"

    if echo "$error_content" | grep -q "no tracking\|no remote"; then
        # No remote configured, not an error
        return 0
    else
        log_warn "Pull failed"
        echo "$error_content" | sed 's/^/  /'
        return 1
    fi
}

# Commit backup changes to git
# Consolidates the common pattern: git add + commit
commit_backup_changes() {
    local message="$1"

    git add backup-files/ backup-list.txt backup-metadata.json 2>/dev/null || true

    if safe_git_commit "$message"; then
        log_success "Changes committed: $message"
        return 0
    else
        log_error "Failed to commit changes"
        return 1
    fi
}

# ===== Directory Management =====

# Ensure local directory exists (without git initialization)
# Used by select/add/remove commands that only need local storage
ensure_local_dir() {
    if [[ -d "$REPO_DIR" ]]; then
        return 0
    fi

    log_info "Creating local backup directory..."
    mkdir -p "$REPO_DIR"

    # Initialize metadata if it doesn't exist
    if [[ ! -f "$METADATA_FILE" ]]; then
        init_metadata
    fi

    log_success "Local directory ready: $REPO_DIR"
    echo ""
    log_note "Run 'keys-manage init' before backing up to initialize git repository"
}

# Ensure repository is initialized and change to repo directory
# Consolidates the common pattern: init_repo_if_needed + cd
require_repo_and_cd() {
    init_repo_if_needed || {
        log_error "Failed to initialize repository"
        return 1
    }

    cd "$REPO_DIR" || {
        log_error "Failed to change directory to $REPO_DIR"
        return 1
    }
}

# ===== OpenSSL Encryption =====

# Cached password for the current session
_CACHED_PASSWORD=""

# Skip pause flag (set when user cancels operation)
_SKIP_PAUSE=false

# Get encryption password from cache, environment, gopass, or prompt
get_encryption_password() {
    # 1. Return cached password if available
    if [[ -n "$_CACHED_PASSWORD" ]]; then
        echo "$_CACHED_PASSWORD"
        return 0
    fi

    # 2. Check environment variable (for CI/CD automation)
    if [[ -n "${KEYS_BACKUP_PASSWORD:-}" ]]; then
        _CACHED_PASSWORD="$KEYS_BACKUP_PASSWORD"
        echo "$_CACHED_PASSWORD"
        return 0
    fi

    # 3. Try to get from gopass
    if command -v gopass &>/dev/null; then
        local gopass_password
        gopass_password=$(gopass show -o keys-manage/password 2>/dev/null)

        if [[ -n "$gopass_password" ]]; then
            _CACHED_PASSWORD="$gopass_password"
            echo "$_CACHED_PASSWORD"
            return 0
        fi
    fi

    # 4. Prompt user (only once per session)
    local password
    read -rsp "Enter backup encryption password: " password
    echo "" >&2

    if [[ -z "$password" ]]; then
        log_error "Password cannot be empty"
        return 1
    fi

    _CACHED_PASSWORD="$password"

    # Ask if user wants to save to gopass
    if command -v gopass &>/dev/null; then
        echo "" >&2
        read -rp "Save password to gopass for future use? (Y/n): " save_choice

        if [[ -z "$save_choice" ]] || [[ "$save_choice" =~ ^[Yy]$ ]]; then
            if echo "$password" | gopass insert -f keys-manage/password 2>/dev/null; then
                log_success "Password saved to gopass (keys-manage/password)" >&2
            else
                log_warn "Failed to save to gopass" >&2
            fi
        fi
    fi

    echo "$_CACHED_PASSWORD"
    return 0
}

# Clear cached password
clear_password_cache() {
    _CACHED_PASSWORD=""
}

# Encrypt file using OpenSSL PBKDF2
# Usage: encrypt_file <source> <destination> [password]
encrypt_file() {
    local source="$1"
    local dest="$2"
    local password="${3:-}"

    [[ ! -f "$source" ]] && {
        log_error "Source file not found: $source"
        return 1
    }

    # Get password if not provided
    if [[ -z "$password" ]]; then
        password=$(get_encryption_password) || {
            log_error "Failed to get encryption password"
            return 1
        }
    fi

    mkdir -p "$(dirname "$dest")"

    # OpenSSL AES-256-CBC with PBKDF2 (100,000 iterations)
    # -salt: Add random salt for security
    # -pbkdf2 -iter 100000: Use PBKDF2 with 100k iterations (recommended)
    if openssl enc -aes-256-cbc -pbkdf2 -iter 100000 -salt \
        -pass pass:"$password" -in "$source" -out "$dest" 2>/dev/null; then
        chmod 600 "$dest"
        return 0
    else
        log_error "Failed to encrypt file"
        return 1
    fi
}

# Decrypt file using OpenSSL PBKDF2
# Usage: decrypt_file <source> <destination> [password]
decrypt_file() {
    local source="$1"
    local dest="$2"
    local password="${3:-}"

    [[ ! -f "$source" ]] && {
        log_error "Source file not found: $source"
        return 1
    }

    # Get password if not provided
    if [[ -z "$password" ]]; then
        password=$(get_encryption_password) || {
            log_error "Failed to get encryption password"
            return 1
        }
    fi

    mkdir -p "$(dirname "$dest")"

    # Decrypt using same parameters
    if openssl enc -d -aes-256-cbc -pbkdf2 -iter 100000 \
        -pass pass:"$password" -in "$source" -out "$dest" 2>/dev/null; then
        chmod 600 "$dest"
        return 0
    else
        log_error "Failed to decrypt file (wrong password?)"
        return 1
    fi
}

# ===== Repository Health =====

# Check repository health
# Returns: 0=healthy, 1=not git repo, 2=offline mode
check_repo_health() {
    [[ ! -d "$REPO_DIR/.git" ]] && {
        log_error "Not a git repository"
        echo "Run 'keys-manage init' to initialize"
        return 1
    }

    cd "$REPO_DIR" || {
        log_error "Failed to change directory to $REPO_DIR"
        return 1
    }

    if ! git ls-remote &>/dev/null; then
        log_warn "Remote unreachable (working offline)"
        return 3  # Different exit code for offline mode
    fi

    return 0
}

# Initialize repository if needed
init_repo_if_needed() {
    # If git repo already exists, sync with remote and return
    if [[ -d "$REPO_DIR/.git" ]]; then
        cd "$REPO_DIR" || {
            log_error "Failed to change directory to $REPO_DIR"
            return 1
        }
        sync_with_remote || {
            log_error "Cannot sync with remote - please resolve conflicts first"
            return 1
        }
        return 0
    fi

    # If directory exists but no git (created by ensure_local_dir), run init
    if [[ -d "$REPO_DIR" ]] && [[ ! -d "$REPO_DIR/.git" ]]; then
        log_info "Local directory exists, initializing git repository..."
        echo ""
        # Provide instructions to initialize
        log_warn "Please run 'keys-manage init' first to initialize the git repository"
        return 1
    fi

    # Directory doesn't exist at all - this shouldn't happen normally
    # as both ensure_local_dir and init should create it
    echo -e "${BLUE}Cloning keys repository...${NC}"
    git clone "$KEYS_REPO" "$REPO_DIR" || {
        echo -e "${RED}Error:${NC} Failed to clone repository" >&2
        return 1
    }

    cd "$REPO_DIR" || {
        log_error "Failed to change directory to $REPO_DIR"
        return 1
    }
    log_event "Repository initialized"
}

# ===== Backup Operations =====

# Backup single file
backup_file() {
    local file="$1"
    local password="${2:-}"
    [[ ! -f "$file" ]] && return 1

    # Get backup path using new structure
    local backup_file
    backup_file=$(get_backup_path "$file") || return 1

    # Encrypt and store the file
    if ! encrypt_file "$file" "$REPO_DIR/$backup_file" "$password"; then
        log_error "Failed to encrypt: $file"
        return 1
    fi

    # Backup public key if exists (public keys are NOT encrypted)
    if [[ -f "$file.pub" ]]; then
        mkdir -p "$(dirname "$REPO_DIR/$backup_file.pub")"
        cp "$file.pub" "$REPO_DIR/$backup_file.pub"
        chmod 644 "$REPO_DIR/$backup_file.pub"
    fi
}

# Batch add files to backup (encrypt + update metadata + commit)
add_files_to_backup() {
    local files="$1"
    local password="$2"

    local success=0
    local failed=0

    while IFS= read -r file; do
        [[ -z "$file" ]] && continue

        # Add to backup list
        grep -qxF "$file" "$BACKUP_LIST" 2>/dev/null || echo "$file" >> "$BACKUP_LIST"

        # Encrypt file
        if backup_file "$file" "$password"; then
            update_file_metadata "$file"
            echo "  ${STATUS_OK} $(basename "$file")"
            success=$((success + 1))
        else
            echo "  ${STATUS_ERROR} Failed: $(basename "$file")"
            failed=$((failed + 1))
        fi
    done <<< "$files"

    # Sort and deduplicate backup list
    sort -u "$BACKUP_LIST" -o "$BACKUP_LIST"

    # Commit changes
    if commit_backup_changes "Add $success files"; then
        log_success "Added $success files"
    else
        log_warn "Added $success files (commit skipped)"
    fi

    # Report failures if any (use if to avoid set -e exit on false condition)
    if [[ $failed -gt 0 ]]; then
        log_warn "Failed: $failed files"
    fi
}

# Batch remove files from backup (delete encrypted + update metadata + commit)
remove_files_from_backup() {
    local files="$1"

    local removed=0
    local tmp
    tmp=$(mktemp)

    while IFS= read -r current_file; do
        local should_keep=true

        while IFS= read -r remove_file; do
            if [[ "$current_file" == "$remove_file" ]]; then
                should_keep=false

                # Delete encrypted file
                local backup_path
                backup_path=$(get_backup_path "$remove_file")
                rm -f "$REPO_DIR/$backup_path" "$REPO_DIR/$backup_path.pub"

                # Delete metadata
                remove_file_metadata "$remove_file"

                echo "  ${STATUS_OK} Removed: $(basename "$remove_file")"
                removed=$((removed + 1))
                break
            fi
        done <<< "$files"

        [[ "$should_keep" == true ]] && echo "$current_file" >> "$tmp"
    done < "$BACKUP_LIST"

    mv "$tmp" "$BACKUP_LIST"

    # Commit changes (use -A to remove deleted files)
    git add -A backup-files/ backup-list.txt backup-metadata.json
    if commit_backup_changes "Remove $removed files"; then
        log_success "Removed $removed files"
    else
        log_warn "Removed $removed files (commit skipped)"
    fi
}

# ===== Verification =====

# Verify file integrity
verify_file() {
    local file="$1"
    local password="${2:-}"
    [[ ! -f "$file" ]] && return 1

    # Get backup path using new structure
    local backup_path
    backup_path=$(get_backup_path "$file") || return 1
    local backup_file="$REPO_DIR/$backup_path"
    [[ ! -f "$backup_file" ]] && return 2

    # Decrypt backup file to temp location for comparison
    local temp_decrypted="/tmp/keys-verify-$$"
    if ! decrypt_file "$backup_file" "$temp_decrypted" "$password" 2>/dev/null; then
        rm -f "$temp_decrypted"
        return 3  # Decryption failed
    fi

    local local_hash backup_hash
    local_hash=$(calc_checksum "$file")
    backup_hash=$(calc_checksum "$temp_decrypted")
    rm -f "$temp_decrypted"

    [[ "$local_hash" == "$backup_hash" ]]
}

# ===== Git Version Helpers =====

# Get commit list with formatting
get_commit_list() {
    cd "$REPO_DIR" || {
        log_error "Failed to change directory to $REPO_DIR"
        return 1
    }
    git log --oneline --format="%C(yellow)%h%C(reset) %C(green)%ad%C(reset) %s" \
        --date=relative -- backup-files/ backup-list.txt backup-metadata.json
}

# FZF commit picker
fzf_pick_commit() {
    local header="${1:-Select version to restore}"

    get_commit_list | fzf --ansi \
        --height=80% \
        --border=rounded \
        --header="$header" \
        --preview='git -C "'"$REPO_DIR"'" show --color=always {1} -- backup-files/' \
        --preview-window='right:60%:wrap' \
        --bind='enter:accept' | awk '{print $1}'
}


