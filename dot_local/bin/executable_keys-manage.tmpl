# ===== Restore Commands (from keys-restore) =====

# Command: restore - Restore files from backup
cmd_restore() {
    local commit=""
    local dry_run=false
    local no_backup=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --commit|-c)
                commit="$2"
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --no-backup)
                no_backup=true
                shift
                ;;
            *)
                # First positional argument is commit
                if [[ -z "$commit" ]]; then
                    commit="$1"
                fi
                shift
                ;;
        esac
    done

    require_cmd git || return 1

    [[ ! -d "$REPO_DIR/.git" ]] && {
        log_error "Repository not initialized"
        echo "Run 'keys-manage init' first"
        return 1
    }

    cd "$REPO_DIR"

    [[ ! -f "$BACKUP_LIST" ]] && {
        log_error "No backup list found"
        return 1
    }

    # Select version with FZF if not specified
    if [[ -z "$commit" ]]; then
        if command -v fzf &>/dev/null; then
            commit=$(fzf_pick_commit "Select version to restore") || {
                _SKIP_PAUSE=true
                log_warn "Restore cancelled"
                return 0
            }
        else
            commit="HEAD"
            log_warn "fzf not found, using latest version"
        fi
    fi

    # Validate commit
    if ! git rev-parse "$commit" &>/dev/null; then
        log_error "Invalid commit: $commit"
        return 1
    fi

    local commit_short commit_msg commit_date
    commit_short=$(git rev-parse --short "$commit")
    commit_msg=$(git log -1 --format="%s" "$commit")
    commit_date=$(git log -1 --format="%ar" "$commit")

    log_section "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    log_section "SSH Keys Restore"
    log_section "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "Restore from:"
    echo "  Commit:  $commit_short"
    echo "  Message: $commit_msg"
    echo "  Date:    $commit_date"
    echo ""

    # Show diff
    echo "[1/5] Preview changes..."
    echo ""
    cmd_diff "$commit"

    if [[ "$dry_run" == true ]]; then
        echo ""
        log_warn "Dry run mode - no files will be restored"
        return 0
    fi

    # Confirmation
    echo ""
    read -r -p "Restore from $commit_short? (y/n): " confirm
    if [[ "$confirm" != "y" ]]; then
        _SKIP_PAUSE=true
        echo "Restore cancelled"
        return 0
    fi

    # Backup current state
    local backup_dir
    backup_dir="${HOME}/.ssh/backup-$(date +%Y%m%d-%H%M%S)"

    if [[ "$no_backup" != true ]]; then
        echo ""
        echo "[2/5] Backing up current state..."
        mkdir -p "$backup_dir"

        local backed_up=0
        while IFS= read -r file; do
            if [[ -f "$file" ]]; then
                cp "$file" "$backup_dir/"
                [[ -f "$file.pub" ]] && cp "$file.pub" "$backup_dir/"
                backed_up=$((backed_up + 1))
            fi
        done < "$BACKUP_LIST"

        log_success "Backed up $backed_up files to: $backup_dir"
    else
        echo ""
        log_warn "⚠ Skipping current state backup (--no-backup)"
    fi

    # Checkout backup version
    echo ""
    echo "[3/5] Checking out backup version..."
    git checkout "$commit" -- backup-files/ 2>/dev/null || {
        log_error "Failed to checkout backup version"
        return 1
    }

    # Restore files
    echo ""
    echo "[4/5] Restoring SSH keys..."
    mkdir -p ~/.ssh
    chmod 700 ~/.ssh

    local restored_count=0
    local failed_count=0

    while IFS= read -r file; do
        local filename
        filename=$(basename "$file")

        # Get backup path
        local backup_path
        backup_path=$(get_backup_path "$file")

        if [[ -f "$backup_path" ]]; then
            # Restore private key
            mkdir -p "$(dirname "$file")"
            cp "$backup_path" "$file"
            chmod 600 "$file"

            # Restore public key if exists
            if [[ -f "$backup_path.pub" ]]; then
                cp "$backup_path.pub" "$file.pub"
                chmod 644 "$file.pub"
            fi

            echo "  ${STATUS_OK} Restored: $filename"
            restored_count=$((restored_count + 1))
        else
            echo "  ${STATUS_ERROR} Not found in backup: $filename"
            failed_count=$((failed_count + 1))
        fi
    done < "$BACKUP_LIST"

    # Cleanup
    echo ""
    echo "[5/5] Cleanup..."
    git checkout HEAD -- backup-files/ 2>/dev/null || true

    echo ""
    log_section "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "✅ Restore Complete${NC}"
    log_section "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "Restored $restored_count files"
    [[ $failed_count -gt 0 ]] && echo "Failed: $failed_count files"

    if [[ "$no_backup" != true ]]; then
        echo ""
        log_info "Rollback available:"
        echo "  Current state saved to: $backup_dir"
        echo "  To rollback: cp $backup_dir/* ~/.ssh/"
    fi

    echo ""
    log_event "Restored from commit $commit_short: $restored_count files"
}

