#!/usr/bin/env bash
# mcp-reaper — reap orphaned Claude Code MCP servers.
#
# MCP stdio servers are spawned per session via `bunx <pkg>-mcp` (see mcp-tavily,
# mcp-context7, ...). On a clean exit Claude Code closes their stdio pipe and they
# die. On a crash / SIGKILL they get reparented to launchd (PID 1) and linger
# forever, accumulating across sessions.
#
# This script:
#   1. logs a CPU/mem snapshot of every MCP-related process (diagnostics), then
#   2. kills only the orphans — processes whose parent PID is 1.
#
# Safe by design: a process whose parent is a live `claude` session has a real
# PPID (not 1), so it is never touched. Only crash-orphaned servers are reaped.

set -uo pipefail

LOG_DIR="${HOME}/Library/Logs"
LOG="${LOG_DIR}/mcp-reaper.log"
mkdir -p "$LOG_DIR"

ts() { date '+%Y-%m-%dT%H:%M:%S%z'; }

# MCP servers launched from bunx temp dirs (tavily / context7 / codex / claude-code, ...).
PATTERN='bunx-[0-9]+-.*mcp'

# Snapshot every match, sorted by %CPU desc. Columns: PID PPID %CPU %MEM ELAPSED COMMAND.
snapshot="$(ps -axo pid=,ppid=,pcpu=,pmem=,etime=,command= \
  | grep -E "$PATTERN" | grep -v grep \
  | sort -k3 -nr)"

if [ -n "$snapshot" ]; then
  {
    echo "── $(ts) MCP processes (sorted by %CPU) — PID PPID %CPU %MEM ELAPSED COMMAND ──"
    echo "$snapshot"
  } >>"$LOG"
fi

# Orphans: PPID == 1 means the spawning Claude Code session is gone.
orphans="$(printf '%s\n' "$snapshot" | awk 'NF && $2==1 {print $1}')"

if [ -n "$orphans" ]; then
  echo "$(ts) reaping orphaned MCP servers: $(printf '%s ' $orphans)" >>"$LOG"
  # shellcheck disable=SC2086
  kill -9 $orphans 2>/dev/null || true
else
  echo "$(ts) no orphaned MCP servers" >>"$LOG"
fi
