#!/usr/bin/env bash
# mcp-reaper — reap orphaned Claude Code / Codex MCP servers.
#
# MCP servers are spawned per session:
#   * node servers via `bunx <pkg>-mcp` (tavily / codex-mcp / claude-code / slack)
#   * serena via `uv tool uvx ... serena start-mcp-server` (a uv launcher + python child)
# On a clean exit the client closes their stdio pipe and they die. On a crash /
# SIGKILL they get reparented to launchd (PID 1) and linger forever, piling up
# across sessions.
#
# This script logs a CPU/mem snapshot of every MCP-related process (diagnostics),
# then kills only the orphans — processes whose parent PID is 1. A process under a
# live session has a real PPID (not 1) and is never touched, so the long-running
# sessions you keep on purpose are safe. Two passes catch serena's python child,
# which only reparents to launchd once its orphaned uv launcher is killed.

set -uo pipefail

LOG_DIR="${HOME}/Library/Logs"
LOG="${LOG_DIR}/mcp-reaper.log"
mkdir -p "$LOG_DIR"

ts() { date '+%Y-%m-%dT%H:%M:%S%z'; }

# node/bunx MCP servers + serena (uv/python) MCP servers.
PATTERN='bunx-[0-9]+-.*mcp|serena.*start-mcp-server'

match_procs() {
  ps -axww -o pid=,ppid=,pcpu=,pmem=,etime=,command= \
    | grep -E "$PATTERN" | grep -v grep
}

# Snapshot every match, sorted by %CPU desc (diagnostics for "who eats CPU").
snapshot="$(match_procs | sort -k3 -nr)"
if [ -n "$snapshot" ]; then
  {
    echo "── $(ts) MCP processes (sorted by %CPU) — PID PPID %CPU %MEM ELAPSED COMMAND ──"
    echo "$snapshot"
  } >>"$LOG"
fi

# Reap orphans (PPID == 1). Two passes: killing an orphaned serena uv launcher
# reparents its python child to launchd, caught on the second pass.
reaped=""
for _pass in 1 2; do
  orphans="$(match_procs | awk 'NF && $2==1 {print $1}')"
  [ -n "$orphans" ] || break
  # shellcheck disable=SC2086
  kill -9 $orphans 2>/dev/null || true
  reaped="$reaped $orphans"
  sleep 1
done

if [ -n "${reaped// /}" ]; then
  echo "$(ts) reaped orphaned MCP servers:$reaped" >>"$LOG"
else
  echo "$(ts) no orphaned MCP servers" >>"$LOG"
fi
