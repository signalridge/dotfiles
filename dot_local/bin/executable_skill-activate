#!/usr/bin/env bash
#
# skill-activate — a live on/off panel for curating which library skills are
# active for Claude, Cursor, and every `.agents/skills` reader (Codex, pi, Kimi,
# mare) in the current directory.
# Tab/Space flips one skill on/off in place (the ● updates live). Ctrl-A flips
# every skill in the highlighted row's category; Enter leaves.
# Toggling is fast — the library is scanned ONCE up front and the panel just
# re-reads that cached index.
#
# The library is saved by FUNCTION category at download time:
#   ~/.harnesses/skills/<category>/<skill>/SKILL.md   (e.g. cloud/, python/, ai-llm/)
# so the panel groups by the folder directly — no sidecar mapping file.
#
# Active set (flat symlinks into the shared library):
#   current directory: ./.claude/skills/ + ./.agents/skills/ + ./.cursor/skills/
# `.agents/skills` is the cross-harness project dir: Codex
# (core-skills/src/loader.rs repo_agents_skill_roots), pi, Kimi and mare all read
# it. Codex ALSO reads ./.codex/skills, so linking both would show every skill
# twice there; older ./.codex/skills links are migrated to ./.agents/skills.
#
# Usage:
#   skill-activate                    live on/off panel
#   skill-activate --active           list active skills
#   skill-activate --list             print the rows (no fzf)
#   skill-activate --sync             repair partial Claude/Codex pairs
#   skill-activate --category <category>
#                                     activate every skill in a category
#   skill-activate --clear            deactivate everything for the current dir

set -euo pipefail

library="${SKILL_LIBRARY:-$HOME/.harnesses/skills}"
mode="pick"
category_name=""
internal=""
tname=""
pidx=""

if [ "${1:-}" = "__rows" ] || [ "${1:-}" = "__toggle" ] || [ "${1:-}" = "__toggle_category" ]; then
  internal="$1"
  shift
  if [ "$internal" = "__toggle" ] || [ "$internal" = "__toggle_category" ]; then
    tname="$1"
    shift
  fi
  pidx="${1:-}"
else
  while [ $# -gt 0 ]; do
    case "$1" in
    --active) mode="active" ;;
    --list) mode="list" ;;
    --sync) mode="sync" ;;
    --category | --activate-category)
      [ $# -ge 2 ] || {
        echo "skill-activate: $1 requires a category name" >&2
        exit 2
      }
      mode="category"
      category_name="$2"
      shift
      ;;
    --clear) mode="clear" ;;
    -h | --help)
      sed -n '3,29p' "$0" | sed 's/^#//; s/^ //'
      exit 0
      ;;
    *)
      echo "skill-activate: unknown argument '$1'" >&2
      exit 2
      ;;
    esac
    shift
  done
fi

claude_dir="$PWD/.claude/skills"
agents_dir="$PWD/.agents/skills"
cursor_dir="$PWD/.cursor/skills"
# Legacy per-project Codex dir: no longer written (Codex reads .agents/skills).
legacy_codex_dir="$PWD/.codex/skills"
# All harness skill dirs in the current project. A skill is symlinked into every
# one so Claude, the .agents/skills readers, and Cursor CLI (shared SKILL.md
# format) see the same set. Cursor CLI reads ./.cursor/skills natively and
# follows symlinked skill folders (verified).
active_dirs=("$claude_dir" "$agents_dir" "$cursor_dir")
target_label="Claude + .agents + Cursor current dir"

[ -d "$library" ] || {
  echo "skill-activate: library not found: $library" >&2
  exit 1
}
library="$(cd "$library" && pwd -P)"

require_real_dir() {
  if [ -L "$1" ]; then
    echo "skill-activate: $1 is a symlink -> $(readlink "$1")" >&2
    echo "  Make it a real dir first: rm '$1' && mkdir -p '$1'" >&2
    exit 1
  fi
}

skill_active_full() {
  local d
  for d in "${active_dirs[@]}"; do
    [ -e "$d/$1" ] || return 1
  done
  return 0
}

skill_active_any() {
  local d
  for d in "${active_dirs[@]}"; do
    [ -e "$d/$1" ] && return 0
  done
  return 1
}

mark() {
  if skill_active_full "$1"; then
    printf '●'
  elif skill_active_any "$1"; then
    printf '◐'
  else
    printf '○'
  fi
}

activate_skill() {
  local name="$1"
  local sdir="$2"
  local d
  for d in "${active_dirs[@]}"; do
    ln -sfn "$sdir" "$d/$name"
  done
}

deactivate_skill() {
  local name="$1"
  local d
  for d in "${active_dirs[@]}"; do
    rm -f "$d/$name"
  done
}

# Move library links left in the legacy ./.codex/skills into the active dirs,
# then drop the legacy dir if that left it empty. Only links whose literal,
# traversal-free target is under the library are touched.
migrate_legacy_codex() {
  [ -d "$legacy_codex_dir" ] && [ ! -L "$legacy_codex_dir" ] || return 0
  local link link_target relative_target moved=0
  while IFS= read -r -d '' link; do
    link_target=$(readlink "$link") || continue
    case "$link_target" in
      "$library"/*) ;;
      *) continue ;;
    esac
    relative_target=${link_target#"$library"/}
    case "/$relative_target/" in
      *'/../'* | *'/./'* | *'//'*) continue ;;
    esac
    activate_skill "${link##*/}" "$link_target"
    rm -f "$link"
    moved=$((moved + 1))
  done < <(find "$legacy_codex_dir" -mindepth 1 -maxdepth 1 -type l -print0 2>/dev/null)
  rmdir "$legacy_codex_dir" 2>/dev/null || true
  if [ "$moved" -gt 0 ]; then
    echo "skill-activate: moved $moved link(s) from ./.codex/skills to ./.agents/skills" >&2
  fi
  return 0
}

skill_dir_for_name() {
  awk -F'\t' -v n="$1" '$1==n{print $3; exit}' "$2"
}

skill_category_for_name() {
  awk -F'\t' -v n="$1" '$1==n{print $2; exit}' "$2"
}

set_category_state() {
  local category="$1"
  local index_file="$2"
  local state="$3"
  local matched=0
  local name
  local cat
  local sdir
  local desc

  while IFS=$'\t' read -r name cat sdir desc; do
    matched=1
    if [ "$state" = "on" ]; then
      activate_skill "$name" "$sdir"
    else
      deactivate_skill "$name"
    fi
  done < <(awk -F'\t' -v c="$category" '$2==c' "$index_file")

  [ "$matched" -eq 1 ]
}

sync_active_pairs() {
  local index_file="$1"
  local synced=0
  local name
  local cat
  local sdir
  local desc

  while IFS=$'\t' read -r name cat sdir desc; do
    if skill_active_any "$name" && ! skill_active_full "$name"; then
      activate_skill "$name" "$sdir"
      synced=$((synced + 1))
    fi
  done <"$index_file"

  printf '%s\n' "$synced"
}

category_all_active() {
  local category="$1"
  local index_file="$2"
  local any=0
  local inactive=0
  local name
  local cat
  local sdir
  local desc

  while IFS=$'\t' read -r name cat sdir desc; do
    any=1
    skill_active_full "$name" || inactive=1
  done < <(awk -F'\t' -v c="$category" '$2==c' "$index_file")

  [ "$any" -eq 1 ] && [ "$inactive" -eq 0 ]
}

toggle_category_for_skill() {
  local name="$1"
  local index_file="$2"
  local category
  category=$(skill_category_for_name "$name" "$index_file")
  [ -n "$category" ] || return 1

  if category_all_active "$category" "$index_file"; then
    set_category_state "$category" "$index_file" off
  else
    set_category_state "$category" "$index_file" on
  fi
}

rows_from() {
  while IFS=$'\t' read -r name cat sdir desc; do
    printf '%s\t%s  %-15s %-30s %s\n' "$name" "$(mark "$name")" "$cat" "$name" "$desc"
  done <"$1"
}

if [ "$internal" = "__rows" ]; then
  rows_from "$pidx"
  exit 0
fi
if [ "$internal" = "__toggle" ]; then
  [ -L "$claude_dir" ] && exit 0
  mkdir -p "${active_dirs[@]}" 2>/dev/null || true
  sdir=$(skill_dir_for_name "$tname" "$pidx")
  [ -n "$sdir" ] || exit 0
  if skill_active_full "$tname"; then
    deactivate_skill "$tname"
  else
    activate_skill "$tname" "$sdir"
  fi
  exit 0
fi
if [ "$internal" = "__toggle_category" ]; then
  [ -L "$claude_dir" ] && exit 0
  mkdir -p "${active_dirs[@]}" 2>/dev/null || true
  toggle_category_for_skill "$tname" "$pidx" || true
  exit 0
fi

if [ "$mode" = "active" ]; then
  [ -d "$claude_dir" ] && find "$claude_dir" -maxdepth 1 -type l 2>/dev/null | sed "s#$claude_dir/#  ●  #" | sort
  exit 0
fi

# Build the index ONCE: name <TAB> category <TAB> skilldir <TAB> description.
# Category = the library's own folder, which is already the function category.
build_index() {
  find "$library" -name SKILL.md -not -path '*/.system/*' 2>/dev/null | sort | while IFS= read -r md; do
    sdir=${md%/SKILL.md}
    name=${sdir##*/}
    rel=${sdir#"$library"/}
    cat=${rel%/*}
    [ "$cat" = "$rel" ] && cat="(top)"
    desc=$(awk '/^description:/{sub(/^description:[ \t]*/,""); gsub(/[|>"]/,""); if($0!=""){print;exit} getline; sub(/^[ \t]*/,""); gsub(/"/,""); print; exit}' "$md" 2>/dev/null | cut -c1-58)
    printf '%s\t%s\t%s\t%s\n' "$name" "$cat" "$sdir" "$desc"
  done
}

idx=$(mktemp)
trap 'rm -f "$idx"' EXIT
build_index | sort -t"$(printf '\t')" -k2,2 -k1,1 >"$idx"

case "$mode" in
list)
  rows_from "$idx" | cut -f2-
  exit 0
  ;;
sync)
  for d in "${active_dirs[@]}"; do require_real_dir "$d"; done
  mkdir -p "${active_dirs[@]}"
  migrate_legacy_codex
  n=$(sync_active_pairs "$idx")
  hs=${claude_dir/#$HOME/\~}
  echo "current dir: synced $n partial skill(s) ($target_label) in $hs"
  exit 0
  ;;
category)
  for d in "${active_dirs[@]}"; do require_real_dir "$d"; done
  mkdir -p "${active_dirs[@]}"
  migrate_legacy_codex
  if ! set_category_state "$category_name" "$idx" on; then
    echo "skill-activate: category not found: $category_name" >&2
    exit 1
  fi
  n=$(awk -F'\t' -v c="$category_name" '$2==c{n++} END{print n+0}' "$idx")
  hs=${claude_dir/#$HOME/\~}
  echo "current dir: activated $n skill(s) in category '$category_name' ($target_label) in $hs"
  exit 0
  ;;
clear)
  for d in "${active_dirs[@]}"; do require_real_dir "$d"; done
  # Remove every link whose literal, traversal-free target is below the
  # canonical library root. Scanning the discovery dirs (rather than only the
  # current index) also removes links to skills deleted or renamed upstream.
  for d in "${active_dirs[@]}" "$legacy_codex_dir"; do
    while IFS= read -r -d '' link; do
      link_target=$(readlink "$link") || continue
      case "$link_target" in
        "$library"/*)
          relative_target=${link_target#"$library"/}
          case "/$relative_target/" in
            *'/../'* | *'/./'* | *'//'*) continue ;;
          esac
          rm -f "$link"
          ;;
      esac
    done < <(find "$d" -mindepth 1 -maxdepth 1 -type l -print0 2>/dev/null)
  done
  echo "cleared current dir ($target_label)"
  exit 0
  ;;
esac

command -v fzf >/dev/null 2>&1 || {
  echo "skill-activate: fzf not found" >&2
  exit 1
}
for d in "${active_dirs[@]}"; do require_real_dir "$d"; done
mkdir -p "${active_dirs[@]}"
migrate_legacy_codex
self=$(command -v "$0" 2>/dev/null || true)
[ -x "$self" ] || self="$0"
hs=${claude_dir/#$HOME/\~}
header="current dir ($target_label) → $hs
Tab/Space: toggle one skill   │   Ctrl-A: toggle ALL skills in the highlighted category   │   Enter/Esc: done   │   ● both  ◐ partial  ○ off
CLI equivalents: skill-activate --category <category>   │   skill-activate --sync"

rows_from "$idx" | fzf \
  --delimiter='\t' --with-nth='2..' --no-multi --cycle --reverse --height='100%' \
  --header="$header" \
  --header-first \
  --bind="tab:execute-silent($self __toggle {1} $idx)+reload-sync($self __rows $idx)" \
  --bind="space:execute-silent($self __toggle {1} $idx)+reload-sync($self __rows $idx)" \
  --bind="ctrl-a:execute-silent($self __toggle_category {1} $idx)+reload-sync($self __rows $idx)" \
  --bind="enter:accept" \
  --bind="esc:accept" \
  --preview="sed -n '1,40p' \"\$(awk -F'\t' -v n={1} '\$1==n{print \$3}' '$idx')/SKILL.md\"" \
  --preview-window='right,56%,wrap' \
  >/dev/null || true

n=$(find "$claude_dir" -maxdepth 1 -type l 2>/dev/null | wc -l | tr -d ' ')
echo "current dir: $n skill(s) active ($target_label) in $hs"
