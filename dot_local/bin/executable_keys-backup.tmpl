#!/usr/bin/env bash
# SSH Keys Backup Script with FZF Interface
# Backs up SSH keys to transcrypt-encrypted git repository
set -euo pipefail

# shellcheck source=lib/keys.tmpl
source "$(dirname "$0")/lib/keys"

# ===== Command Functions =====

# Show help
show_help() {
    cat <<EOF
Usage: keys-backup [command] [options]

Commands:
  menu                Interactive FZF menu (default if no command)
  init                Initialize or setup backup repository
  select              Select files to backup (replaces existing list)
  add                 Add files to backup list (append)
  remove              Remove files from backup list
  backup              Backup changed files (incremental)
  verify              Verify backup integrity
  history             Show backup history
  status              Show current backup status

Options:
  -p, --password PWD  Transcrypt password (interactive if not provided)
  -r, --reconfigure   Force file selection reconfiguration
  --dry-run          Preview without making changes
  --path PATH        Add custom path to backup list

Examples:
  keys-backup                              # Interactive menu (default)
  keys-backup init                         # Initialize backup repository (first time)
  keys-backup init -p <password>           # Initialize with transcrypt password
  keys-backup select                       # Select files (scans ~/.ssh, ~/.gnupg, ~/.config/age)
  keys-backup add                          # Add more files to backup list
  keys-backup remove                       # Remove files from backup list
  keys-backup backup                       # Backup changed files
  keys-backup verify                       # Verify integrity
  keys-backup status                       # Show status

Supported Directories:
  - ~/.ssh               SSH keys
  - ~/.gnupg             GPG keys
  - ~/.config/age        Age encryption keys
  - Custom paths via "⊕ Add custom file..." in FZF menu

Status Indicators:
  ${GREEN}✓${NC}  Up to date (backed up, no changes)
  ${YELLOW}⚠${NC}  Modified (backed up but changed since)
  ${CYAN}⊕${NC}  New file (not in backup list)
  ${RED}⊗${NC}  Removed (was backed up, now excluded)
  ${GRAY}○${NC}  Available (not selected)

EOF
}

# Command: init - Initialize backup repository
cmd_init() {
    require_cmd git transcrypt || exit 1

    log_header "Keys Backup Repository Initialization"
    echo ""

    # Check if repository already exists
    if [[ -d "$REPO_DIR/.git" ]]; then
        log_warn "Repository already initialized: $REPO_DIR"
        echo ""

        # Check transcrypt status
        cd "$REPO_DIR"
        if [[ -f .gitattributes ]] && grep -q "filter=crypt" .gitattributes 2>/dev/null; then
            if [[ -f .transcrypt/cipher ]]; then
                log_success "Transcrypt is configured and unlocked"
            else
                log_warn "Transcrypt is configured but locked"
                echo ""
                echo "Unlocking transcrypt encryption..."
                unlock_transcrypt "$TRANSCRYPT_PASSWORD" || {
                    log_error "Failed to unlock transcrypt"
                    echo "Please provide the correct password with -p or interactively"
                    return 1
                }
                log_success "Transcrypt unlocked successfully"
            fi
        else
            log_warn "Repository exists but transcrypt is not configured"
            echo ""
            read -p "Initialize transcrypt encryption? (y/n): " init_transcrypt
            if [[ "$init_transcrypt" == "y" ]]; then
                init_transcrypt "$TRANSCRYPT_PASSWORD"
                log_success "Transcrypt initialized"
            fi
        fi

        echo ""
        log_success "Repository ready"
        return 0
    fi

    # Check if remote repository is configured
    if [[ -z "$KEYS_REPO" ]]; then
        log_error "Repository URL not configured"
        echo ""
        echo "Please set keysRepository in .chezmoidata/keys.yaml:"
        echo "  keysRepository: git@github.com:username/keys-backup.git"
        return 1
    fi

    echo "Repository URL: $KEYS_REPO"
    echo "Local path: $REPO_DIR"
    echo ""

    # Clone repository
    log_info "Cloning repository..."
    if ! git clone "$KEYS_REPO" "$REPO_DIR" 2>/dev/null; then
        log_note "Remote repository may not exist yet"
        echo ""
        read -p "Create new repository? (y/n): " create_new
        if [[ "$create_new" != "y" ]]; then
            echo "Initialization cancelled"
            return 1
        fi

        # Initialize new repository
        mkdir -p "$REPO_DIR"
        cd "$REPO_DIR"
        git init
        git remote add origin "$KEYS_REPO"

        # Initialize transcrypt
        echo ""
        log_info "Initializing transcrypt encryption..."
        init_transcrypt "$TRANSCRYPT_PASSWORD"

        # Create initial metadata
        init_metadata

        # Initial commit
        git add .gitattributes backup-metadata.json
        git commit -m "Initial commit: setup transcrypt and metadata"

        echo ""
        log_success "New repository created and configured"
        echo ""
        echo "Next steps:"
        echo "  1. Create the remote repository: $KEYS_REPO"
        echo "  2. Run: git -C $REPO_DIR push -u origin main"
        echo "  3. Run: keys-backup select  # Select files to backup"

        log_event "Repository initialized (new)"
        return 0
    fi

    # Repository cloned successfully
    cd "$REPO_DIR"
    log_success "Repository cloned"
    echo ""

    # Check for transcrypt configuration
    if [[ -f .gitattributes ]] && grep -q "filter=crypt" .gitattributes 2>/dev/null; then
        log_info "Unlocking transcrypt encryption..."
        unlock_transcrypt "$TRANSCRYPT_PASSWORD" || {
            log_error "Failed to unlock transcrypt"
            echo ""
            echo "This repository uses transcrypt encryption."
            echo "Please provide the correct password:"
            echo "  - Use -p flag: keys-backup init -p <password>"
            echo "  - Or run again and enter password interactively"
            return 1
        }
        log_success "Transcrypt unlocked"
    else
        log_note "Repository doesn't use transcrypt encryption"
    fi

    # Initialize metadata if needed
    if [[ ! -f "$METADATA_FILE" ]]; then
        echo ""
        echo "Initializing metadata..."
        init_metadata
        git add backup-metadata.json
        git commit -m "Initialize metadata v2"
        git push
    fi

    echo ""
    log_success "Repository initialized successfully"
    echo ""
    echo "Next steps:"
    echo "  1. Run: keys-backup select  # Select files to backup"
    echo "  2. Run: keys-backup backup  # Backup selected files"

    log_event "Repository initialized (clone)"
}

# Command: status - Show current backup status
cmd_status() {
    require_cmd git transcrypt jq || exit 1

    log_header "SSH Keys Backup Status"
    echo ""

    # Repository status
    if [[ -d "$REPO_DIR/.git" ]]; then
        log_success "Repository: ${REPO_DIR}"
        cd "$REPO_DIR"

        local remote_url
        remote_url=$(git remote get-url origin 2>/dev/null || echo "N/A")
        echo "  Remote: $remote_url"

        local last_commit
        last_commit=$(git log -1 --format="%h - %s (%ar)" 2>/dev/null || echo "N/A")
        echo "  Last commit: $last_commit"
    else
        log_warn "Repository not initialized"
        echo "  Run 'keys-backup init' to initialize"
        return 0
    fi

    # Metadata status
    if [[ -f "$METADATA_FILE" ]]; then
        local version file_count
        version=$(jq -r '.version // 1' "$METADATA_FILE")
        file_count=$(jq '.files | length' "$METADATA_FILE")
        log_success "Metadata: v$version ($file_count files tracked)"
    else
        log_warn "Metadata not initialized (legacy v1)"
    fi

    # Backup list
    if [[ -f "$BACKUP_LIST" ]]; then
        local selected_count
        selected_count=$(wc -l < "$BACKUP_LIST" | tr -d ' ')
        log_success "Backup list: $selected_count files selected"
    else
        log_warn "No backup list"
        return 0
    fi

    # File status
    echo ""
    log_section "File Status:"
    echo ""

    local total=0 unchanged=0 modified=0 new=0 missing=0

    while IFS= read -r file; do
        ((total++))
        local status
        status=$(get_file_status "$file")

        if [[ ! -f "$file" ]]; then
            echo "  ${STATUS_REMOVED} Missing: $file"
            ((missing++))
        elif [[ "$status" == *"✓"* ]]; then
            echo "  ${STATUS_OK} $(basename "$file")"
            ((unchanged++))
        elif [[ "$status" == *"⚠"* ]]; then
            echo "  ${STATUS_WARN} Modified: $(basename "$file")"
            ((modified++))
        else
            echo "  ${STATUS_NEW} New: $(basename "$file")"
            ((new++))
        fi
    done < "$BACKUP_LIST"

    echo ""
    echo "Summary: $total total, $unchanged unchanged, $modified modified, $new new, $missing missing"
    echo ""

    if [[ $modified -gt 0 ]] || [[ $new -gt 0 ]]; then
        echo "  → Run 'keys-backup backup' to backup changes"
    else
        echo "  → All files up to date"
    fi
    echo ""
}

# Command: select - Interactive file selection with FZF (replaces list)
cmd_select() {
    require_cmd fzf || exit 1

    log_section "Select files to backup with FZF"
    echo "(Tab: multi-select, Ctrl-A: all, ESC: cancel)${NC}"
    echo ""

    # Show current list if exists
    if [[ -f "$BACKUP_LIST" ]]; then
        local current_count
        current_count=$(wc -l < "$BACKUP_LIST" | tr -d ' ')
        log_warn "This will replace current backup list ($current_count files)"
        echo ""
    fi

    local selected
    selected=$(fzf_select_files "Select files to backup (will REPLACE current list)") || {
        log_warn "Selection cancelled - no changes made"
        return 1  # Exit with error code
    }

    if [[ -z "$selected" ]]; then
        log_warn "No files selected - aborting"
        return 1  # Exit with error code
    fi

    # Initialize repo if needed
    init_repo_if_needed || exit 1
    cd "$REPO_DIR"

    # Save selection (overwrites existing list)
    echo "$selected" > "$BACKUP_LIST"

    local count
    count=$(echo "$selected" | wc -l | tr -d ' ')
    log_success "Selected $count files (replaced backup list)"
    echo ""
    echo "$selected" | sed 's/^/  /'
    echo ""

    # Commit backup list
    if git diff --quiet backup-list.txt 2>/dev/null; then
        echo "No changes to backup list"
    else
        git add backup-list.txt
        git commit -m "Update backup list - $count files"
        git push
        log_event "Updated backup list: $count files"
    fi
}

# Command: add - Add files to backup list (append)
cmd_add() {
    require_cmd fzf || exit 1

    # Initialize repo if needed
    init_repo_if_needed || exit 1
    cd "$REPO_DIR"

    # Load current list
    local current_files=()
    if [[ -f "$BACKUP_LIST" ]]; then
        mapfile -t current_files < "$BACKUP_LIST"
        log_section "Current backup list: ${#current_files[@]} files${NC}"
        echo ""
    else
        log_section "No existing backup list - selecting from all files${NC}"
        echo ""
    fi

    # Build list of files NOT in current backup list
    local available_files=()
    while IFS= read -r file; do
        local is_in_list=false
        for current_file in "${current_files[@]}"; do
            if [[ "$file" == "$current_file" ]]; then
                is_in_list=true
                break
            fi
        done
        [[ "$is_in_list" == false ]] && available_files+=("$file")
    done < <(discover_key_files)

    if [[ ${#available_files[@]} -eq 0 ]]; then
        log_success "All SSH files are already in backup list"
        return 0
    fi

    echo "Available files to add: ${#available_files[@]}${NC}"
    echo "(Tab: multi-select, ESC: cancel)${NC}"
    echo ""

    # FZF to select files to add
    local to_add
    to_add=$(printf '%s\n' "${available_files[@]}" | fzf --multi \
        --height=80% \
        --border=rounded \
        --header="Select files to ADD to backup list" \
        --preview="$FILE_PREVIEW" \
        --preview-window='right:50%:wrap:border-left' \
        --bind='ctrl-a:select-all') || {
        log_warn "Selection cancelled"
        return 1
    }

    if [[ -z "$to_add" ]]; then
        log_warn "No files selected"
        return 1
    fi

    # Append to backup list
    echo "$to_add" >> "$BACKUP_LIST"
    sort -u "$BACKUP_LIST" -o "$BACKUP_LIST"  # Remove duplicates and sort

    local added_count
    added_count=$(echo "$to_add" | wc -l | tr -d ' ')
    log_success "Added $added_count files to backup list"
    echo ""
    echo "$to_add" | sed 's/^/  /'
    echo ""

    # Commit changes
    if git diff --quiet backup-list.txt 2>/dev/null; then
        echo "No changes to commit"
    else
        git add backup-list.txt
        git commit -m "Add $added_count files to backup list"
        git push
        log_event "Added $added_count files to backup list"
    fi
}

# Command: remove - Remove files from backup list
cmd_remove() {
    require_cmd fzf || exit 1

    # Initialize repo if needed
    init_repo_if_needed || exit 1
    cd "$REPO_DIR"

    if [[ ! -f "$BACKUP_LIST" ]] || [[ ! -s "$BACKUP_LIST" ]]; then
        log_warn "Backup list is empty"
        return 1
    fi

    local current_count
    current_count=$(wc -l < "$BACKUP_LIST" | tr -d ' ')
    log_section "Current backup list: $current_count files${NC}"
    echo "(Tab: multi-select, ESC: cancel)${NC}"
    echo ""

    # FZF to select files to remove
    local to_remove
    to_remove=$(cat "$BACKUP_LIST" | fzf --multi \
        --height=80% \
        --border=rounded \
        --header="Select files to REMOVE from backup list" \
        --preview="
            file={}
            echo -e \"\033[1;31m━━━ WILL BE REMOVED ━━━\033[0m\"
            echo \"\"
            echo \"Path: \$file\"
            if [[ -f \"\$file\" ]]; then
                echo \"Status: Exists\"
            else
                echo \"Status: Missing\"
            fi
        " \
        --preview-window='right:50%:wrap' \
        --bind='ctrl-a:select-all') || {
        log_warn "Selection cancelled"
        return 1
    }

    if [[ -z "$to_remove" ]]; then
        log_warn "No files selected"
        return 1
    fi

    # Confirm removal
    local remove_count
    remove_count=$(echo "$to_remove" | wc -l | tr -d ' ')
    echo "Will remove $remove_count files from backup list:${NC}"
    echo ""
    echo "$to_remove" | sed 's/^/  /'
    echo ""
    read -p "Confirm removal? (y/N): " confirm
    if [[ "$confirm" != "y" ]]; then
        echo "Cancelled"
        return 1
    fi

    # Remove from backup list
    local tmp
    tmp=$(mktemp)
    while IFS= read -r line; do
        local should_keep=true
        while IFS= read -r remove_line; do
            if [[ "$line" == "$remove_line" ]]; then
                should_keep=false
                break
            fi
        done <<< "$to_remove"
        [[ "$should_keep" == true ]] && echo "$line"
    done < "$BACKUP_LIST" > "$tmp"
    mv "$tmp" "$BACKUP_LIST"

    log_success "Removed $remove_count files from backup list"
    echo ""

    local remaining
    remaining=$(wc -l < "$BACKUP_LIST" | tr -d ' ')
    echo "Remaining files: $remaining"
    echo ""

    # Commit changes
    if git diff --quiet backup-list.txt 2>/dev/null; then
        echo "No changes to commit"
    else
        git add backup-list.txt
        git commit -m "Remove $remove_count files from backup list"
        git push
        log_event "Removed $remove_count files from backup list"
    fi
}

# Command: backup - Backup changed files (always incremental)
cmd_backup() {
    local dry_run=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            --verify) VERIFY_AFTER_BACKUP=true; shift ;;
            *) shift ;;
        esac
    done

    require_cmd git transcrypt jq || exit 1

    log_header "Keys Backup (Incremental)"
    echo ""

    # Initialize repo
    init_repo_if_needed || exit 1
    cd "$REPO_DIR"

    # Initialize metadata if needed
    [[ ! -f "$METADATA_FILE" ]] && init_metadata

    # Check backup list exists
    if [[ ! -f "$BACKUP_LIST" ]]; then
        log_warn "No backup list found"
        echo ""
        echo "First time setup: Select files to backup"
        echo ""
        cmd_select
        [[ ! -f "$BACKUP_LIST" ]] && { echo "No files selected, aborting"; exit 0; }
    fi

    # Show backup list
    echo "[1/5] Files in backup list:"
    echo ""
    while IFS= read -r file; do
        local status
        status=$(get_file_status "$file")
        printf "  %b %s\n" "$status" "$(basename "$file")"
    done < "$BACKUP_LIST"
    echo ""

    # Detect changes
    echo "[2/5] Detecting changes..."
    local changed_files=()
    local total_files=0

    while IFS= read -r file; do
        ((total_files++))
        if [[ ! -f "$file" ]]; then
            echo "  ${STATUS_ERROR} Missing: $file"
            continue
        fi

        if detect_changes "$file"; then
            changed_files+=("$file")
            echo "  ${STATUS_WARN} Changed: $(basename "$file")"
        fi
    done < "$BACKUP_LIST"

    if [[ ${#changed_files[@]} -eq 0 ]]; then
        log_success "No changes to backup (all files up to date)"
        return 0
    fi

    echo ""
    echo "Detected: ${#changed_files[@]} of $total_files files changed"
    echo ""

    if [[ "$dry_run" == true ]]; then
        echo "Dry run mode - files that would be backed up:"
        printf '%s\n' "${changed_files[@]}" | sed 's/^/  /'
        return 0
    fi

    # Backup files
    echo "[3/5] Backing up files..."
    for file in "${changed_files[@]}"; do
        if backup_file "$file"; then
            update_file_metadata "$file"
            echo "  ${STATUS_OK} $(basename "$file")"
        else
            echo "  ${STATUS_ERROR} Failed: $(basename "$file")"
        fi
    done

    # Commit changes
    echo ""
    echo "[4/5] Committing to git..."
    git add ssh-keys/ backup-list.txt backup-metadata.json

    if git diff --cached --quiet; then
        echo "  No changes to commit"
    else
        local commit_msg
        if [[ "$force" == true ]]; then
            commit_msg="Force backup: ${#changed_files[@]} files - $(date '+%Y-%m-%d %H:%M:%S')"
        else
            commit_msg="Backup: ${#changed_files[@]} files - $(date '+%Y-%m-%d %H:%M:%S')"
        fi
        git commit -m "$commit_msg"
        log_event "$commit_msg"

        echo "[5/5] Pushing to remote..."
        git push
    fi

    echo ""
    log_header "✅ Backup Complete"
    echo ""
    echo "Backed up ${#changed_files[@]} changed files"
    echo "Repository: $KEYS_REPO"
    echo "Local copy: $REPO_DIR"
    echo ""

    # Verify if requested
    if [[ "${VERIFY_AFTER_BACKUP:-false}" == true ]]; then
        echo "Verifying backup..."
        cmd_verify
    fi
}

# Command: verify - Verify backup integrity
cmd_verify() {
    require_cmd git transcrypt || exit 1

    [[ ! -d "$REPO_DIR/.git" ]] && {
        log_error "Repository not initialized"
        return 1
    }

    [[ ! -f "$BACKUP_LIST" ]] && {
        log_error "No backup list found"
        return 1
    }

    cd "$REPO_DIR"

    log_info "Verifying backup integrity..."
    echo ""

    local errors=0
    local verified=0

    while IFS= read -r file; do
        local filename
        filename=$(basename "$file")

        if [[ ! -f "$file" ]]; then
            log_warn "Local file missing: $file"
            continue
        fi

        if [[ ! -f "ssh-keys/$filename" ]]; then
            log_fail "Not in backup: $filename"
            ((errors++))
            continue
        fi

        if verify_file "$file"; then
            log_success "OK: $filename"
            ((verified++))
        else
            log_fail "Mismatch: $filename"
            ((errors++))
        fi
    done < "$BACKUP_LIST"

    echo ""
    if [[ $errors -eq 0 ]]; then
        echo "✅ All $verified files verified${NC}"
        return 0
    else
        echo "❌ $errors verification failures${NC}"
        return 1
    fi
}

# Command: history - Show backup history
cmd_history() {
    [[ ! -f "$HISTORY_LOG" ]] && {
        echo "No history available"
        return 0
    }

    log_section "Backup History"
    echo ""
    tail -n 20 "$HISTORY_LOG"
    echo ""
}

# Command: menu - Interactive FZF menu
cmd_menu() {
    require_cmd fzf || {
        log_warn "FZF not found, showing status instead"
        cmd_status
        return 0
    }

    while true; do
        local selected
        selected=$(cat << 'MENU' | fzf --ansi \
            --height=60% \
            --border=rounded \
            --header="SSH Keys Backup Manager" \
            --preview='
                cmd=$(echo {} | awk "{print \$1}")
                echo -e "\033[1;34m━━━ $cmd ━━━\033[0m"
                echo ""
                case "$cmd" in
                    init)
                        echo "Initialize or setup backup repository"
                        echo ""
                        echo "Functions:"
                        echo "  • Clone remote repository (if not exists)"
                        echo "  • Unlock transcrypt encryption"
                        echo "  • Initialize metadata"
                        echo ""
                        echo "First time setup:"
                        echo "  1. Configure keysRepository in chezmoi"
                        echo "  2. Run 'keys-backup init'"
                        echo "  3. Provide transcrypt password"
                        ;;
                    select)
                        echo "Select files to backup (REPLACE list)"
                        echo ""
                        echo "Features:"
                        echo "  • Rich preview (metadata, key type, content)"
                        echo "  • Status indicators (✓ ⚠ ⊕ ⊗)"
                        echo "  • Multi-select (Tab/Ctrl-A)"
                        echo ""
                        echo "⚠ This REPLACES current backup list"
                        ;;
                    add)
                        echo "Add files to backup list (APPEND)"
                        echo ""
                        echo "Features:"
                        echo "  • Shows only files NOT in current list"
                        echo "  • Appends to existing list"
                        echo "  • Multi-select support"
                        ;;
                    remove)
                        echo "Remove files from backup list"
                        echo ""
                        echo "Features:"
                        echo "  • Shows current backup list"
                        echo "  • Multi-select for removal"
                        echo "  • Confirmation required"
                        ;;
                    backup)
                        echo "Backup files to encrypted repository"
                        echo ""
                        echo "Incremental backup:"
                        echo "  • Auto-detects changes (SHA256)"
                        echo "  • Only backs up modified files"
                        echo "  • First backup backs up everything"
                        ;;
                    verify)
                        echo "Verify backup integrity"
                        echo ""
                        echo "Checks SHA256 checksums:"
                        echo "  • Local files vs backup"
                        echo "  • Reports mismatches"
                        ;;
                    history)
                        echo "Show backup event history"
                        echo ""
                        echo "Displays last 20 backup events"
                        ;;
                    status)
                        echo "Show current backup status"
                        echo ""
                        echo "Displays:"
                        echo "  • Repository info"
                        echo "  • Metadata version"
                        echo "  • File status summary"
                        ;;
                esac
                echo ""
                echo -e "\033[1;34m━━━ Quick Status ━━━\033[0m"
                echo ""
                if [[ -d "$HOME/.local/share/keys-backup/.git" ]]; then
                    cd "$HOME/.local/share/keys-backup"
                    echo "Repository: $(git remote get-url origin 2>/dev/null || echo "N/A")"
                    echo "Last commit: $(git log -1 --format="%ar" 2>/dev/null || echo "N/A")"
                    if [[ -f "$HOME/.local/share/keys-backup/backup-list.txt" ]]; then
                        echo "Files: $(wc -l < "$HOME/.local/share/keys-backup/backup-list.txt" | tr -d " ") selected"
                    fi
                else
                    echo "⚠ Not initialized"
                    echo "Run 'init' to initialize"
                fi
            ' \
            --preview-window='right:50%:wrap' \
            --preview-label="[ Keys Backup Manager ]"
init           Initialize backup repository
select         Select files (replace list)
add            Add files (append to list)
remove         Remove files from list
backup         Backup changed files
verify         Verify backup integrity
history        Show backup history
status         Show current status
MENU
        ) || return 0

        local cmd
        cmd=$(echo "$selected" | awk '{print $1}')

        echo ""
        case "$cmd" in
            init)
                cmd_init
                ;;
            select)
                cmd_select
                ;;
            add)
                cmd_add
                ;;
            remove)
                cmd_remove
                ;;
            backup)
                cmd_backup
                ;;
            verify)
                cmd_verify
                ;;
            history)
                cmd_history
                ;;
            status)
                cmd_status
                ;;
            *)
                echo "Unknown command: $cmd"
                ;;
        esac

        echo ""
        read -p "Press Enter to continue..." || return 0
    done
}

# ===== Main Entry Point =====

main() {
    local cmd="${1:-}"
    shift || true

    # Global options
    TRANSCRYPT_PASSWORD=""
    RECONFIGURE=false
    CUSTOM_PATH=""

    # Parse global options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -p|--password)
                TRANSCRYPT_PASSWORD="$2"
                shift 2
                ;;
            -r|--reconfigure)
                RECONFIGURE=true
                shift
                ;;
            --path)
                CUSTOM_PATH="$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    # Handle custom path
    if [[ -n "$CUSTOM_PATH" ]]; then
        if [[ -f "$CUSTOM_PATH" ]]; then
            init_repo_if_needed || exit 1
            echo "$CUSTOM_PATH" >> "$BACKUP_LIST"
            sort -u "$BACKUP_LIST" -o "$BACKUP_LIST"
            log_success "Added: $CUSTOM_PATH"
        else
            log_error "File not found: $CUSTOM_PATH"
            exit 1
        fi
        exit 0
    fi

    # Route commands
    case "$cmd" in
        init)
            cmd_init "$@"
            ;;
        select)
            cmd_select "$@"
            ;;
        add)
            cmd_add "$@"
            ;;
        remove)
            cmd_remove "$@"
            ;;
        backup)
            cmd_backup "$@"
            ;;
        verify)
            cmd_verify "$@"
            ;;
        history)
            cmd_history "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        menu)
            cmd_menu
            ;;
        "")
            # No command - show interactive menu
            cmd_menu
            ;;
        *)
            log_error "Unknown command: $cmd"
            echo "Run 'keys-backup --help' for usage"
            exit 1
            ;;
    esac
}

main "$@"
