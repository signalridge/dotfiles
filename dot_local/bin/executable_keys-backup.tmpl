#!/usr/bin/env bash
# SSH Keys Backup Script with FZF Interface
# Backs up SSH keys to transcrypt-encrypted git repository
set -euo pipefail

# shellcheck source=keys-lib
source "$(dirname "$0")/keys-lib"

# ===== Command Functions =====

# Show help
show_help() {
    cat <<EOF
Usage: keys-backup [command] [options]

Commands:
  menu                Interactive FZF menu (default if no command)
  select              Select files to backup (replaces existing list)
  add                 Add files to backup list (append)
  remove              Remove files from backup list
  backup              Backup changed files (incremental)
  verify              Verify backup integrity
  history             Show backup history
  status              Show current backup status

Options:
  -p, --password PWD  Transcrypt password (interactive if not provided)
  -r, --reconfigure   Force file selection reconfiguration
  --dry-run          Preview without making changes
  --path PATH        Add custom path to backup list

Examples:
  keys-backup                              # Interactive menu (default)
  keys-backup select                       # Select files (scans ~/.ssh, ~/.gnupg, ~/.config/age)
  keys-backup add                          # Add more files to backup list
  keys-backup remove                       # Remove files from backup list
  keys-backup backup                       # Backup changed files
  keys-backup verify                       # Verify integrity
  keys-backup status                       # Show status

Supported Directories:
  - ~/.ssh               SSH keys
  - ~/.gnupg             GPG keys
  - ~/.config/age        Age encryption keys
  - Custom paths via "⊕ Add custom file..." in FZF menu

Status Indicators:
  ${GREEN}✓${NC}  Up to date (backed up, no changes)
  ${YELLOW}⚠${NC}  Modified (backed up but changed since)
  ${CYAN}⊕${NC}  New file (not in backup list)
  ${RED}⊗${NC}  Removed (was backed up, now excluded)
  ${GRAY}○${NC}  Available (not selected)

EOF
}

# Command: status - Show current backup status
cmd_status() {
    require_cmd git transcrypt jq || exit 1

    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}SSH Keys Backup Status${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""

    # Repository status
    if [[ -d "$REPO_DIR/.git" ]]; then
        echo -e "${GREEN}✓${NC} Repository: ${REPO_DIR}"
        cd "$REPO_DIR"

        local remote_url
        remote_url=$(git remote get-url origin 2>/dev/null || echo "N/A")
        echo "  Remote: $remote_url"

        local last_commit
        last_commit=$(git log -1 --format="%h - %s (%ar)" 2>/dev/null || echo "N/A")
        echo "  Last commit: $last_commit"
    else
        echo -e "${YELLOW}⚠${NC} Repository not initialized"
        echo "  Run 'keys-backup backup' to initialize"
        return 0
    fi

    # Metadata status
    if [[ -f "$METADATA_FILE" ]]; then
        local version file_count
        version=$(jq -r '.version // 1' "$METADATA_FILE")
        file_count=$(jq '.files | length' "$METADATA_FILE")
        echo -e "${GREEN}✓${NC} Metadata: v$version ($file_count files tracked)"
    else
        echo -e "${YELLOW}⚠${NC} Metadata not initialized (legacy v1)"
    fi

    # Backup list
    if [[ -f "$BACKUP_LIST" ]]; then
        local selected_count
        selected_count=$(wc -l < "$BACKUP_LIST" | tr -d ' ')
        echo -e "${GREEN}✓${NC} Backup list: $selected_count files selected"
    else
        echo -e "${YELLOW}⚠${NC} No backup list"
        return 0
    fi

    # File status
    echo ""
    echo -e "${BLUE}File Status:${NC}"
    echo ""

    local total=0 unchanged=0 modified=0 new=0 missing=0

    while IFS= read -r file; do
        ((total++))
        local status
        status=$(get_file_status "$file")

        if [[ ! -f "$file" ]]; then
            echo -e "  ${RED}⊗${NC} Missing: $file"
            ((missing++))
        elif [[ "$status" == *"✓"* ]]; then
            echo -e "  ${GREEN}✓${NC} $(basename "$file")"
            ((unchanged++))
        elif [[ "$status" == *"⚠"* ]]; then
            echo -e "  ${YELLOW}⚠${NC} Modified: $(basename "$file")"
            ((modified++))
        else
            echo -e "  ${CYAN}⊕${NC} New: $(basename "$file")"
            ((new++))
        fi
    done < "$BACKUP_LIST"

    echo ""
    echo "Summary: $total total, $unchanged unchanged, $modified modified, $new new, $missing missing"
    echo ""

    if [[ $modified -gt 0 ]] || [[ $new -gt 0 ]]; then
        echo -e "${YELLOW}→ Run 'keys-backup backup' to backup changes${NC}"
    else
        echo -e "${GREEN}→ All files up to date${NC}"
    fi
    echo ""
}

# Command: select - Interactive file selection with FZF (replaces list)
cmd_select() {
    require_cmd fzf || exit 1

    echo -e "${BLUE}Select files to backup with FZF${NC}"
    echo -e "${GRAY}(Tab: multi-select, Ctrl-A: all, ESC: cancel)${NC}"
    echo ""

    # Show current list if exists
    if [[ -f "$BACKUP_LIST" ]]; then
        local current_count
        current_count=$(wc -l < "$BACKUP_LIST" | tr -d ' ')
        echo -e "${YELLOW}⚠${NC} This will replace current backup list ($current_count files)"
        echo ""
    fi

    local selected
    selected=$(fzf_select_files "Select files to backup (will REPLACE current list)") || {
        echo -e "${YELLOW}Selection cancelled - no changes made${NC}"
        return 1  # Exit with error code
    }

    if [[ -z "$selected" ]]; then
        echo -e "${YELLOW}No files selected - aborting${NC}"
        return 1  # Exit with error code
    fi

    # Initialize repo if needed
    init_repo_if_needed || exit 1
    cd "$REPO_DIR"

    # Save selection (overwrites existing list)
    echo "$selected" > "$BACKUP_LIST"

    local count
    count=$(echo "$selected" | wc -l | tr -d ' ')
    echo -e "${GREEN}✓${NC} Selected $count files (replaced backup list)"
    echo ""
    echo "$selected" | sed 's/^/  /'
    echo ""

    # Commit backup list
    if git diff --quiet backup-list.txt 2>/dev/null; then
        echo "No changes to backup list"
    else
        git add backup-list.txt
        git commit -m "Update backup list - $count files"
        git push
        log_event "Updated backup list: $count files"
    fi
}

# Command: add - Add files to backup list (append)
cmd_add() {
    require_cmd fzf || exit 1

    # Initialize repo if needed
    init_repo_if_needed || exit 1
    cd "$REPO_DIR"

    # Load current list
    local current_files=()
    if [[ -f "$BACKUP_LIST" ]]; then
        mapfile -t current_files < "$BACKUP_LIST"
        echo -e "${BLUE}Current backup list: ${#current_files[@]} files${NC}"
        echo ""
    else
        echo -e "${BLUE}No existing backup list - selecting from all files${NC}"
        echo ""
    fi

    # Build list of files NOT in current backup list
    local available_files=()
    while IFS= read -r file; do
        local is_in_list=false
        for current_file in "${current_files[@]}"; do
            if [[ "$file" == "$current_file" ]]; then
                is_in_list=true
                break
            fi
        done
        [[ "$is_in_list" == false ]] && available_files+=("$file")
    done < <(discover_key_files)

    if [[ ${#available_files[@]} -eq 0 ]]; then
        echo -e "${GREEN}✓${NC} All SSH files are already in backup list"
        return 0
    fi

    echo -e "${CYAN}Available files to add: ${#available_files[@]}${NC}"
    echo -e "${GRAY}(Tab: multi-select, ESC: cancel)${NC}"
    echo ""

    # FZF to select files to add
    local to_add
    to_add=$(printf '%s\n' "${available_files[@]}" | fzf --multi \
        --height=80% \
        --border=rounded \
        --header="Select files to ADD to backup list" \
        --preview="$FILE_PREVIEW" \
        --preview-window='right:50%:wrap:border-left' \
        --bind='ctrl-a:select-all') || {
        echo -e "${YELLOW}Selection cancelled${NC}"
        return 1
    }

    if [[ -z "$to_add" ]]; then
        echo -e "${YELLOW}No files selected${NC}"
        return 1
    fi

    # Append to backup list
    echo "$to_add" >> "$BACKUP_LIST"
    sort -u "$BACKUP_LIST" -o "$BACKUP_LIST"  # Remove duplicates and sort

    local added_count
    added_count=$(echo "$to_add" | wc -l | tr -d ' ')
    echo -e "${GREEN}✓${NC} Added $added_count files to backup list"
    echo ""
    echo "$to_add" | sed 's/^/  /'
    echo ""

    # Commit changes
    if git diff --quiet backup-list.txt 2>/dev/null; then
        echo "No changes to commit"
    else
        git add backup-list.txt
        git commit -m "Add $added_count files to backup list"
        git push
        log_event "Added $added_count files to backup list"
    fi
}

# Command: remove - Remove files from backup list
cmd_remove() {
    require_cmd fzf || exit 1

    # Initialize repo if needed
    init_repo_if_needed || exit 1
    cd "$REPO_DIR"

    if [[ ! -f "$BACKUP_LIST" ]] || [[ ! -s "$BACKUP_LIST" ]]; then
        echo -e "${YELLOW}Backup list is empty${NC}"
        return 1
    fi

    local current_count
    current_count=$(wc -l < "$BACKUP_LIST" | tr -d ' ')
    echo -e "${BLUE}Current backup list: $current_count files${NC}"
    echo -e "${GRAY}(Tab: multi-select, ESC: cancel)${NC}"
    echo ""

    # FZF to select files to remove
    local to_remove
    to_remove=$(cat "$BACKUP_LIST" | fzf --multi \
        --height=80% \
        --border=rounded \
        --header="Select files to REMOVE from backup list" \
        --preview="
            file={}
            echo -e \"\033[1;31m━━━ WILL BE REMOVED ━━━\033[0m\"
            echo \"\"
            echo \"Path: \$file\"
            if [[ -f \"\$file\" ]]; then
                echo \"Status: Exists\"
            else
                echo \"Status: Missing\"
            fi
        " \
        --preview-window='right:50%:wrap' \
        --bind='ctrl-a:select-all') || {
        echo -e "${YELLOW}Selection cancelled${NC}"
        return 1
    }

    if [[ -z "$to_remove" ]]; then
        echo -e "${YELLOW}No files selected${NC}"
        return 1
    fi

    # Confirm removal
    local remove_count
    remove_count=$(echo "$to_remove" | wc -l | tr -d ' ')
    echo -e "${RED}Will remove $remove_count files from backup list:${NC}"
    echo ""
    echo "$to_remove" | sed 's/^/  /'
    echo ""
    read -p "Confirm removal? (y/N): " confirm
    if [[ "$confirm" != "y" ]]; then
        echo "Cancelled"
        return 1
    fi

    # Remove from backup list
    local tmp
    tmp=$(mktemp)
    while IFS= read -r line; do
        local should_keep=true
        while IFS= read -r remove_line; do
            if [[ "$line" == "$remove_line" ]]; then
                should_keep=false
                break
            fi
        done <<< "$to_remove"
        [[ "$should_keep" == true ]] && echo "$line"
    done < "$BACKUP_LIST" > "$tmp"
    mv "$tmp" "$BACKUP_LIST"

    echo -e "${GREEN}✓${NC} Removed $remove_count files from backup list"
    echo ""

    local remaining
    remaining=$(wc -l < "$BACKUP_LIST" | tr -d ' ')
    echo "Remaining files: $remaining"
    echo ""

    # Commit changes
    if git diff --quiet backup-list.txt 2>/dev/null; then
        echo "No changes to commit"
    else
        git add backup-list.txt
        git commit -m "Remove $remove_count files from backup list"
        git push
        log_event "Removed $remove_count files from backup list"
    fi
}

# Command: backup - Backup changed files (always incremental)
cmd_backup() {
    local dry_run=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            --verify) VERIFY_AFTER_BACKUP=true; shift ;;
            *) shift ;;
        esac
    done

    require_cmd git transcrypt jq || exit 1

    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}Keys Backup (Incremental)${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""

    # Initialize repo
    init_repo_if_needed || exit 1
    cd "$REPO_DIR"

    # Initialize metadata if needed
    [[ ! -f "$METADATA_FILE" ]] && init_metadata

    # Check backup list exists
    if [[ ! -f "$BACKUP_LIST" ]]; then
        echo -e "${YELLOW}No backup list found${NC}"
        echo ""
        echo "First time setup: Select files to backup"
        echo ""
        cmd_select
        [[ ! -f "$BACKUP_LIST" ]] && { echo "No files selected, aborting"; exit 0; }
    fi

    # Show backup list
    echo "[1/5] Files in backup list:"
    echo ""
    while IFS= read -r file; do
        local status
        status=$(get_file_status "$file")
        printf "  %b %s\n" "$status" "$(basename "$file")"
    done < "$BACKUP_LIST"
    echo ""

    # Detect changes
    echo "[2/5] Detecting changes..."
    local changed_files=()
    local total_files=0

    while IFS= read -r file; do
        ((total_files++))
        if [[ ! -f "$file" ]]; then
            echo -e "  ${RED}✗${NC} Missing: $file"
            continue
        fi

        if detect_changes "$file"; then
            changed_files+=("$file")
            echo -e "  ${YELLOW}⚠${NC} Changed: $(basename "$file")"
        fi
    done < "$BACKUP_LIST"

    if [[ ${#changed_files[@]} -eq 0 ]]; then
        echo -e "${GREEN}✓${NC} No changes to backup (all files up to date)"
        return 0
    fi

    echo ""
    echo "Detected: ${#changed_files[@]} of $total_files files changed"
    echo ""

    if [[ "$dry_run" == true ]]; then
        echo "Dry run mode - files that would be backed up:"
        printf '%s\n' "${changed_files[@]}" | sed 's/^/  /'
        return 0
    fi

    # Backup files
    echo "[3/5] Backing up files..."
    for file in "${changed_files[@]}"; do
        if backup_file "$file"; then
            update_file_metadata "$file"
            echo -e "  ${GREEN}✓${NC} $(basename "$file")"
        else
            echo -e "  ${RED}✗${NC} Failed: $(basename "$file")"
        fi
    done

    # Commit changes
    echo ""
    echo "[4/5] Committing to git..."
    git add ssh-keys/ backup-list.txt backup-metadata.json

    if git diff --cached --quiet; then
        echo "  No changes to commit"
    else
        local commit_msg
        if [[ "$force" == true ]]; then
            commit_msg="Force backup: ${#changed_files[@]} files - $(date '+%Y-%m-%d %H:%M:%S')"
        else
            commit_msg="Backup: ${#changed_files[@]} files - $(date '+%Y-%m-%d %H:%M:%S')"
        fi
        git commit -m "$commit_msg"
        log_event "$commit_msg"

        echo "[5/5] Pushing to remote..."
        git push
    fi

    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}✅ Backup Complete${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Backed up ${#changed_files[@]} changed files"
    echo "Repository: $KEYS_REPO"
    echo "Local copy: $REPO_DIR"
    echo ""

    # Verify if requested
    if [[ "${VERIFY_AFTER_BACKUP:-false}" == true ]]; then
        echo "Verifying backup..."
        cmd_verify
    fi
}

# Command: verify - Verify backup integrity
cmd_verify() {
    require_cmd git transcrypt || exit 1

    [[ ! -d "$REPO_DIR/.git" ]] && {
        echo -e "${RED}Error:${NC} Repository not initialized"
        return 1
    }

    [[ ! -f "$BACKUP_LIST" ]] && {
        echo -e "${RED}Error:${NC} No backup list found"
        return 1
    }

    cd "$REPO_DIR"

    echo -e "${BLUE}Verifying backup integrity...${NC}"
    echo ""

    local errors=0
    local verified=0

    while IFS= read -r file; do
        local filename
        filename=$(basename "$file")

        if [[ ! -f "$file" ]]; then
            echo -e "${YELLOW}⚠${NC} Local file missing: $file"
            continue
        fi

        if [[ ! -f "ssh-keys/$filename" ]]; then
            echo -e "${RED}✗${NC} Not in backup: $filename"
            ((errors++))
            continue
        fi

        if verify_file "$file"; then
            echo -e "${GREEN}✓${NC} OK: $filename"
            ((verified++))
        else
            echo -e "${RED}✗${NC} Mismatch: $filename"
            ((errors++))
        fi
    done < "$BACKUP_LIST"

    echo ""
    if [[ $errors -eq 0 ]]; then
        echo -e "${GREEN}✅ All $verified files verified${NC}"
        return 0
    else
        echo -e "${RED}❌ $errors verification failures${NC}"
        return 1
    fi
}

# Command: history - Show backup history
cmd_history() {
    [[ ! -f "$HISTORY_LOG" ]] && {
        echo "No history available"
        return 0
    }

    echo -e "${BLUE}Backup History${NC}"
    echo ""
    tail -n 20 "$HISTORY_LOG"
    echo ""
}

# Command: menu - Interactive FZF menu
cmd_menu() {
    require_cmd fzf || {
        echo -e "${YELLOW}FZF not found, showing status instead${NC}"
        cmd_status
        return 0
    }

    while true; do
        local selected
        selected=$(cat << 'MENU' | fzf --ansi \
            --height=60% \
            --border=rounded \
            --header="SSH Keys Backup Manager" \
            --preview='
                cmd=$(echo {} | awk "{print \$1}")
                echo -e "\033[1;34m━━━ $cmd ━━━\033[0m"
                echo ""
                case "$cmd" in
                    select)
                        echo "Select files to backup (REPLACE list)"
                        echo ""
                        echo "Features:"
                        echo "  • Rich preview (metadata, key type, content)"
                        echo "  • Status indicators (✓ ⚠ ⊕ ⊗)"
                        echo "  • Multi-select (Tab/Ctrl-A)"
                        echo ""
                        echo "⚠ This REPLACES current backup list"
                        ;;
                    add)
                        echo "Add files to backup list (APPEND)"
                        echo ""
                        echo "Features:"
                        echo "  • Shows only files NOT in current list"
                        echo "  • Appends to existing list"
                        echo "  • Multi-select support"
                        ;;
                    remove)
                        echo "Remove files from backup list"
                        echo ""
                        echo "Features:"
                        echo "  • Shows current backup list"
                        echo "  • Multi-select for removal"
                        echo "  • Confirmation required"
                        ;;
                    backup)
                        echo "Backup files to encrypted repository"
                        echo ""
                        echo "Incremental backup:"
                        echo "  • Auto-detects changes (SHA256)"
                        echo "  • Only backs up modified files"
                        echo "  • First backup backs up everything"
                        ;;
                    verify)
                        echo "Verify backup integrity"
                        echo ""
                        echo "Checks SHA256 checksums:"
                        echo "  • Local files vs backup"
                        echo "  • Reports mismatches"
                        ;;
                    history)
                        echo "Show backup event history"
                        echo ""
                        echo "Displays last 20 backup events"
                        ;;
                    status)
                        echo "Show current backup status"
                        echo ""
                        echo "Displays:"
                        echo "  • Repository info"
                        echo "  • Metadata version"
                        echo "  • File status summary"
                        ;;
                esac
                echo ""
                echo -e "\033[1;34m━━━ Quick Status ━━━\033[0m"
                echo ""
                if [[ -d "$HOME/.local/share/keys-backup/.git" ]]; then
                    cd "$HOME/.local/share/keys-backup"
                    echo "Repository: $(git remote get-url origin 2>/dev/null || echo "N/A")"
                    echo "Last commit: $(git log -1 --format="%ar" 2>/dev/null || echo "N/A")"
                    if [[ -f "$HOME/.local/share/keys-backup/backup-list.txt" ]]; then
                        echo "Files: $(wc -l < "$HOME/.local/share/keys-backup/backup-list.txt" | tr -d " ") selected"
                    fi
                else
                    echo "⚠ Not initialized"
                    echo "Run backup to initialize"
                fi
            ' \
            --preview-window='right:50%:wrap' \
            --preview-label="[ Keys Backup Manager ]"
select         Select files (replace list)
add            Add files (append to list)
remove         Remove files from list
backup         Backup changed files
verify         Verify backup integrity
history        Show backup history
status         Show current status
MENU
        ) || return 0

        local cmd
        cmd=$(echo "$selected" | awk '{print $1}')

        echo ""
        case "$cmd" in
            select)
                cmd_select
                ;;
            add)
                cmd_add
                ;;
            remove)
                cmd_remove
                ;;
            backup)
                cmd_backup
                ;;
            verify)
                cmd_verify
                ;;
            history)
                cmd_history
                ;;
            status)
                cmd_status
                ;;
            *)
                echo "Unknown command: $cmd"
                ;;
        esac

        echo ""
        read -p "Press Enter to continue..." || return 0
    done
}

# ===== Main Entry Point =====

main() {
    local cmd="${1:-}"
    shift || true

    # Global options
    TRANSCRYPT_PASSWORD=""
    RECONFIGURE=false
    CUSTOM_PATH=""

    # Parse global options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -p|--password)
                TRANSCRYPT_PASSWORD="$2"
                shift 2
                ;;
            -r|--reconfigure)
                RECONFIGURE=true
                shift
                ;;
            --path)
                CUSTOM_PATH="$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    # Handle custom path
    if [[ -n "$CUSTOM_PATH" ]]; then
        if [[ -f "$CUSTOM_PATH" ]]; then
            init_repo_if_needed || exit 1
            echo "$CUSTOM_PATH" >> "$BACKUP_LIST"
            sort -u "$BACKUP_LIST" -o "$BACKUP_LIST"
            echo -e "${GREEN}✓${NC} Added: $CUSTOM_PATH"
        else
            echo -e "${RED}Error:${NC} File not found: $CUSTOM_PATH"
            exit 1
        fi
        exit 0
    fi

    # Route commands
    case "$cmd" in
        select)
            cmd_select "$@"
            ;;
        add)
            cmd_add "$@"
            ;;
        remove)
            cmd_remove "$@"
            ;;
        backup)
            cmd_backup "$@"
            ;;
        verify)
            cmd_verify "$@"
            ;;
        history)
            cmd_history "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        menu)
            cmd_menu
            ;;
        "")
            # No command - show interactive menu
            cmd_menu
            ;;
        *)
            echo -e "${RED}Error:${NC} Unknown command: $cmd"
            echo "Run 'keys-backup --help' for usage"
            exit 1
            ;;
    esac
}

main "$@"
