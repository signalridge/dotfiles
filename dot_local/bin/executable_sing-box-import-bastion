#!/usr/bin/env bash
# Import a bastion proxy client into gopass as a sing-box outbound.
#
# The bastion's vps-client issues each device a Surge-format profile
# (/etc/vps-proxy/clients/<name>.conf): a `vmess` proxy over WebSocket + TLS
# with a client certificate (Caddy mTLS) kept as PKCS#12 in [Keystore]. This
# converts that profile into one sing-box vmess outbound (tag "bastion", client
# certificate as PEM) and stores it as gopass sing-box/bastion-outbound, which
# the sing-box config template (.chezmoitemplates/sing-box/config.tmpl) adds to
# the Exit selector on every machine. Nothing secret is printed.
#
# Usage:
#   ssh bastion cat /etc/vps-proxy/clients/<name>.conf | sing-box-import-bastion
#   sing-box-import-bastion <surge-profile.conf>
# Stored as one line of JSON (`gopass show -o` returns the first line only).
# Then `chezmoi apply` (and on a work/home Mac the 25_sing-box script) to roll
# it out. Re-run after `vps-client rotate <name>` on the bastion.

set -euo pipefail

die() {
    echo "sing-box-import-bastion: $*" >&2
    exit 1
}

for cmd in awk base64 gopass jq openssl; do
    command -v "$cmd" >/dev/null 2>&1 || die "$cmd not found"
done

conf="$(cat "${1:-/dev/stdin}")"

section() {
    printf '%s\n' "$conf" | awk -v s="[$1]" '$0 == s { f = 1; next } /^\[/ { f = 0 } f && NF && $0 !~ /^[[:space:]]*#/'
}

# `key = value` pairs of one comma-separated Surge line, from field $2 on,
# as "key<TAB>value" with surrounding blanks and quotes removed.
fields() {
    printf '%s\n' "$1" | awk -v from="$2" '{
        n = split($0, parts, ",")
        for (i = from; i <= n; i++) {
            kv = parts[i]
            eq = index(kv, "=")
            if (eq == 0) continue
            k = substr(kv, 1, eq - 1); v = substr(kv, eq + 1)
            gsub(/^[ \t"]+|[ \t"]+$/, "", k); gsub(/^[ \t"]+|[ \t"]+$/, "", v)
            print k "\t" v
        }
    }'
}

field() { printf '%s\n' "$1" | awk -F '\t' -v k="$2" '$1 == k { print $2; exit }'; }

proxy="$(section Proxy | awk '/=[ \t]*vmess[ \t]*,/ { print; exit }')"
[[ -n "$proxy" ]] || die "no vmess proxy in [Proxy]"
# name = vmess, host, port, key=value...
host="$(printf '%s\n' "$proxy" | awk -F ',' '{ gsub(/[ \t]/, "", $2); print $2 }')"
port="$(printf '%s\n' "$proxy" | awk -F ',' '{ gsub(/[ \t]/, "", $3); print $3 }')"
kv="$(fields "$proxy" 4)"
uuid="$(field "$kv" username)"
ws_path="$(field "$kv" ws-path)"
ws_headers="$(field "$kv" ws-headers)"
sni="$(field "$kv" sni)"
cert_id="$(field "$kv" client-cert)"
[[ -n "$host" && "$port" =~ ^[0-9]+$ && -n "$uuid" && -n "$ws_path" && -n "$cert_id" ]] ||
    die "vmess proxy lacks host, port, username, ws-path or client-cert"
[[ "$(field "$kv" tls)" == true && "$(field "$kv" ws)" == true ]] || die "expected ws=true and tls=true"

keystore="$(section Keystore | awk -v id="$cert_id" 'index($0, id) == 1 { sub(/^[^=]*=/, ""); print; exit }')"
[[ -n "$keystore" ]] || die "client-cert ${cert_id} not found in [Keystore]"
ks="$(fields "$keystore" 1)"
p12_b64="$(field "$ks" base64)"
P12_PASS="$(field "$ks" password)"
export P12_PASS
[[ -n "$p12_b64" ]] || die "keystore entry has no base64 PKCS#12"

tmp="$(mktemp -d)"
trap 'rm -f "$tmp"/*; rmdir "$tmp"' EXIT
umask 077
printf '%s' "$p12_b64" | base64 -d >"$tmp/client.p12"
pkcs12() {
    openssl pkcs12 -in "$tmp/client.p12" -passin env:P12_PASS "$@" 2>/dev/null ||
        openssl pkcs12 -legacy -in "$tmp/client.p12" -passin env:P12_PASS "$@" 2>/dev/null
}
pkcs12 -clcerts -nokeys -out "$tmp/cert.pem" || die "cannot read the client certificate"
pkcs12 -nocerts -nodes -out "$tmp/key.pem" || die "cannot read the client key"
# Keep only the PEM blocks (openssl prefixes "Bag Attributes" text).
awk '/-----BEGIN/,/-----END/' "$tmp/cert.pem" >"$tmp/cert"
awk '/-----BEGIN/,/-----END/' "$tmp/key.pem" >"$tmp/key"
if ! grep -q 'BEGIN CERTIFICATE' "$tmp/cert" || ! grep -q 'PRIVATE KEY' "$tmp/key"; then
    die "unexpected PKCS#12 contents"
fi

# ws-headers: Name:value|Name:"value" (Surge allows quoted values)
headers="$(printf '%s' "$ws_headers" | jq -R 'split("|") | map(select(length > 0) | capture("^(?<k>[^:]+):(?<v>.*)$")) | map({(.k | gsub("[\" ]"; "")): (.v | gsub("^[\" ]+|[\" ]+$"; ""))}) | add // {}')"

jq -cn \
    --arg host "$host" --argjson port "$port" --arg uuid "$uuid" \
    --arg path "$ws_path" --argjson headers "$headers" --arg sni "${sni:-$host}" \
    --rawfile cert "$tmp/cert" --rawfile key "$tmp/key" '{
      type: "vmess", tag: "bastion",
      server: $host, server_port: $port,
      uuid: $uuid, security: "auto", alter_id: 0,
      transport: {type: "ws", path: $path, headers: $headers},
      tls: {
        enabled: true, server_name: $sni,
        client_certificate: ($cert | rtrimstr("\n") | split("\n")),
        client_key: ($key | rtrimstr("\n") | split("\n"))
      }
    }' >"$tmp/outbound.json"

gopass insert -f -m sing-box/bastion-outbound <"$tmp/outbound.json" >/dev/null
echo "Stored gopass sing-box/bastion-outbound (vmess ws+tls, client certificate); run chezmoi apply to roll it out."
