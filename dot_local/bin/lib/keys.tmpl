#!/usr/bin/env bash
# SSH Keys Backup/Restore Shared Library
# Common functions for keys-backup and keys-restore
#
# Usage: source lib/keys.tmpl

# Source common library
source "$(dirname "${BASH_SOURCE[0]}")/common"

# ===== Constants =====

# Paths from chezmoi data
KEYS_REPO="{{ .keysRepository }}"
REPO_DIR="$HOME/.local/share/keys-backup"
BACKUP_LIST="$REPO_DIR/backup-list.txt"
METADATA_FILE="$REPO_DIR/backup-metadata.json"
HISTORY_LOG="$REPO_DIR/backup-history.log"

VERSION=2

# ===== Utility Functions =====

# Log event to history
log_event() {
    local event="$1"
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    echo "[$timestamp] $event" >> "$HISTORY_LOG"
}

# ===== File Discovery & Filtering =====

# Discover key/certificate files from common directories
discover_key_files() {
    # Common directories for keys and certificates
    local key_dirs=(
        "$HOME/.ssh"           # SSH keys
        "$HOME/.gnupg"         # GPG keys
        "$HOME/.config/age"    # Age encryption keys
    )

    for dir in "${key_dirs[@]}"; do
        [[ ! -d "$dir" ]] && continue

        find "$dir" -type f -print0 2>/dev/null | while IFS= read -r -d $'\0' file; do
            # Skip public keys, known_hosts, authorized_keys
            [[ ! "$file" =~ \.pub$ ]] && \
            [[ ! "$file" =~ known_hosts ]] && \
            [[ ! "$file" =~ authorized_keys ]] && \
            [[ ! "$file" =~ \.lock$ ]] && \
            echo "$file"
        done
    done | sort -u  # Remove duplicates and sort
}

# Get key type from file
detect_key_type() {
    local file="$1"
    [[ ! -f "$file" ]] && { echo "unknown"; return; }

    local first_line
    first_line=$(head -n1 "$file" 2>/dev/null)

    # Use variables to avoid chezmoi template parsing issues
    local openssh_key="BEGIN OPENSSH PRIVATE""KEY"
    local rsa_key="BEGIN RSA PRIVATE""KEY"
    local ec_key="BEGIN EC PRIVATE""KEY"
    local dsa_key="BEGIN DSA PRIVATE""KEY"

    case "$first_line" in
        *"$openssh_key"*)
            if grep -q "ssh-ed25519" "$file"; then
                echo "Ed25519"
            elif grep -q "ecdsa" "$file"; then
                echo "ECDSA"
            else
                echo "OpenSSH"
            fi
            ;;
        *"$rsa_key"*) echo "RSA" ;;
        *"$ec_key"*) echo "ECDSA" ;;
        *"$dsa_key"*) echo "DSA" ;;
        "Host "*) echo "SSH Config" ;;
        *) echo "unknown" ;;
    esac
}

# ===== Checksum & Change Detection =====

# Detect if file has changed since last backup
detect_changes() {
    local file="$1"
    [[ ! -f "$file" ]] && return 0  # Missing file = changed
    [[ ! -f "$METADATA_FILE" ]] && return 0  # No metadata = changed

    local stored_hash
    stored_hash=$(jq -r ".files[\"$file\"].sha256 // empty" "$METADATA_FILE" 2>/dev/null)
    [[ -z "$stored_hash" ]] && return 0  # Not in metadata = new file

    local current_hash
    current_hash=$(calc_checksum "$file")
    [[ "$current_hash" != "$stored_hash" ]]
}

# Get file status (for display)
get_file_status() {
    local file="$1"
    local backed_up=false

    # Check if in backup list
    if [[ -f "$BACKUP_LIST" ]] && grep -qxF "$file" "$BACKUP_LIST"; then
        backed_up=true
    fi

    if [[ "$backed_up" == true ]]; then
        if detect_changes "$file"; then
            echo "${YELLOW}⚠${NC}"  # Modified
        else
            echo "${GREEN}✓${NC}"  # Up to date
        fi
    else
        if [[ -f "$METADATA_FILE" ]] && jq -e ".files[\"$file\"] // empty" "$METADATA_FILE" &>/dev/null; then
            echo "${RED}⊗${NC}"  # Removed from list
        else
            echo "${CYAN}⊕${NC}"  # New file
        fi
    fi
}

# ===== Metadata Management =====

# Initialize metadata file
init_metadata() {
    cat > "$METADATA_FILE" <<'EOF'
{
  "version": 2,
  "filters": {
    "include_patterns": ["*"],
    "exclude_patterns": ["*.pub", "known_hosts*", "authorized_keys*"],
    "custom_paths": []
  },
  "files": {}
}
EOF
    log_event "Initialized metadata v2"
}

# Update file metadata after backup
update_file_metadata() {
    local file="$1"
    [[ ! -f "$file" ]] && return 1
    [[ ! -f "$METADATA_FILE" ]] && init_metadata

    local hash size mtime now count
    hash=$(calc_checksum "$file")
    size=$(get_file_size "$file")
    mtime=$(get_file_mtime "$file")

    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    count=$(jq -r ".files[\"$file\"].backup_count // 0" "$METADATA_FILE")
    ((count++))

    local tmp
    tmp=$(mktemp)
    jq ".files[\"$file\"] = {
        \"sha256\": \"$hash\",
        \"size\": $size,
        \"mtime\": $mtime,
        \"last_backup\": \"$now\",
        \"backup_count\": $count
    }" "$METADATA_FILE" > "$tmp"
    mv "$tmp" "$METADATA_FILE"
}

# Get file metadata from JSON
get_file_info() {
    local file="$1"
    local field="$2"
    [[ ! -f "$METADATA_FILE" ]] && return 1
    jq -r ".files[\"$file\"].$field // empty" "$METADATA_FILE"
}

# ===== FZF Builders =====

# Build file list with status indicators
build_file_list_with_status() {
    while IFS= read -r file; do
        local status
        status=$(get_file_status "$file")
        printf "%b %s\n" "$status" "$file"
    done < <(discover_key_files)
}

# FZF file preview script
FILE_PREVIEW='
    line=$(echo {} | sed "s/^[[:space:]]*//" | sed "s/^[✓⚠⊕⊗○] //")
    file="$line"

    # Special handling for "Add custom file..." option
    if echo "$line" | grep -q "Add custom file"; then
        echo -e "\033[1;34m━━━ Add Custom File ━━━\033[0m"
        echo ""
        echo "Select this option to add a file from any location."
        echo ""
        echo -e "\033[1;33mHow it works:\033[0m"
        echo "1. Select this option (press Enter)"
        echo "2. You will be prompted to enter a file path"
        echo "3. Path can include ~ for home directory"
        echo "4. File will be validated before adding"
        echo ""
        echo -e "\033[1;33mExample paths:\033[0m"
        echo "  ~/Documents/private-key.pem"
        echo "  /etc/ssl/private/cert.key"
        echo "  ~/.config/app/secret.key"
        echo ""
        echo -e "\033[1;36mTip: You can select multiple files by using Tab,\033[0m"
        echo -e "\033[1;36mthen select this option to add custom files too.\033[0m"
        exit 0
    fi

    echo -e "\033[1;34m━━━ File Info ━━━\033[0m"
    echo ""
    echo "Path: $file"

    if [[ -f "$file" ]]; then
        # File metadata
        if stat -f%z "$file" &>/dev/null 2>&1; then
            # macOS
            size=$(stat -f%z "$file")
            mtime=$(stat -f%Sm -t "%Y-%m-%d %H:%M:%S" "$file")
            perms=$(stat -f%Sp "$file")
        else
            # Linux
            size=$(stat -c%s "$file")
            mtime=$(stat -c%y "$file" | cut -d. -f1)
            perms=$(stat -c%A "$file")
        fi
        echo "Size: $size bytes"
        echo "Modified: $mtime"
        echo "Permissions: $perms"

        # Key type detection
        keytype=$('"$(declare -f detect_key_type)"'; detect_key_type "$file")
        echo "Type: $keytype"

        # Show backup status if metadata exists
        meta_file="'"$METADATA_FILE"'"
        if [[ -f "$meta_file" ]]; then
            last_backup=$(jq -r ".files[\"$file\"].last_backup // empty" "$meta_file" 2>/dev/null)
            backup_count=$(jq -r ".files[\"$file\"].backup_count // 0" "$meta_file" 2>/dev/null)
            if [[ -n "$last_backup" ]]; then
                echo ""
                echo -e "\033[1;34m━━━ Backup Info ━━━\033[0m"
                echo "Last backup: $last_backup"
                echo "Backup count: $backup_count"
            fi
        fi

        # Preview first 10 lines
        echo ""
        echo -e "\033[1;34m━━━ Preview ━━━\033[0m"
        head -n 10 "$file" 2>/dev/null || echo "(binary or unreadable)"
    else
        echo ""
        echo -e "\033[0;31m✗ File not found\033[0m"
    fi
'

# FZF file selector with status (supports custom file input)
fzf_select_files() {
    local header="${1:-Select files to backup}"

    # Build list with special "Add custom file" option at top
    local file_list
    file_list=$({
        echo -e "${CYAN}⊕ Add custom file...${NC}"
        build_file_list_with_status
    })

    local selected
    selected=$(echo "$file_list" | fzf --ansi --multi \
        --height=80% \
        --border=rounded \
        --header="$header | Tab: multi-select | Select '⊕ Add custom file...' to enter path" \
        --preview="$FILE_PREVIEW" \
        --preview-window='right:50%:wrap:border-left' \
        --preview-label="[File Preview - Ctrl-/: toggle]" \
        --bind='ctrl-a:select-all' \
        --bind='ctrl-d:deselect-all' \
        --bind='ctrl-r:reload(echo -e "'"${CYAN}⊕ Add custom file...${NC}"'"; '"$(declare -f build_file_list_with_status)"'; build_file_list_with_status)' \
        --bind='ctrl-/:toggle-preview') || return 1

    # Process selection
    local final_selection=""
    while IFS= read -r line; do
        # Check if it's the "Add custom file" option
        if echo "$line" | grep -q "Add custom file"; then
            # Prompt for custom file path (can add multiple files)
            echo ""
            log_section "Add Custom Files"
            echo "Enter file paths one at a time (press Enter with empty input to finish)"
            echo ""

            while true; do
                local custom_path
                echo -ne "${CYAN}File path${NC} (or Enter to finish): "
                # Read from terminal explicitly (FZF consumed stdin)
                read -r -e custom_path < /dev/tty

                # Empty input = done
                [[ -z "$custom_path" ]] && break

                # Expand tilde
                custom_path="${custom_path/#\~/$HOME}"

                # Validate file exists
                if [[ -f "$custom_path" ]]; then
                    echo -e "  ${GREEN}✓ Added:${NC} $custom_path"
                    final_selection+="$custom_path"$'\n'
                else
                    echo -e "  ${RED}✗ Not found:${NC} $custom_path"
                    echo -e "  ${YELLOW}Tip:${NC} Use absolute path or ~ for home directory"
                fi
                echo ""
            done

            echo -e "${GRAY}Custom file input complete${NC}"
        else
            # Regular file selection
            local cleaned
            cleaned=$(echo "$line" | sed 's/^[[:space:]]*//' | sed 's/^[✓⚠⊕⊗○] //')
            final_selection+="$cleaned"$'\n'
        fi
    done <<< "$selected"

    # Return final selection (remove trailing newline)
    echo -n "${final_selection%$'\n'}"
}

# ===== Git Operations =====

# Check git sync status with remote
# Returns: 0=in sync, 1=ahead, 2=behind, 3=diverged, 4=no remote
check_git_sync_status() {
    local ahead behind

    # Fetch remote without pulling
    git fetch origin --quiet 2>/dev/null || {
        log_warn "Cannot fetch from remote (offline or no access)"
        return 4
    }

    # Get ahead/behind counts
    local counts
    counts=$(git rev-list --left-right --count HEAD...origin/$(git branch --show-current) 2>/dev/null || echo "0 0")
    ahead=$(echo "$counts" | awk '{print $1}')
    behind=$(echo "$counts" | awk '{print $2}')

    if [[ $ahead -gt 0 ]] && [[ $behind -gt 0 ]]; then
        echo "diverged:$ahead:$behind"
        return 3
    elif [[ $ahead -gt 0 ]]; then
        echo "ahead:$ahead"
        return 1
    elif [[ $behind -gt 0 ]]; then
        echo "behind:$behind"
        return 2
    else
        echo "in-sync"
        return 0
    fi
}

# Sync repository with remote (pull if needed)
sync_with_remote() {
    local status_info
    status_info=$(check_git_sync_status)
    local status_code=$?

    case $status_code in
        0)  # In sync
            return 0
            ;;
        1)  # Ahead of remote
            local ahead
            ahead=$(echo "$status_info" | cut -d: -f2)
            log_warn "Local repository is $ahead commit(s) ahead of remote"
            echo "  You have unpushed changes. They will be pushed with the next backup."
            return 0
            ;;
        2)  # Behind remote
            local behind
            behind=$(echo "$status_info" | cut -d: -f2)
            log_info "Pulling $behind new commit(s) from remote..."
            if git pull --quiet --ff-only 2>/dev/null; then
                log_success "Updated from remote"
                return 0
            else
                log_error "Failed to pull from remote"
                echo "  Possible causes:"
                echo "  - Merge conflicts"
                echo "  - Non-fast-forward changes"
                echo ""
                echo "  To fix:"
                echo "  - Run: cd $REPO_DIR && git pull"
                echo "  - Resolve any conflicts manually"
                return 1
            fi
            ;;
        3)  # Diverged
            local ahead behind
            ahead=$(echo "$status_info" | cut -d: -f2)
            behind=$(echo "$status_info" | cut -d: -f3)
            log_error "Repository has diverged from remote"
            echo "  Local: $ahead commit(s) ahead"
            echo "  Remote: $behind commit(s) ahead"
            echo ""
            echo "  To fix (choose one):"
            echo "  1. Merge: cd $REPO_DIR && git pull"
            echo "  2. Rebase: cd $REPO_DIR && git pull --rebase"
            echo "  3. Reset to remote: cd $REPO_DIR && git reset --hard origin/\$(git branch --show-current)"
            return 1
            ;;
        4)  # Cannot reach remote
            log_warn "Working offline (cannot reach remote)"
            return 0
            ;;
    esac
}

# Safe git push with error handling
safe_git_push() {
    local push_output
    push_output=$(mktemp)

    echo -n "Pushing to remote... "
    if git push 2>"$push_output"; then
        echo "✓"
        rm -f "$push_output"
        return 0
    fi

    echo "✗"
    echo ""

    # Analyze push error
    local error_content
    error_content=$(cat "$push_output" 2>/dev/null)
    rm -f "$push_output"

    if echo "$error_content" | grep -q "non-fast-forward\|rejected"; then
        log_error "Push rejected (non-fast-forward)"
        echo ""
        echo "  Remote has changes you don't have locally."
        echo ""
        echo "  To fix:"
        echo "  1. Pull first: cd $REPO_DIR && git pull"
        echo "  2. Resolve any conflicts"
        echo "  3. Run backup again"
        return 1
    elif echo "$error_content" | grep -q "Authentication\|Permission denied"; then
        log_error "Authentication failed"
        echo ""
        echo "  Cannot push to remote (permission denied)"
        echo ""
        echo "  To fix:"
        echo "  - Check SSH key: ssh -T git@github.com"
        echo "  - Verify repository access rights"
        return 1
    else
        log_error "Push failed"
        echo ""
        echo "Git error:"
        echo "$error_content" | sed 's/^/  /'
        return 1
    fi
}

# ===== Directory Management =====

# Ensure local directory exists (without git initialization)
# Used by select/add/remove commands that only need local storage
ensure_local_dir() {
    if [[ -d "$REPO_DIR" ]]; then
        return 0
    fi

    log_info "Creating local backup directory..."
    mkdir -p "$REPO_DIR"

    # Initialize metadata if it doesn't exist
    if [[ ! -f "$METADATA_FILE" ]]; then
        init_metadata
    fi

    log_success "Local directory ready: $REPO_DIR"
    echo ""
    log_note "Run 'keys-backup init' before backing up to initialize git repository"
}

# ===== Transcrypt Operations =====

# Initialize transcrypt in repo
# Transcrypt is idempotent - it handles "already configured" automatically
init_transcrypt() {
    local password="$1"

    # Transcrypt stores config in .git/crypt/transcrypt, NOT .transcrypt/cipher
    # Run transcrypt with -y flag (yes to all prompts) for automation
    if [[ -n "$password" ]]; then
        transcrypt -c aes-256-cbc -p "$password" -y
    else
        echo "Enter password for encryption:"
        transcrypt -c aes-256-cbc -y
    fi

    # Append encryption patterns (don't overwrite transcrypt's metadata)
    # Transcrypt adds its own metadata comments to .gitattributes
    if ! grep -q "ssh-keys/\*\* filter=crypt" .gitattributes 2>/dev/null; then
        cat >> .gitattributes <<'EOF'
ssh-keys/** filter=crypt diff=crypt merge=crypt
backup-list.txt filter=crypt diff=crypt merge=crypt
backup-metadata.json filter=crypt diff=crypt merge=crypt
EOF
        git add .gitattributes
        git commit -m "Configure transcrypt for SSH keys" || true
        log_event "Initialized transcrypt encryption"
    fi
}

# Check if transcrypt is configured
is_transcrypt_configured() {
    [[ -f "$REPO_DIR/.git/crypt/transcrypt" ]]
}

# ===== Repository Health =====

# Check repository health
# Returns: 0=healthy, 1=not git repo, 2=transcrypt not configured, 3=offline mode
check_repo_health() {
    [[ ! -d "$REPO_DIR/.git" ]] && {
        log_error "Not a git repository"
        echo "Run 'keys-backup init' or 'keys-restore clone' to initialize"
        return 1
    }

    # Check transcrypt using correct path: .git/crypt/transcrypt
    [[ ! -f "$REPO_DIR/.git/crypt/transcrypt" ]] && {
        log_error "Transcrypt not configured"
        echo "Run 'keys-backup init' to configure encryption"
        return 2
    }

    cd "$REPO_DIR"
    if ! git ls-remote &>/dev/null; then
        log_warn "Remote unreachable (working offline)"
        return 3  # Different exit code for offline mode
    fi

    return 0
}

# Initialize repository if needed
init_repo_if_needed() {
    # If git repo already exists, sync with remote and return
    if [[ -d "$REPO_DIR/.git" ]]; then
        cd "$REPO_DIR"
        sync_with_remote || {
            log_error "Cannot sync with remote - please resolve conflicts first"
            return 1
        }
        return 0
    fi

    # If directory exists but no git (created by ensure_local_dir), run init
    if [[ -d "$REPO_DIR" ]] && [[ ! -d "$REPO_DIR/.git" ]]; then
        log_info "Local directory exists, initializing git repository..."
        echo ""
        # Source cmd_init from keys-backup (it's defined there)
        # We'll just provide instructions instead
        log_warn "Please run 'keys-backup init' first to initialize the git repository"
        return 1
    fi

    # Directory doesn't exist at all - this shouldn't happen normally
    # as both ensure_local_dir and init should create it
    echo -e "${BLUE}Cloning keys repository...${NC}"
    git clone "$KEYS_REPO" "$REPO_DIR" || {
        echo -e "${RED}Error:${NC} Failed to clone repository" >&2
        return 1
    }

    cd "$REPO_DIR"
    log_event "Repository initialized"
}

# ===== Backup Operations =====

# Backup single file
backup_file() {
    local file="$1"
    [[ ! -f "$file" ]] && return 1

    local filename
    filename=$(basename "$file")
    mkdir -p "$REPO_DIR/ssh-keys"

    cp "$file" "$REPO_DIR/ssh-keys/$filename"
    chmod 600 "$REPO_DIR/ssh-keys/$filename"

    # Backup public key if exists
    if [[ -f "$file.pub" ]]; then
        cp "$file.pub" "$REPO_DIR/ssh-keys/$filename.pub"
        chmod 644 "$REPO_DIR/ssh-keys/$filename.pub"
    fi
}

# ===== Verification =====

# Verify file integrity
verify_file() {
    local file="$1"
    [[ ! -f "$file" ]] && return 1

    local filename
    filename=$(basename "$file")
    local backup_file="$REPO_DIR/ssh-keys/$filename"
    [[ ! -f "$backup_file" ]] && return 2

    local local_hash backup_hash
    local_hash=$(calc_checksum "$file")
    backup_hash=$(calc_checksum "$backup_file")

    [[ "$local_hash" == "$backup_hash" ]]
}

# ===== Git Version Helpers =====

# Get commit list with formatting
get_commit_list() {
    cd "$REPO_DIR"
    git log --oneline --format="%C(yellow)%h%C(reset) %C(green)%ad%C(reset) %s" \
        --date=short -- ssh-keys/ backup-metadata.json
}

# FZF commit picker
fzf_pick_commit() {
    local header="${1:-Select version to restore}"

    get_commit_list | fzf --ansi \
        --height=80% \
        --border=rounded \
        --header="$header" \
        --preview='git -C "'"$REPO_DIR"'" show --color=always {1} -- ssh-keys/' \
        --preview-window='right:60%:wrap' \
        --bind='enter:accept' | awk '{print $1}'
}

