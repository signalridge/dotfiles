#!/usr/bin/env bash
# PostgreSQL MCP wrapper
# Resolve PostgreSQL connection string from gopass at runtime, then launch MCP server.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "$SCRIPT_DIR/lib/common"

MCP_POSTGRES_PACKAGE="${MCP_POSTGRES_PACKAGE:-@modelcontextprotocol/server-postgres@0.6.2}"
MCP_POSTGRES_ALLOW_DEPRECATED_REFERENCE="${MCP_POSTGRES_ALLOW_DEPRECATED_REFERENCE:-0}"

if [[ "$MCP_POSTGRES_PACKAGE" == @modelcontextprotocol/server-postgres@* && "$MCP_POSTGRES_ALLOW_DEPRECATED_REFERENCE" != "1" ]]; then
    log_error "PostgreSQL MCP is disabled by default: @modelcontextprotocol/server-postgres@0.6.2 is deprecated and has a known read-only bypass risk."
    log_error "Use a dedicated read-only database role and set MCP_POSTGRES_ALLOW_DEPRECATED_REFERENCE=1 only for a conscious local opt-in."
    exit 1
fi

require_cmd bunx

PG_DSN_GOPASS_PATH="postgres/api_key"

# Allow explicit env override for CI/non-interactive runners.
if [[ -z "${PG_DSN:-}" ]]; then
    if ! PG_DSN="$(gopass_show_secret "$PG_DSN_GOPASS_PATH" 3 2>/dev/null)"; then
        log_error "Failed to read PostgreSQL DSN from gopass: $PG_DSN_GOPASS_PATH"
        exit 1
    fi
fi

if [[ -z "$PG_DSN" ]]; then
    log_error "PostgreSQL DSN is empty: $PG_DSN_GOPASS_PATH"
    exit 1
fi

# Deprecated reference server: read-only Postgres MCP.
# Upstream server-postgres currently requires DSN as argv[1].
# This means DSN may be visible in process listings on the local machine.
log_warn "$MCP_POSTGRES_PACKAGE requires DSN as argv; DSN may be visible in process list"
exec bunx "$MCP_POSTGRES_PACKAGE" "$PG_DSN" "$@"
