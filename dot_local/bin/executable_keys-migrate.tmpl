#!/usr/bin/env bash
# SSH Keys Backup Migration Tool
# Migrates v1 backups to v2 format with metadata support
set -euo pipefail

# shellcheck source=keys-lib
source "$(dirname "$0")/keys-lib"

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}Keys Backup Migration Tool: v1 → v2${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Check repository exists
if [[ ! -d "$REPO_DIR/.git" ]]; then
    echo -e "${RED}Error:${NC} Backup repository not found at $REPO_DIR"
    echo "Run 'keys-backup backup' to create initial backup"
    exit 1
fi

cd "$REPO_DIR"

# Check if already v2
if [[ -f "$METADATA_FILE" ]]; then
    version=$(jq -r '.version // 1' "$METADATA_FILE" 2>/dev/null || echo "1")
    if [[ "$version" == "2" ]]; then
        echo -e "${GREEN}✓${NC} Repository is already v2"
        echo ""
        echo "Metadata info:"
        jq . "$METADATA_FILE"
        echo ""
        echo "No migration needed"
        exit 0
    fi
fi

echo "This tool will:"
echo "  1. Create backup-metadata.json from existing backups"
echo "  2. Calculate checksums for all backed up files"
echo "  3. Initialize backup history log"
echo "  4. Update .gitattributes to encrypt metadata"
echo ""
echo -e "${YELLOW}Warning:${NC} This will modify your backup repository"
echo ""

read -p "Continue with migration? (y/n): " confirm
if [[ "$confirm" != "y" ]]; then
    echo "Migration cancelled"
    exit 0
fi

echo ""
echo "[1/5] Creating backup of current repository state..."
BACKUP_BRANCH="pre-migration-backup-$(date +%Y%m%d-%H%M%S)"
git branch "$BACKUP_BRANCH"
echo -e "${GREEN}✓${NC} Created backup branch: $BACKUP_BRANCH"
echo ""

echo "[2/5] Initializing metadata file..."
init_metadata
echo -e "${GREEN}✓${NC} Created $METADATA_FILE"
echo ""

echo "[3/5] Analyzing backed up files..."
if [[ ! -f "$BACKUP_LIST" ]]; then
    echo -e "${YELLOW}Warning:${NC} No backup-list.txt found"
    echo "Creating from ssh-keys directory..."

    # Generate backup list from existing files
    > "$BACKUP_LIST"
    find ssh-keys -type f -name "*" ! -name "*.pub" 2>/dev/null | while read -r backup_file; do
        filename=$(basename "$backup_file")
        original_path="$HOME/.ssh/$filename"
        echo "$original_path" >> "$BACKUP_LIST"
    done

    if [[ -s "$BACKUP_LIST" ]]; then
        echo -e "${GREEN}✓${NC} Generated backup list with $(wc -l < "$BACKUP_LIST" | tr -d ' ') files"
    else
        echo -e "${RED}Error:${NC} No backup files found in ssh-keys/"
        git branch -D "$BACKUP_BRANCH"
        rm -f "$METADATA_FILE"
        exit 1
    fi
fi

# Calculate metadata for each file
file_count=0
while IFS= read -r original_path; do
    filename=$(basename "$original_path")
    backup_file="ssh-keys/$filename"

    if [[ ! -f "$backup_file" ]]; then
        echo -e "  ${YELLOW}⚠${NC} Skipping $filename (not in backup)"
        continue
    fi

    # Calculate checksum from backup file
    hash=$(calc_checksum "$backup_file")

    # Get file info from backup
    if stat -f%z "$backup_file" &>/dev/null 2>&1; then
        # macOS
        size=$(stat -f%z "$backup_file")
        mtime=$(stat -f%m "$backup_file")
    else
        # Linux
        size=$(stat -c%s "$backup_file")
        mtime=$(stat -c%Y "$backup_file")
    fi

    # Get last commit info for this file
    last_commit_date=$(git log -1 --format="%aI" -- "$backup_file" 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ")
    backup_count=$(git log --oneline -- "$backup_file" 2>/dev/null | wc -l | tr -d ' ')

    # Update metadata
    tmp=$(mktemp)
    jq ".files[\"$original_path\"] = {
        \"sha256\": \"$hash\",
        \"size\": $size,
        \"mtime\": $mtime,
        \"last_backup\": \"$last_commit_date\",
        \"backup_count\": $backup_count
    }" "$METADATA_FILE" > "$tmp"
    mv "$tmp" "$METADATA_FILE"

    echo -e "  ${GREEN}✓${NC} Processed $filename (count: $backup_count)"
    ((file_count++))
done < "$BACKUP_LIST"

echo ""
echo -e "${GREEN}✓${NC} Processed $file_count files"
echo ""

echo "[4/5] Initializing backup history..."
if [[ ! -f "$HISTORY_LOG" ]]; then
    # Generate history from git log
    git log --reverse --format="[%aI] %s" -- ssh-keys/ backup-list.txt > "$HISTORY_LOG" 2>/dev/null || true
    echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Migrated to v2 format" >> "$HISTORY_LOG"
    echo -e "${GREEN}✓${NC} Created backup history with $(wc -l < "$HISTORY_LOG" | tr -d ' ') entries"
else
    echo -e "${GREEN}✓${NC} History log already exists"
fi
echo ""

echo "[5/5] Updating .gitattributes..."
if ! grep -q "backup-metadata.json" .gitattributes 2>/dev/null; then
    echo "backup-metadata.json filter=crypt diff=crypt merge=crypt" >> .gitattributes
    echo -e "${GREEN}✓${NC} Added metadata encryption to .gitattributes"
else
    echo -e "${GREEN}✓${NC} .gitattributes already configured"
fi
echo ""

echo "Committing migration changes..."
git add backup-metadata.json backup-history.log backup-list.txt .gitattributes
if git diff --cached --quiet; then
    echo "No changes to commit"
else
    git commit -m "Migrate to v2 format with metadata

- Add backup-metadata.json with checksums and timestamps
- Initialize backup-history.log from git history
- Update .gitattributes for metadata encryption
- Processed $file_count files

Migration date: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"

    git push
fi

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ Migration Complete${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo "Summary:"
echo "  - Migrated $file_count files to v2 format"
echo "  - Created metadata with checksums and timestamps"
echo "  - Initialized backup history"
echo "  - Backup branch created: $BACKUP_BRANCH"
echo ""
echo "Metadata location: $METADATA_FILE"
echo "History log: $HISTORY_LOG"
echo ""
echo -e "${CYAN}Rollback instructions:${NC}"
echo "  If something goes wrong, you can rollback with:"
echo "  cd $REPO_DIR"
echo "  git reset --hard $BACKUP_BRANCH"
echo "  git push --force"
echo ""
echo "Next steps:"
echo "  - Run 'keys-backup status' to verify migration"
echo "  - Run 'keys-backup verify' to check integrity"
echo "  - New features available:"
echo "    • Incremental backups (only changed files)"
echo "    • Checksum verification"
echo "    • Version history with FZF"
echo ""
