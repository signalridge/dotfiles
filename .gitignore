# Harness skill workspace (generated by harness)
.claude
.codex
.serena/

# Same for .pi, except the repository-scoped safety policies below. The source tree is
# the live `main` checkout, so Article 1/2's ban on worktrees and branch
# switching applies HERE and nowhere else. pi-permission-system reads
# `<cwd>/.pi/extensions/pi-permission-system/config.json` and project overrides
# global, so that file states the shell restriction at its actual scope;
# subagents.json separately disables internal Git isolation. A global ban meant "every
# repository", which is what it used to do. Git cannot re-include a file whose
# parent directory is excluded, hence the dir-by-dir dance.
.pi/*
# Agent isolation invokes Git internally, outside shell-tool permission hooks.
!.pi/subagents.json
!.pi/extensions/
.pi/extensions/*
!.pi/extensions/pi-permission-system/
.pi/extensions/pi-permission-system/*
!.pi/extensions/pi-permission-system/config.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Nix build outputs
result
result-*

# Local settings (not to be committed)
*.local.json
*.local.yaml
*.local.toml

# Backup files
*.bak
*.backup
*~

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# Secrets (should use chezmoi encryption instead)
*.key
*.pem

# Temporary files
*.tmp
*.temp

# Logs
*.log

# Backups directory (generated by backup_dev_env)
backups/

# Node modules (created by prettier cache)
node_modules/
backup/

# Python bytecode and tool caches
.ruff_cache/
__pycache__/
*.pyc

# OSS-launch skill draft workspace (per-platform launch posts staged here)
tmp/launch/
